{"version": 2, "width": 78, "height": 24, "timestamp": 1750000000, "env": {"TERM": "xterm-256color", "SHELL": "/bin/bash"}, "title": "cs-sandbox \u2014 create \u2192 work \u2192 fetch \u2192 destroy"}
[0.0, "o", "\u001b[38;5;77m$ \u001b[0m"]
[1.344, "o", "\u001b[38;5;245m# one sandbox, two repos, and your host Claude login\u001b[0m\r\n"]
[1.344, "o", "\u001b[38;5;77m$ \u001b[0m"]
[3.332, "o", "\u001b[97mcs-sandbox create feature --repo ~/projects/api \\\u001b[0m\r\n"]
[3.332, "o", "\u001b[38;5;77m> \u001b[0m"]
[4.512, "o", "\u001b[97m    --repo ~/projects/web --inherit-agent-login claude\u001b[0m\r\n"]
[4.512, "o", "\u001b[38;5;252mcreated feature \u001b[38;5;240m(type=agent, engine=firecracker, ssh port=2300)\u001b[0m\r\n"]
[4.712, "o", "\u001b[38;5;240m  shell: ssh feature\u001b[0m\r\n"]
[4.912, "o", "\u001b[38;5;252m  agent login: \u001b[38;5;179mclaude \u001b[38;5;240m(inherited from your host)\u001b[0m\r\n"]
[5.112, "o", "\u001b[38;5;252m  repo:     ~/api \u001b[38;5;179mon branch cs-sandbox/feature\u001b[0m\r\n"]
[5.312, "o", "\u001b[38;5;252m  repo:     ~/web \u001b[38;5;179mon branch cs-sandbox/feature\u001b[0m\r\n"]
[6.032, "o", "\u001b[38;5;77m$ \u001b[0m"]
[7.04, "o", "\u001b[97mssh feature\u001b[38;5;245m            # in, by name\u001b[0m\r\n"]
[7.34, "o", "\u001b[38;5;44m[feature]$ \u001b[0m"]
[7.928, "o", "\u001b[97mcd ~/api && cs-claude\u001b[0m\r\n"]
[7.928, "o", "\u001b[38;5;179m  Claude Code \u001b[38;5;240m(logged in \u2014 the host login we inherited above)\u001b[0m\r\n"]
[8.148, "o", "\u001b[38;5;252m  \u203a add a /version endpoint and commit when done\u001b[0m\r\n"]
[8.498, "o", "\r  \u001b[38;5;215m\u2736 Cogitating\u2026\u001b[0m \u001b[38;5;245m(1s \u00b7 \u2191 0.2k tokens \u00b7 esc to interrupt)\u001b[0m\u001b[K"]
[9.198, "o", "\r  \u001b[38;5;215m* Cogitating\u2026\u001b[0m \u001b[38;5;245m(1s \u00b7 \u2191 0.5k tokens \u00b7 esc to interrupt)\u001b[0m\u001b[K"]
[9.898, "o", "\r  \u001b[38;5;215m\u2736 Dillydallying\u2026\u001b[0m \u001b[38;5;245m(2s \u00b7 \u2191 0.8k tokens \u00b7 esc to interrupt)\u001b[0m\u001b[K"]
[10.598, "o", "\r  \u001b[38;5;215m\u2055 Synthesizing\u2026\u001b[0m \u001b[38;5;245m(3s \u00b7 \u2191 1.1k tokens \u00b7 esc to interrupt)\u001b[0m\u001b[K"]
[11.298, "o", "\r  \u001b[38;5;215m\u2736 Noodling\u2026\u001b[0m \u001b[38;5;245m(4s \u00b7 \u2191 1.4k tokens \u00b7 esc to interrupt)\u001b[0m\u001b[K"]
[11.998, "o", "\r  \u001b[38;5;215m* Finagling\u2026\u001b[0m \u001b[38;5;245m(5s \u00b7 \u2191 1.6k tokens \u00b7 esc to interrupt)\u001b[0m\u001b[K"]
[13.198, "o", "\r\u001b[2K\u001b[38;5;240m  edited server.js  \u2022  GET /version \u2192 {\"version\":\"1.4.0\"}\u001b[0m\r\n"]
[13.418, "o", "\u001b[38;5;77m  \u221a committed \u001b[38;5;252m\"add /version endpoint\"  on cs-sandbox/feature\u001b[0m\r\n"]
[14.038, "o", "\u001b[38;5;44m[feature]$ \u001b[0m"]
[14.15, "o", "\u001b[97mexit\u001b[0m\r\n"]
[14.45, "o", "\u001b[38;5;77m$ \u001b[0m"]
[15.654, "o", "\u001b[38;5;245m# pull the agent's commits back to the host\u001b[0m\r\n"]
[15.654, "o", "\u001b[38;5;77m$ \u001b[0m"]
[16.382, "o", "\u001b[97mcs-sandbox fetch feature\u001b[0m\r\n"]
[16.382, "o", "\u001b[38;5;245mcs-sandbox: \u001b[38;5;252mfetch feature:api \u001b[38;5;240m(cs-sandbox/feature)\u001b[0m\r\n"]
[16.602, "o", "\u001b[38;5;252m  ~/projects/api  \u001b[38;5;179m\u2192 1a2b3c4 add /version endpoint\u001b[0m\r\n"]
[17.322, "o", "\u001b[38;5;77m$ \u001b[0m"]
[18.33, "o", "\u001b[38;5;245m# done? throw the whole sandbox away\u001b[0m\r\n"]
[18.33, "o", "\u001b[38;5;77m$ \u001b[0m"]
[19.114, "o", "\u001b[97mcs-sandbox destroy feature -f\u001b[0m\r\n"]
[19.114, "o", "\u001b[38;5;252mdestroyed feature\u001b[0m\r\n"]
