{"version": 2, "width": 78, "height": 20, "timestamp": 1750000000, "env": {"TERM": "xterm-256color", "SHELL": "/bin/bash"}, "title": "cs-sandbox \u2014 create \u2192 work \u2192 fetch \u2192 destroy"}
[0.0, "o", "\u001b[38;5;77m$ \u001b[0m"]
[1.344, "o", "\u001b[38;5;245m# one sandbox, two repos checked in side by side\u001b[0m\r\n"]
[1.344, "o", "\u001b[38;5;77m$ \u001b[0m"]
[3.332, "o", "\u001b[97mcs-sandbox create feature --repo ~/projects/api --repo ~/projects/web\u001b[0m\r\n"]
[3.332, "o", "\u001b[38;5;252mcreated feature \u001b[38;5;240m(type=agent, engine=firecracker, ssh port 2300)\u001b[0m\r\n"]
[3.532, "o", "\u001b[38;5;240m  shell: cs-sandbox exec feature\u001b[0m\r\n"]
[3.732, "o", "\u001b[38;5;252m  ~/api  \u001b[38;5;179m\u2192 branch cs-sandbox/feature\u001b[0m\r\n"]
[3.932, "o", "\u001b[38;5;252m  ~/web  \u001b[38;5;179m\u2192 branch cs-sandbox/feature\u001b[0m\r\n"]
[4.652, "o", "\u001b[38;5;77m$ \u001b[0m"]
[5.66, "o", "\u001b[97mssh feature\u001b[38;5;245m            # in, by name\u001b[0m\r\n"]
[5.96, "o", "\u001b[38;5;44m[feature]$ \u001b[0m"]
[6.548, "o", "\u001b[97mcd ~/api && cs-claude\u001b[0m\r\n"]
[6.548, "o", "\u001b[38;5;179m  Claude Code \u001b[38;5;240m(signed in, inherits your host login)\u001b[0m\r\n"]
[6.768, "o", "\u001b[38;5;252m  \u203a add a /version endpoint and commit when done\u001b[0m\r\n"]
[7.118, "o", "\r  \u001b[38;5;215m\u2736 Cogitating\u2026\u001b[0m \u001b[38;5;245m(1s \u00b7 \u2191 0.2k tokens \u00b7 esc to interrupt)\u001b[0m\u001b[K"]
[7.818, "o", "\r  \u001b[38;5;215m* Cogitating\u2026\u001b[0m \u001b[38;5;245m(1s \u00b7 \u2191 0.5k tokens \u00b7 esc to interrupt)\u001b[0m\u001b[K"]
[8.518, "o", "\r  \u001b[38;5;215m\u2736 Dillydallying\u2026\u001b[0m \u001b[38;5;245m(2s \u00b7 \u2191 0.8k tokens \u00b7 esc to interrupt)\u001b[0m\u001b[K"]
[9.218, "o", "\r  \u001b[38;5;215m\u2055 Synthesizing\u2026\u001b[0m \u001b[38;5;245m(3s \u00b7 \u2191 1.1k tokens \u00b7 esc to interrupt)\u001b[0m\u001b[K"]
[9.918, "o", "\r  \u001b[38;5;215m\u2736 Noodling\u2026\u001b[0m \u001b[38;5;245m(4s \u00b7 \u2191 1.4k tokens \u00b7 esc to interrupt)\u001b[0m\u001b[K"]
[10.618, "o", "\r  \u001b[38;5;215m* Finagling\u2026\u001b[0m \u001b[38;5;245m(5s \u00b7 \u2191 1.6k tokens \u00b7 esc to interrupt)\u001b[0m\u001b[K"]
[11.818, "o", "\r\u001b[2K\u001b[38;5;240m  edited server.js  \u2022  GET /version \u2192 {\"version\":\"1.4.0\"}\u001b[0m\r\n"]
[12.038, "o", "\u001b[38;5;77m  \u2713 committed \u001b[38;5;252m\"add /version endpoint\"  on cs-sandbox/feature\u001b[0m\r\n"]
[12.658, "o", "\u001b[38;5;44m[feature]$ \u001b[0m"]
[12.77, "o", "\u001b[97mexit\u001b[0m\r\n"]
[13.07, "o", "\u001b[38;5;77m$ \u001b[0m"]
[14.274, "o", "\u001b[38;5;245m# pull the agent's commits back to the host\u001b[0m\r\n"]
[14.274, "o", "\u001b[38;5;77m$ \u001b[0m"]
[15.002, "o", "\u001b[97mcs-sandbox fetch feature\u001b[0m\r\n"]
[15.002, "o", "\u001b[38;5;245mcs-sandbox: \u001b[38;5;252mfetch feature:api \u001b[38;5;240m(cs-sandbox/feature)\u001b[0m\r\n"]
[15.222, "o", "\u001b[38;5;252m  ~/projects/api  \u001b[38;5;179m\u2192 1a2b3c4 add /version endpoint\u001b[0m\r\n"]
[15.942, "o", "\u001b[38;5;77m$ \u001b[0m"]
[16.95, "o", "\u001b[38;5;245m# done? throw the whole sandbox away\u001b[0m\r\n"]
[16.95, "o", "\u001b[38;5;77m$ \u001b[0m"]
[17.734, "o", "\u001b[97mcs-sandbox destroy feature -f\u001b[0m\r\n"]
[17.734, "o", "\u001b[38;5;252mdestroyed feature\u001b[0m\r\n"]
