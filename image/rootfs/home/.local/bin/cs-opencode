#!/usr/bin/env bash
# Launch opencode under the cs-opencode profile — the OpenCode counterpart of cs-claude/cs-codex.
# A dedicated profile keeps the sandbox's opencode config, sessions, and auth isolated from any
# personal ~/.config/opencode or ~/.local/share/opencode, using opencode's first-class overrides
# (NOT blunt XDG redirection, which children of opencode's shell tool would inherit):
#   OPENCODE_CONFIG_DIR  -> ~/.cs-opencode          (opencode.json with the pinned model, AGENTS.md,
#                                                    service.json)
#   OPENCODE_DB          -> ~/.cs-opencode/opencode.db   (session store, isolated per profile)
#
# opencode attaches every client to one per-user background service by default. That service
# keeps the environment of whichever client started it, so the base URL and keys set here would
# never reach it, and it would be shared with any personal opencode on the same account. The
# profile's service.json turns it off: every client of this profile starts a private server on
# its own environment, or connects to the one it names with --server, which is how
# cs-opencode-turn drives the server it starts itself.
#
# YOLO mode is enabled when CS_OPENCODE_YOLO is set or the marker ~/.cs-opencode/.yolo exists;
# cs-sandbox creates that marker for `--yolo` agent instances. YOLO appends --auto (auto-approve
# permissions not explicitly denied) to TUI and `run` invocations — the profile's opencode.json
# already blanket-allows tool permissions, so --auto is belt-and-braces for the residual asks.
OC_DIR="$HOME/.cs-opencode"
mkdir -p "$OC_DIR" 2>/dev/null || true   # ensure the profile dir exists (first run / fresh host)

# Provider auth (API key), scoped to opencode rather than the whole sandbox: anything in
# ~/.cs-opencode/env (FIREWORKS_API_KEY, OPENAI_API_KEY, ...) is sourced here. Nothing creates
# this file for you — write it inside the sandbox, or use `cs-sandbox create --env` to inject
# vars sandbox-wide instead.
[ -f "$OC_DIR/env" ] && { set -a; . "$OC_DIR/env"; set +a; }

export OPENCODE_CONFIG_DIR="$OC_DIR"
export OPENCODE_DB="$OC_DIR/opencode.db"
# The binary can't write read-only /opt anyway; silence the upgrade nag and any shadow-install
# attempt.
export OPENCODE_DISABLE_AUTOUPDATE=1

# The background service stays off for this profile. Written once and only when absent, so a
# profile whose owner turned the service back on (`cs-opencode service set disabled false`)
# keeps that choice. Several servers of the profile then share its database, which is safe:
# only the managed service resumes a turn another process left unfinished, so none of them
# takes over a turn in flight.
if [ ! -e "$OC_DIR/service.json" ]; then
  ( umask 077; printf '{"disabled": true}\n' > "$OC_DIR/service.json" ) 2>/dev/null \
    || echo "cs-opencode: could not write $OC_DIR/service.json; clients will use opencode's shared background service" >&2
fi

# Sign-ins carried from the host by `cs-sandbox create --inherit-agent-login opencode`, as the
# host's `cs-opencode auth export` printed them. opencode keeps sign-ins in its database, so they
# are imported into this profile's on the first start that finds them. The file is then emptied
# rather than removed: the database holds them from then on, and a file still there is one the
# guest does not install again at its next boot. A failed import leaves them for the next start,
# and the lock keeps two first starts from importing them twice.
_signins="$OC_DIR/credentials.json"
if [ -s "$_signins" ] && [ "$(cat "$_signins")" != "[]" ] && mkdir "$OC_DIR/.importing" 2>/dev/null; then
  if opencode auth import "$_signins" >/dev/null 2>&1; then
    ( umask 077; printf '[]\n' > "$_signins" )
  else
    echo "cs-opencode: could not import the sign-ins in $_signins; they stay there for the next start" >&2
  fi
  rmdir "$OC_DIR/.importing" 2>/dev/null
fi
unset _signins

# One inline config, merged over this profile's opencode.json, for what the profile's files
# cannot say:
#   * the base URLs. opencode's base URL belongs to the PROVIDER, and opencode reads no variable
#     for one, so the route that works for every provider is a baseURL in the config.
#     OPENAI_BASE_URL and ANTHROPIC_BASE_URL point the openai and anthropic providers, as each
#     provider's own variable did in OpenCode 1. OPENCODE_BASE_URL points the provider the
#     pinned model names, because that is the provider this session will actually use, and it
#     wins for that provider. Deliberately not OPENAI_BASE_URL for that: it already means the
#     openai provider, and quietly repointing a fireworks model with it would surprise anyone
#     who set it for the reason it exists;
#   * the API keys in a seeded ~/.cs-opencode/auth.json. opencode keeps its own credentials in
#     its database and reads no auth file, so these keys travel inline instead of being written
#     into it. A key opencode already holds, or one in the provider's own variable, comes first;
#   * the caller's own OPENCODE_CONFIG_CONTENT, merged last so what it says wins.
# The content MERGES over the profile's opencode.json rather than replacing it, so the pinned
# model, the permissions and disabled_providers all survive. Nothing is written to disk, so an
# unset variable changes nothing and switching endpoints leaves no state behind.
if [ -n "${OPENCODE_BASE_URL:-}${OPENAI_BASE_URL:-}${ANTHROPIC_BASE_URL:-}" ] || [ -f "$OC_DIR/auth.json" ]; then
  if command -v jq >/dev/null 2>&1; then
    _cfg='{}'
    [ -n "${OPENAI_BASE_URL:-}" ] && _cfg="$(jq -nc --argjson c "$_cfg" --arg u "$OPENAI_BASE_URL" '$c * {provider: {openai: {options: {baseURL: $u}}}}')"
    [ -n "${ANTHROPIC_BASE_URL:-}" ] && _cfg="$(jq -nc --argjson c "$_cfg" --arg u "$ANTHROPIC_BASE_URL" '$c * {provider: {anthropic: {options: {baseURL: $u}}}}')"
    if [ -n "${OPENCODE_BASE_URL:-}" ]; then
      _prov="$(jq -r '(.model // "") | split("/")[0]' "$OC_DIR/opencode.json" 2>/dev/null || true)"
      if [ -n "${_prov:-}" ] && [ "$_prov" != "null" ]; then
        _cfg="$(jq -nc --argjson c "$_cfg" --arg p "$_prov" --arg u "$OPENCODE_BASE_URL" '$c * {provider: {($p): {options: {baseURL: $u}}}}')"
      else
        echo "cs-opencode: OPENCODE_BASE_URL is set but $OC_DIR/opencode.json names no model, so no provider to point" >&2
      fi
    fi
    if [ -f "$OC_DIR/auth.json" ]; then
      _keys="$(jq -c 'with_entries(select(.value.type == "api" and (.value.key // "") != ""))
        | with_entries(.value = {options: {apiKey: .value.key}}) | {provider: .}' "$OC_DIR/auth.json" 2>/dev/null || true)"
      [ -n "$_keys" ] && _cfg="$(jq -nc --argjson c "$_cfg" --argjson k "$_keys" '$c * $k')"
      if jq -e 'any(.[]; .type != "api")' "$OC_DIR/auth.json" >/dev/null 2>&1; then
        echo "cs-opencode: $OC_DIR/auth.json holds a login opencode cannot take inline; sign in with 'cs-opencode auth login'" >&2
      fi
    fi
    if [ "$_cfg" != '{}' ]; then
      if [ -n "${OPENCODE_CONFIG_CONTENT:-}" ]; then
        _cfg="$(jq -nc --argjson c "$_cfg" --argjson u "$OPENCODE_CONFIG_CONTENT" '$c * $u' 2>/dev/null)" \
          || { echo "cs-opencode: OPENCODE_CONFIG_CONTENT is not JSON; it was left as it is" >&2; _cfg="$OPENCODE_CONFIG_CONTENT"; }
      fi
      OPENCODE_CONFIG_CONTENT="$_cfg"
      export OPENCODE_CONFIG_CONTENT
    fi
    unset _prov _cfg _keys
  else
    echo "cs-opencode: jq is missing, so the provider base URLs and the profile's API keys were not applied" >&2
  fi
fi

# The context hook is an OpenCode plugin. A member with no hand-off line and no token budget meter
# has no use for it, so it is kept out of the profile's plugins directory and linked in here only
# when CS_HANDOFF_TOKENS names a line or CS_METER_URL names the lender's meter, as a lent sandbox
# does. A member with neither starts exactly as it would without the feature. The link stays once
# made: the plugin registers nothing without either, and a start with neither after one with them
# costs nothing new. A missing source is reported, not fatal: the agent still runs, without the
# hook.
if { [ -n "${CS_HANDOFF_TOKENS:-}" ] && [ "${CS_HANDOFF_TOKENS}" != 0 ]; } || [ -n "${CS_METER_URL:-}" ]; then
  _hook="$HOME/.local/share/cs-opencode/plugins/cs-context-hook.ts"
  if [ -f "$_hook" ]; then
    mkdir -p "$OC_DIR/plugins" 2>/dev/null && ln -sfn "$_hook" "$OC_DIR/plugins/cs-context-hook.ts" 2>/dev/null \
      || echo "cs-opencode: could not link the context hook into $OC_DIR/plugins; neither the hand-off line nor the budget will be asked" >&2
  else
    echo "cs-opencode: no context hook at $_hook; neither the hand-off line nor the budget will be asked" >&2
  fi
  unset _hook
fi

if [ -n "${CS_OPENCODE_YOLO:-}" ] || [ -f "$OC_DIR/.yolo" ]; then
  # --auto exists on the TUI (default command) and `run` only; injecting it into other
  # subcommands (serve, session, auth, mini, ...) would be an unknown-flag error.
  case "${1:-}" in
    run) shift; exec opencode run --auto "$@" ;;
    upgrade|update|uninstall|acp|api|debug|auth|mcp|plugin|models|stats|mini|session|service|reload|pair|serve) ;;
    *) exec opencode --auto "$@" ;;
  esac
fi
exec opencode "$@"
