#!/usr/bin/env bash
# Launch opencode under the cs-opencode profile — the OpenCode counterpart of cs-claude/cs-codex.
# A dedicated profile keeps the sandbox's opencode config, sessions, and auth isolated from any
# personal ~/.config/opencode or ~/.local/share/opencode, using opencode's first-class overrides
# (NOT blunt XDG redirection, which children of opencode's bash tool would inherit):
#   OPENCODE_CONFIG_DIR  -> ~/.cs-opencode          (opencode.json with the pinned model, AGENTS.md)
#   OPENCODE_DB          -> ~/.cs-opencode/opencode.db   (session store, isolated per profile)
#   OPENCODE_AUTH_CONTENT <- ~/.cs-opencode/auth.json    (inline; the credential is NEVER written
#                            into opencode's data dir, where it would sit beside the session db)
#
# YOLO mode is enabled when CS_OPENCODE_YOLO is set or the marker ~/.cs-opencode/.yolo exists;
# cs-sandbox creates that marker for `--yolo` agent instances. YOLO appends --auto (auto-approve
# permissions not explicitly denied) to TUI and `run` invocations — the profile's opencode.json
# already blanket-allows tool permissions, so --auto is belt-and-braces for the residual asks.
OC_DIR="$HOME/.cs-opencode"
mkdir -p "$OC_DIR" 2>/dev/null || true   # ensure the profile dir exists (first run / fresh host)

# Provider auth (API key), scoped to opencode rather than the whole sandbox: anything in
# ~/.cs-opencode/env (FIREWORKS_API_KEY, OPENAI_API_KEY, ...) is sourced here. Nothing creates
# this file for you — write it inside the sandbox, or use `cs-sandbox create --env` to inject
# vars sandbox-wide instead.
[ -f "$OC_DIR/env" ] && { set -a; . "$OC_DIR/env"; set +a; }

export OPENCODE_CONFIG_DIR="$OC_DIR"
export OPENCODE_DB="$OC_DIR/opencode.db"
# The binary can't write read-only /opt anyway; silence the upgrade nag and any shadow-install
# attempt, and keep sessions private.
export OPENCODE_DISABLE_AUTOUPDATE=1
export OPENCODE_DISABLE_SHARE=1

# Fold a seeded credential file into the inline-auth env var (short-circuits auth.json reads).
if [ -f "$OC_DIR/auth.json" ] && [ -z "${OPENCODE_AUTH_CONTENT:-}" ]; then
  OPENCODE_AUTH_CONTENT="$(cat "$OC_DIR/auth.json")"
  export OPENCODE_AUTH_CONTENT
fi

# Point opencode's active provider at another endpoint — a gateway, a proxy, a
# traffic recorder.
#
# opencode's base URL belongs to the PROVIDER, not the client: it reads
# OPENAI_BASE_URL and ANTHROPIC_BASE_URL and nothing else, so a model on any
# other provider (fireworks, say) cannot be redirected by environment alone. The
# route that works for every provider is a baseURL in the config, and
# OPENCODE_CONFIG_CONTENT supplies one inline. It MERGES over this profile's
# opencode.json rather than replacing it, so the pinned model, the permissions
# and disabled_providers all survive — checked, not assumed.
#
# The provider is taken from the pinned model's own slug, because that is the
# provider this session will actually use. Nothing is written to disk, so an
# unset variable changes nothing and switching endpoints leaves no state behind.
#
# Deliberately not OPENAI_BASE_URL: opencode already gives that one a narrower
# meaning, its openai provider, and quietly repointing a fireworks model with it
# would surprise anyone who set it for the reason it exists. A caller who has
# already composed OPENCODE_CONFIG_CONTENT keeps theirs.
if [ -n "${OPENCODE_BASE_URL:-}" ] && [ -z "${OPENCODE_CONFIG_CONTENT:-}" ]; then
  if command -v jq >/dev/null 2>&1; then
    _prov="$(jq -r '(.model // "") | split("/")[0]' "$OC_DIR/opencode.json" 2>/dev/null || true)"
    if [ -n "${_prov:-}" ] && [ "$_prov" != "null" ]; then
      OPENCODE_CONFIG_CONTENT="$(jq -nc --arg p "$_prov" --arg u "$OPENCODE_BASE_URL" \
        '{provider: {($p): {options: {baseURL: $u}}}}')"
      export OPENCODE_CONFIG_CONTENT
    else
      echo "cs-opencode: OPENCODE_BASE_URL is set but $OC_DIR/opencode.json names no model, so no provider to point" >&2
    fi
    unset _prov
  else
    echo "cs-opencode: OPENCODE_BASE_URL is set but jq is missing, so the provider base URL was not applied" >&2
  fi
fi

if [ -n "${CS_OPENCODE_YOLO:-}" ] || [ -f "$OC_DIR/.yolo" ]; then
  # --auto exists on the TUI (default command) and `run` only; injecting it into other
  # subcommands (serve, export, session, db, ...) would be an unknown-flag error.
  case "${1:-}" in
    run) shift; exec opencode run --auto "$@" ;;
    completion|acp|mcp|attach|debug|providers|auth|agent|upgrade|uninstall|serve|web|models|stats|export|import|github|pr|session|plugin|plug|db) ;;
    *) exec opencode --auto "$@" ;;
  esac
fi
exec opencode "$@"
