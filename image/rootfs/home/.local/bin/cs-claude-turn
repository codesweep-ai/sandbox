#!/bin/bash
# Remote-side driver for the tmux-based remote delegation model.
# Runs ON the remote machine (your-remote-host). Drives one conversational turn
# against an interactive Claude Code that lives in a long-running tmux session,
# and returns that turn's output by reading the session JSONL (NOT by scraping
# the tmux pane, which is full of TUI/ANSI artifacts).
#
# One turn =
#   1. ensure the tmux session is alive (create with --session-id on first run,
#      recreate with --resume if it died), handling the first-run trust prompt;
#   2. paste the prompt (read from stdin) via tmux load-buffer + bracketed paste,
#      then submit with Enter;
#   3. wait for the turn to finish by watching the JSONL for a new
#      {"type":"system","subtype":"turn_duration"} marker (the deterministic
#      end-of-turn edge that interactive mode writes);
#   4. print the new assistant content appended since the prompt was sent.
#
# The tmux session is named by UUID (cs-claude-<uuid>) so it is always a safe,
# unique token regardless of the human-facing session name.
#
# Usage (all flags except --uuid optional):
#   echo "prompt" | cs-claude-turn --uuid <uuid> [--workdir <dir>] \
#       [--format text|json] [--timeout <secs>] [--wrapper <cmd>] \
#       [--projects <dir>] [--name <label>]
#
#        cs-claude-turn --state [--uuid <uuid>]
#        cs-claude-turn --context [--uuid <uuid>]
#
# --state says whether Claude Code is in a turn right now, whoever started the turn, and
# starts or wakes nothing. It prints one line and exits 0: busy, idle, blocked (a screen that
# needs a person), unknown (a screen this driver does not recognise) or absent (no session).
# busy may be followed by a second word, "busy retrying", while Claude waits out a provider
# error. With no --uuid it answers for every Claude session here: busy if any is, idle only
# if all are. It is the judgement the driver itself waits on, so the two cannot disagree.
#
# --context reads the session record and says how full the conversation is. It prints one line and
# exits 0: "tokens=<n> window=<n|-> compactions=<n> compacted=<epoch|-> model=<id|->", or "absent"
# when there is no record, or "unknown" when the record cannot be read. tokens is the context the
# latest model call carried. Claude Code does not record its window, so window is "-". With no
# --uuid it answers for the newest record. Like --state it starts nothing and writes nothing.
#
# Exit codes: 0 ok, 2 turn timed out, 3 launch/setup failure, 5 turn failed (the provider ended
# it with an error), 1 usage/other. 5 matches cs-codex-turn and cs-opencode-turn, and stays clear
# of cs-claude-remote's 4 (session busy).
#
# A failed turn prints the provider's message on stderr, then one line a caller can parse:
#   cs-claude-turn: failure class=<throttled|capacity|unauthorized|context|unreachable|other> retry_after=<secs|->

set -uo pipefail

UUID=""
WORKDIR=""
FORMAT="text"
# Max seconds to wait for a turn to complete. 0 = wait indefinitely (the stall
# watchdog below remains the hang detector). Env-overridable, like the siblings.
TIMEOUT="${CS_CLAUDE_TIMEOUT:-600}"
# Stall watchdog: bail early if the JSONL stops growing AND the TUI is no longer
# working before a turn_duration marker appears. 0 disables. Env-overridable.
STALL_SECS="${CS_CLAUDE_STALL_SECS:-180}"
WRAPPER="cs-claude"
PROJECTS="$HOME/.cs-claude/projects"
LABEL=""             # human label, used only in diagnostics
STATE_ONLY=false
CONTEXT_ONLY=false

# The turn log. Every turn end appends one line here, on the machine the agent runs on, so a
# harness that asks this machine about this agent can learn how its last turn ended:
#   <epoch> <exit code> <class|-> <retry_after|-> <first line of the reason, or ->
# The class line below goes to whoever started the turn, and that may be another machine, or
# gone. One format serves every agent family. --state and a usage error are not turns and
# write nothing. A driver that is killed writes nothing either, so no line means not known.
# Writing is best effort: a full disk must not change how a turn is reported.
TURN_LOG="${CS_TURN_LOG:-$HOME/.cs-turns/claude.log}"
TURN_LOG_KEEP=200
TURN_CLASS="-"; TURN_RETRY="-"; TURN_MSG=""
err() {
    echo "cs-claude-turn: $*" >&2
    case "$*" in
        "failure class="*)
            TURN_CLASS="${*#failure class=}"; TURN_CLASS="${TURN_CLASS%% *}"
            TURN_RETRY="${*##*retry_after=}" ;;
        "turn failed"*) TURN_MSG="$*" ;;
        " "*) ;;
        *) [[ "$TURN_MSG" == "turn failed"* ]] || TURN_MSG="$*" ;;
    esac
}
record_turn_end() {
    local rc="$1" msg
    $STATE_ONLY && return 0
    (( rc == 1 )) && return 0
    msg="$(printf '%s' "${TURN_MSG:--}" | tr '\n\r\t' '   ' | cut -c1-300)"
    {
        mkdir -p "${TURN_LOG%/*}" &&
        printf '%s %s %s %s %s\n' "$(date +%s)" "$rc" "$TURN_CLASS" "$TURN_RETRY" "$msg" >> "$TURN_LOG" &&
        if (( $(wc -l < "$TURN_LOG") > TURN_LOG_KEEP * 2 )); then
            tail -n "$TURN_LOG_KEEP" "$TURN_LOG" > "$TURN_LOG.tmp" && mv "$TURN_LOG.tmp" "$TURN_LOG"
        fi
    } 2>/dev/null || true
    return 0
}
trap 'record_turn_end "$?"' EXIT

# The context hook (cs-context-hook) records in ~/.cs-turns when it asked the agent to hand
# off, and reads there which tmux session this driver drives. Both are read and written here
# and nowhere else in this driver.
HANDOFF_DIR="$HOME/.cs-turns"
TURN_START=0
# handoff_end prints the tokens at the ask when THIS turn ended because the agent handed off:
# the hook asked in the session this driver drives, during this turn, and the handoff file is
# newer than the ask. Anything else fails, and the turn is reported as whatever it was.
handoff_end() {
    [[ -n "${CS_HANDOFF_TOKENS:-}" && "${CS_HANDOFF_TOKENS}" != 0 && -f "$HANDOFF_DIR/handoff-ask" ]] || return 1
    python3 - "$HANDOFF_DIR/handoff-ask" "$TMUX_SESSION" "$TURN_START" "${CS_HANDOFF_FILE:-$HANDOFF_DIR/handoff.md}" <<'PY'
import json, os, sys
try:
    ask = json.load(open(sys.argv[1]))
    at = float(ask.get("at") or 0)
    if ask.get("session") == sys.argv[2] and at >= float(sys.argv[3]) \
            and os.path.getmtime(os.path.expanduser(sys.argv[4])) >= at:
        print(ask.get("tokens", "-")); sys.exit(0)
except Exception:
    pass
sys.exit(1)
PY
}
# handoff_fields is what --context adds to a reading when a line is set: the line, and
# floor=<tokens> when the hook found this session over the line on its first reading and so
# never asked (the line is below what a fresh session costs). Nothing when no line is set.
handoff_fields() {
    local h="${CS_HANDOFF_TOKENS:-}" floor="-"
    [[ -n "$h" && "$h" != 0 ]] || return 0
    if [[ -f "$HANDOFF_DIR/handoff-floor" ]]; then
        floor="$(python3 - "$HANDOFF_DIR/handoff-floor" "$UUID" <<'PY' 2>/dev/null
import json, sys
f = json.load(open(sys.argv[1]))
print(f.get("tokens", "-") if not sys.argv[2] or f.get("session") == sys.argv[2] else "-")
PY
)" || floor="-"
        [[ -n "$floor" ]] || floor="-"
    fi
    printf ' handoff=%s floor=%s' "$h" "$floor"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --uuid)     UUID="$2"; shift 2 ;;
        --workdir)  WORKDIR="$2"; shift 2 ;;
        --format)   FORMAT="$2"; shift 2 ;;
        --timeout)  TIMEOUT="$2"; shift 2 ;;
        --wrapper)  WRAPPER="$2"; shift 2 ;;
        --projects) PROJECTS="$2"; shift 2 ;;
        --name)     LABEL="$2"; shift 2 ;;
        --state)    STATE_ONLY=true; shift ;;
        # --context is a question, not a turn, so it takes the same no-turn path as --state.
        --context)  STATE_ONLY=true; CONTEXT_ONLY=true; shift ;;
        -h|--help)
            trap - EXIT
            sed -n '2,47p' "$0"; exit 0 ;;
        *) err "unknown argument: $1"; exit 1 ;;
    esac
done

if [[ -z "$UUID" ]] && ! $STATE_ONLY; then
    err "--uuid is required"; exit 1
fi
if [[ -n "$UUID" ]] && ! [[ "$UUID" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
    err "--uuid '$UUID' is not a valid UUID"; exit 1
fi
# TIMEOUT reaches here from --timeout or the env default, and 0 legitimately means
# "wait indefinitely". Bash arithmetic reads a non-numeric value as 0, so without
# this check a typo would not fail — it would silently remove the budget and wait
# forever, which is the failure this driver's watchdogs exist to make impossible.
[[ "$TIMEOUT" =~ ^[0-9]+$ ]] || { err "--timeout '$TIMEOUT' must be a non-negative integer (0 = no limit)"; exit 1; }

TMUX_SESSION="cs-claude-$UUID"

# Read the prompt from stdin into a temp file (avoids all shell-escaping issues
# when handing it to tmux load-buffer).
if ! $STATE_ONLY; then
    PROMPT_FILE="$(mktemp "${TMPDIR:-/tmp}/cs-claude-turn.XXXXXX")"
    trap 'rc=$?; rm -f "$PROMPT_FILE"; record_turn_end "$rc"' EXIT
    cat > "$PROMPT_FILE"
    if [[ ! -s "$PROMPT_FILE" ]]; then
        err "empty prompt on stdin"; exit 1
    fi
fi

# --- helpers --------------------------------------------------------------

# JSONL_WAIT is how long to wait, in seconds, for the transcript of a submitted
# prompt to appear — once before re-sending Enter and once after.
JSONL_WAIT="${CS_CLAUDE_JSONL_WAIT_SECS:-30}"

await_jsonl() {
    local deadline=$(( SECONDS + $1 )) found
    while (( SECONDS < deadline )); do
        found="$(jsonl_path)"
        [[ -n "$found" ]] && { printf '%s' "$found"; return 0; }
        sleep 0.5
    done
    return 1
}

jsonl_path() {
    # Locate the JSONL for this UUID (may not exist yet on a brand-new session).
    # Anchor the name to the FULL UUID ("<uuid>.jsonl") instead of a
    # "*<uuid>.jsonl" glob, so an unrelated file whose name merely ends in this
    # UUID can never be picked up. If two project dirs somehow hold the same
    # UUID, warn and take the most recent deterministically.
    local matches n
    matches="$(find "$PROJECTS" -type f -name "${UUID}.jsonl" 2>/dev/null)"
    [[ -z "$matches" ]] && return 0
    n="$(printf '%s\n' "$matches" | grep -c .)"
    if (( n > 1 )); then
        err "multiple JSONL files match ${UUID}.jsonl; using the most recent:"
        printf '%s\n' "$matches" | sed 's/^/  /' >&2
        printf '%s\n' "$matches" | xargs -r ls -t 2>/dev/null | head -1
        return 0
    fi
    printf '%s\n' "$matches"
}

# Count completed turns = number of turn_duration system markers in the JSONL.
turn_count() {
    local f="$1"
    [[ -f "$f" ]] || { echo 0; return; }
    python3 - "$f" <<'PY'
import json, sys
n = 0
try:
    with open(sys.argv[1], encoding="utf-8", errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                o = json.loads(line)
            except Exception:
                continue
            if o.get("type") == "system" and o.get("subtype") == "turn_duration":
                n += 1
except FileNotFoundError:
    pass
print(n)
PY
}

line_count() {
    local f="$1"
    [[ -f "$f" ]] && wc -l < "$f" | tr -d ' ' || echo 0
}

pane() { tmux capture-pane -p -t "$TMUX_SESSION" 2>/dev/null; }

# The provider rejected the credential, and Claude Code is retrying it anyway: ten times, for
# about three minutes, as it would a rate limit. The pane says so while it waits:
#   ✻ 401 invalid x-api-key · Retrying in 17s · attempt 3/10
# Only the bottom of the pane counts, so an earlier turn's refusal in the scrollback does not
# end this one. Prints the reason, or nothing.
auth_rejected() {
    pane | sed -e 's/[[:space:]]*$//' -e '/^$/d' | tail -n 8 \
        | grep -E "(^|[^0-9])40[13] .* · Retrying in [0-9]+ ?s" | head -1 \
        | sed -e 's/ · Retrying in.*//' -e 's/^[^0-9]*//' | cut -c1-160
}

session_alive() { tmux has-session -t "$TMUX_SESSION" 2>/dev/null; }

# The bottom of the screen, where a dialog draws its choices. What the model wrote higher up
# is left out, so a numbered list in an answer is not read as a question. This and the
# helpers below read the screen they are given, or capture one: every judgement of one
# state has to be about one capture, since a dialog can open between two (SBX-103).
pane_bottom() { printf '%s\n' "${1-$(pane)}" | sed -e 's/[[:space:]]*$//' -e '/^$/d' | tail -n 15; }

# Dialogs Claude Code shows once, whose refusal is safe, and the key that refuses each one.
# The driver answers them itself and carries on. One entry per line: <text it shows>|<key>.
KNOWN_DIALOGS=(
    "Try the new fullscreen renderer?|Escape"
)
# A TUI ignores keys that arrive before it takes input, and on a busy host that can be
# seconds after a dialog is drawn. So a known dialog is answered again for this long before
# it is taken for one this driver does not know (SBX-090).
DIALOG_SECS="${CS_CLAUDE_DIALOG_SECS:-15}"

# Prints the entry for the known dialog on screen, or nothing.
known_dialog() {
    local bottom d; bottom="$(pane_bottom "$@")"
    for d in "${KNOWN_DIALOGS[@]}"; do
        [[ "$bottom" == *"${d%|*}"* ]] && { printf '%s\n' "$d"; return 0; }
    done
    return 1
}

# The screen's own words, on one line, for a message that has to say what a person is asked.
screen_text() { pane_bottom "$@" | tr -s ' \t' ' ' | sed 's/^ //' | paste -sd'|' - | sed 's/|/ | /g' | cut -c1-240; }

# Classify the current TUI screen from the pane. Mirrors the state taxonomy in
# dev_tools/agent-dev-template/lib/claude_state.sh so we react correctly to
# screens that block input (sign-in, onboarding, tool-approval) instead of
# blindly waiting them out. Order matters: more specific overlays are matched
# before the generic "Do you want to" approval prompt.
detect_state() {
    local p; p="${1-$(pane)}"
    [[ -z "$p" ]] && { echo "unknown"; return; }
    case "$p" in
        *"Paste code here"*|*"platform.claude.com/oauth"*|*"Login expired"*|*"Please run /login"*) echo "oauth"; return ;;
        *"Choose the text style"*|*"Select login method"*)           echo "onboarding"; return ;;
        *"trust this folder"*|*"Do you trust the files in this folder"*) echo "trust_folder"; return ;;
        *"Enter to select"*"Esc to cancel"*)                         echo "picker"; return ;;
        *"esc to interrupt"*)                                        echo "working"; return ;;
        *"Do you want to"*)                                          echo "tool_approval"; return ;;
    esac
    known_dialog "$p" >/dev/null && { echo "dialog"; return; }
    # Waiting out a provider error is working. Claude Code retries a 429 or an overloaded API
    # ten times by itself, for minutes, and while it waits the pane reads
    # "… · Retrying in 14s · attempt 3/10": no "esc to interrupt", and nothing is appended to
    # the JSONL. Read as ready, that let the stall watchdog end a turn that was still running,
    # and report a throttled member as a stalled one.
    if grep -Eq "Retrying in [0-9]+ ?s.*attempt [0-9]+/[0-9]+" <<<"$p"; then
        echo "working"; return
    fi
    # Sub-agents working in the foreground are working too. The pane reads "Running 2 agents…"
    # over a spinner such as "* Transmuting… (43s · ↓ 316 tokens)", with no "esc to interrupt",
    # and the main session's JSONL stays still until the batch returns. Read as ready, that let
    # the stall watchdog end a healthy swarm of sub-agents after 180s.
    if grep -Eq "Running [0-9]+ agents?…|^[^[:alnum:][:space:]] [A-Z][a-z]+… \([0-9]+[smh]" <<<"$p"; then
        echo "working"; return
    fi
    # No blocking overlay and not actively working: ready once the status line is up.
    if grep -Eqi "auto mode on|bypass permissions on" <<<"$p"; then
        echo "ready"; return
    fi
    # A screen this driver has never seen that asks for a choice or a confirmation. It waits
    # for a person, and waiting on it only turns that into a timeout that says nothing.
    if pane_bottom "$p" | grep -Eq "Enter to confirm|Esc to cancel|^[[:space:]]*❯[[:space:]]*[0-9]+\."; then
        echo "prompt"; return
    fi
    echo "unknown"
}

# The state of one session in a caller's words. It is detect_state and nothing else, so a
# screen the driver learns to read is one this answers for too.
state_word() {
    case "$(detect_state)" in
        working)
            if pane | grep -Eq "Retrying in [0-9]+ ?s.*attempt [0-9]+/[0-9]+"; then echo "busy retrying"; else echo busy; fi ;;
        oauth|onboarding|trust_folder|picker|tool_approval|prompt) echo blocked ;;
        # A known one-time dialog is answered by the driver at the start of the next turn.
        ready|dialog) echo idle ;;
        *)     echo unknown ;;
    esac
}

# Several sessions of one family can be up in one sandbox. The answer is the one a caller
# must respect most: a turn anywhere is busy, and idle only when every session is.
state_rank() { case "${1%% *}" in busy) echo 4 ;; blocked) echo 3 ;; unknown) echo 2 ;; idle) echo 1 ;; *) echo 0 ;; esac; }

if $CONTEXT_ONLY; then
    if [[ -n "$UUID" ]]; then
        rec="$(ls -t "$PROJECTS"/*/"$UUID".jsonl 2>/dev/null | head -n 1)"
    else
        rec="$(ls -t "$PROJECTS"/*/*.jsonl 2>/dev/null | head -n 1)"
    fi
    [[ -n "$rec" ]] || { echo absent; exit 0; }
    # A compaction writes a compact_boundary record and resets the conversation, so the reading
    # is the newest main-thread model call after the newest boundary. Until the first call after
    # a boundary, the boundary's own postTokens is the best reading there is.
    line="$(python3 - "$rec" <<'PY' 2>/dev/null
import json, sys
from datetime import datetime
tokens, comps, last, model = None, 0, None, None
for line in open(sys.argv[1], errors="replace"):
    if '"compact_boundary"' not in line and '"usage"' not in line:
        continue
    try:
        r = json.loads(line)
    except ValueError:
        continue
    if r.get("isSidechain"):
        continue
    if r.get("type") == "system" and r.get("subtype") == "compact_boundary":
        comps += 1
        last = r.get("timestamp")
        tokens = (r.get("compactMetadata") or {}).get("postTokens")
    elif r.get("type") == "assistant":
        m = r.get("message") or {}
        u = m.get("usage") or {}
        if u:
            tokens = sum(u.get(k) or 0 for k in ("input_tokens", "cache_creation_input_tokens",
                                                 "cache_read_input_tokens", "output_tokens"))
            model = m.get("model") or model
epoch = "-"
if last:
    epoch = str(int(datetime.fromisoformat(last.replace("Z", "+00:00")).timestamp()))
print(f"tokens={tokens if tokens is not None else '-'} window=- compactions={comps} "
      f"compacted={epoch} model={model or '-'}")
PY
)" || line=unknown
    [[ -n "$line" ]] || line=unknown
    [[ "$line" == tokens=* ]] && line="$line$(handoff_fields)"
    echo "$line"
    exit 0
fi

if $STATE_ONLY; then
    names="cs-claude-$UUID"
    [[ -n "$UUID" ]] || names="$(tmux ls -F '#{session_name}' 2>/dev/null | grep '^cs-claude-' || true)"
    best=absent
    for TMUX_SESSION in $names; do
        session_alive || continue
        word="$(state_word)"
        (( $(state_rank "$word") > $(state_rank "$best") )) && best="$word"
    done
    echo "$best"; exit 0
fi

# Wait until the TUI is ready to accept input. Auto-clears the first-run trust
# prompt; fails fast with an actionable message on screens that need a human
# (sign-in / onboarding) or that signal the warm session is misconfigured
# (a tool-approval prompt — the session is meant to run skip-permissions).
wait_ready() {
    local deadline=$(( SECONDS + 60 ))
    local st d scr answered=0 dialog_at=-1
    while (( SECONDS < deadline )); do
        if ! session_alive; then
            err "tmux session died during startup"; return 3
        fi
        scr="$(pane)"
        st="$(detect_state "$scr")"
        case "$st" in
            trust_folder)
                # Option 1 ("Yes, I trust this folder") is preselected.
                tmux send-keys -t "$TMUX_SESSION" Enter
                sleep 1 ;;
            oauth)
                err "remote Claude needs interactive sign-in (OAuth) — cannot proceed unattended"
                err "  attach to complete it: tmux attach -t $TMUX_SESSION"
                return 3 ;;
            onboarding)
                err "remote Claude is on the first-run onboarding wizard — needs a human"
                err "  attach to complete it: tmux attach -t $TMUX_SESSION"
                return 3 ;;
            tool_approval)
                err "remote Claude is blocked on a tool-approval prompt — the warm session"
                err "  should run with permissions skipped; attach to inspect: tmux attach -t $TMUX_SESSION"
                return 3 ;;
            dialog)
                # A dialog still up after DIALOG_SECS of answers is not the one this driver knows.
                d="$(known_dialog "$scr")"
                (( dialog_at >= 0 )) || dialog_at=$SECONDS
                if (( SECONDS - dialog_at >= DIALOG_SECS )); then
                    err "remote Claude is on a screen that needs a person: $(screen_text "$scr")"
                    err "  attach to answer it: tmux attach -t $TMUX_SESSION"
                    return 3
                fi
                tmux send-keys -t "$TMUX_SESSION" "${d##*|}"
                if (( answered++ == 0 )); then err "dismissed a dialog: ${d%|*}"; fi
                sleep 1 ;;
            prompt)
                err "remote Claude is on a screen that needs a person: $(screen_text "$scr")"
                err "  attach to answer it: tmux attach -t $TMUX_SESSION"
                return 3 ;;
            ready)
                return 0 ;;
            working|picker|unknown|*)
                # transient / still busy — keep polling
                sleep 0.5 ;;
        esac
    done
    err "timed out waiting for the TUI to become ready (last state: $(detect_state))"
    return 3
}

ensure_session() {
    if session_alive; then
        return 0
    fi
    # Decide create vs resume by whether history already exists on disk.
    local jp; jp="$(jsonl_path)"
    local launch
    if [[ -n "$jp" ]]; then
        launch="$WRAPPER --resume $UUID"
    else
        launch="$WRAPPER --session-id $UUID"
    fi
    local newargs=(new-session -d -s "$TMUX_SESSION" -x 220 -y 50)
    if [[ -n "$WORKDIR" ]]; then
        newargs+=(-c "$WORKDIR")
    fi
    newargs+=("$launch")
    if ! tmux "${newargs[@]}"; then
        err "failed to start tmux session ($launch)"; return 3
    fi
    wait_ready
}

# --- run one turn ---------------------------------------------------------

# A driver the agent starts from inside the driven session runs with no line. Left on, it would
# name its own session in ~/.cs-turns/driven, and the hook would then skip the one driven here.
# A TMUX_PANE in some other session changes nothing: a shell can carry one from elsewhere. A
# driver started over ssh has no pane, so cs-claude-remote passes the session it was run from as
# CS_PARENT_TMUX_SESSION.
# A nested driver writes its turn-log line to a log of its own, because the harness reads the
# last lines of the main log as the driven session's turns. The path is set before any turn
# could end, so even a failed start lands there.
if [[ -n "${CS_HANDOFF_TOKENS:-}" && "${CS_HANDOFF_TOKENS}" != 0 && -f "$HANDOFF_DIR/driven" ]]; then
    driven_session=""; read -r driven_session < "$HANDOFF_DIR/driven" 2>/dev/null || true
    nested_in=""
    if [[ -n "${TMUX_PANE:-}" ]]; then
        pane_session="$(tmux display-message -p -t "$TMUX_PANE" '#S' 2>/dev/null)" || pane_session=""
        [[ -n "$pane_session" && "$pane_session" == "$driven_session" ]] && nested_in="$pane_session"
    fi
    if [[ -z "$nested_in" && -n "${CS_PARENT_TMUX_SESSION:-}" && "$CS_PARENT_TMUX_SESSION" == "$driven_session" ]]; then
        nested_in="$CS_PARENT_TMUX_SESSION"
    fi
    # Any wrapper breaks that lineage, such as a tmux session the agent starts for a batch, so
    # ownership counts too. The harness drives one session per machine, and ends the old one
    # before it starts the next. So while the session driven names is alive under another name,
    # this driver is one its agent started. A dead claim is a fresh start, and a resume has the
    # same name. The = makes tmux match that exact name, not a longer one that begins with it.
    if [[ -z "$nested_in" && -n "$driven_session" && "$driven_session" != "$TMUX_SESSION" ]] &&
        tmux has-session -t "=$driven_session" 2>/dev/null; then
        nested_in="$driven_session"
    fi
    if [[ -n "$nested_in" ]]; then
        err "started inside the driven session $nested_in: this one has no hand-off line"
        unset CS_HANDOFF_TOKENS CS_HANDOFF_FILE CS_HANDOFF_ASK
        [[ -n "${CS_TURN_LOG:-}" ]] || TURN_LOG="$HOME/.cs-turns/claude-nested.log"
    fi
fi

ensure_session || exit $?

# Make sure we are not mid-turn before sending.
wait_ready || exit $?

# Name the session this turn drives, for the context hook: a CLI session the agent starts
# itself is another one, and is never asked to hand off over this agent's file.
TURN_START="$(date +%s)"
if [[ -n "${CS_HANDOFF_TOKENS:-}" ]]; then
    { mkdir -p "$HANDOFF_DIR" && printf '%s\n' "$TMUX_SESSION" > "$HANDOFF_DIR/driven"; } 2>/dev/null || true
fi

# Snapshot the JSONL state BEFORE sending. On a brand-new session the JSONL does
# not exist until the first message is submitted, so absent => zero baseline.
JSONL="$(jsonl_path)"
PRE_TURNS="$(turn_count "$JSONL")"
PRE_LINES="$(line_count "$JSONL")"

# Paste the prompt as a single bracketed-paste block, then submit. load-buffer
# from a file means no characters need shell-escaping.
tmux load-buffer "$PROMPT_FILE"
tmux paste-buffer -p -d -t "$TMUX_SESSION"
sleep 0.3
tmux send-keys -t "$TMUX_SESSION" Enter

# The JSONL appears once the first message is accepted; wait for it to exist.
#
# The budget is a span of time rather than a count of tries, because what it is
# really waiting on is a loaded machine. Ten seconds was not enough for one: the
# turn died here, the campaign read a member that had stopped, and the ladder it
# then climbed diverged from the recording, so the failure arrived as a cassette
# miss three rungs from its cause.
if [[ -z "$JSONL" ]]; then
    JSONL="$(await_jsonl "$JSONL_WAIT")"
fi
if [[ -z "$JSONL" ]]; then
    # The TUI occasionally swallows the first Enter while it finishes rendering
    # the pasted block, so send one more and wait again.
    #
    # Only here, and never beside the first. A second Enter sent every time
    # lands in the composer whenever the first already submitted, and what it
    # leaves there is carried into the NEXT prompt: a turn was seen reaching
    # the model as "\r\rRead ~/.local/share/..." — the same text the recording
    # holds, with two carriage returns in front of it, which is a different
    # request and so a cassette miss.
    tmux send-keys -t "$TMUX_SESSION" Enter
    JSONL="$(await_jsonl "$JSONL_WAIT")"
fi
if [[ -z "$JSONL" ]]; then
    err "could not locate JSONL for $UUID under $PROJECTS after submitting and waiting $(( JSONL_WAIT * 2 ))s"; exit 3
fi

# Wait for a new turn_duration marker to appear (turn complete). TIMEOUT=0 waits
# indefinitely; the stall watchdog remains the liveness check either way.
deadline=$(( SECONDS + TIMEOUT ))
completed=false
last_lines="$PRE_LINES"
last_change=$SECONDS
while (( TIMEOUT == 0 || SECONDS < deadline )); do
    if ! session_alive; then
        err "tmux session died mid-turn"; exit 3
    fi
    # Waiting cannot fix a rejected credential, so the retries are cut short and the turn is
    # reported for what it is rather than minutes later.
    #
    # The TUI is ended rather than sent Esc. In vim mode the first Esc only leaves insert
    # mode, the one that does interrupt puts the prompt back in the input box, and a Claude
    # left retrying writes its completion marker into the NEXT turn. The conversation is in
    # the JSONL, and the next turn resumes it.
    why="$(auth_rejected)"
    if [[ -n "$why" ]]; then
        tmux kill-session -t "$TMUX_SESSION" 2>/dev/null
        err "turn failed: the provider rejected the credential (${why})"
        err "failure class=unauthorized retry_after=-"
        exit 5
    fi
    now="$(turn_count "$JSONL")"
    if (( now > PRE_TURNS )); then
        completed=true; break
    fi
    # Stall watchdog: a healthy in-progress turn keeps appending to the JSONL
    # (and the TUI shows "esc to interrupt"). If the JSONL stops growing AND the
    # TUI is no longer working, the turn has wedged or ended without emitting a
    # turn_duration marker — bail early with a diagnostic rather than blocking
    # for the full timeout (which is what made hung background turns invisible).
    if (( STALL_SECS > 0 )); then
        cur_lines="$(line_count "$JSONL")"
        if (( cur_lines != last_lines )); then
            last_lines="$cur_lines"; last_change=$SECONDS
        elif (( SECONDS - last_change >= STALL_SECS )); then
            st="$(detect_state)"
            if [[ "$st" != "working" ]]; then
                err "turn stalled: JSONL unchanged for $(( SECONDS - last_change ))s, TUI state '$st', no turn_duration marker"
                err "  attach to inspect: tmux attach -t $TMUX_SESSION"
                exit 2
            fi
            last_change=$SECONDS   # genuinely still working (long tool call) — reset clock
        fi
    fi
    sleep 1
done

if ! $completed; then
    err "turn did not complete within ${TIMEOUT}s"
    exit 2
fi

# Claude can accept a submitted prompt, append a normal-looking assistant
# message such as "Login expired · Please run /login", and still emit the turn
# completion marker. Treat the resulting sign-in screen as authentication
# failure rather than reporting a successful model turn.
if [[ "$(detect_state)" == "oauth" ]]; then
    err "remote Claude login expired during the turn — sign in again before retrying"
    exit 3
fi

# Claude Code finishes a turn the provider refused the way it finishes any other: it writes
# the refusal as an assistant message ("API Error: Request rejected (429) …") and then the
# completion marker. That message is flagged isApiErrorMessage, with the kind under `error`
# and the HTTP status under apiErrorStatus. Without reading the flag, a throttled turn is
# reported as a finished one whose reply is the error text.
FAILURE="$(python3 - "$JSONL" "$PRE_LINES" <<'PY'
import json, re, sys
last = None
with open(sys.argv[1], encoding="utf-8", errors="replace") as fh:
    for line in fh.readlines()[int(sys.argv[2]):]:
        try: o = json.loads(line)
        except Exception: continue
        if isinstance(o, dict) and o.get("type") == "assistant" and not o.get("isSidechain"):
            last = o
# Only the turn's LAST assistant message decides it: Claude Code retries by itself, and a
# turn that hit an error and then answered has succeeded.
if not last or not last.get("isApiErrorMessage"):
    sys.exit(0)
parts = [b.get("text", "") for b in (last.get("message") or {}).get("content") or []
         if isinstance(b, dict) and b.get("type") == "text"]
msg = " ".join(" ".join(parts).split()) or "provider error"
kind, status, low = last.get("error") or "", last.get("apiErrorStatus"), msg.lower()
if kind == "rate_limit" or status == 429:
    cls = "throttled"
elif kind == "authentication_failed" or status in (401, 403):
    cls = "unauthorized"
elif "prompt is too long" in low or ("context" in low and "limit" in low):
    cls = "context"
elif kind == "server_error" or (isinstance(status, int) and status >= 500) or \
        (status is None and "mid-response" in low):
    cls = "capacity"
elif status is None and any(w in low for w in ("connection error", "fetch failed", "econnrefused",
                                               "enotfound", "etimedout", "timed out", "network")):
    # No provider answered at all. The words are the ones Node's fetch and the SDK use for a
    # failed connection. They were not captured from a live session of this CLI.
    cls = "unreachable"
else:
    cls = "other"
wait = "-"
m = re.search(r"try again in\s+([0-9.]+)\s*(ms|s)\b", low)
if m:
    secs = float(m.group(1)) / (1000.0 if m.group(2) == "ms" else 1.0)
    wait = ("%.3f" % secs).rstrip("0").rstrip(".")
elif cls == "capacity" and status is None and "mid-response" in low:
    # The provider answered and the stream broke partway: "API Error: Server error
    # mid-response", with no status. That one request failed, and sending it again at once
    # is the move, so the wait is 0. The class stays capacity, because a caller that reads
    # capacity already resends to the same session without spending anything.
    wait = "0"
print(msg[:500]); print("class=%s retry_after=%s" % (cls, wait))
PY
)"
if [[ -n "$FAILURE" ]]; then
    err "turn failed: $(sed -n 1p <<<"$FAILURE")"
    err "failure $(sed -n 2p <<<"$FAILURE")"
    exit 5
fi

# A turn the agent ended by handing off, as the context hook asked it to in this session and
# this turn, is reported as one: exit 0, class handoff. A refused turn never reaches here.
if t="$(handoff_end)"; then
    TURN_CLASS="handoff"
    err "handoff at $t tokens, over the line of $CS_HANDOFF_TOKENS"
fi

# Emit this turn's new content from the JSONL (lines appended after PRE_LINES).
python3 - "$JSONL" "$PRE_LINES" "$FORMAT" <<'PY'
import json, sys
path, pre_lines, fmt = sys.argv[1], int(sys.argv[2]), sys.argv[3]
with open(path, encoding="utf-8", errors="replace") as fh:
    lines = fh.readlines()
new = lines[pre_lines:]

if fmt == "json":
    # Emit the raw new JSONL lines verbatim for the caller to parse.
    sys.stdout.write("".join(new))
    sys.exit(0)

# text: concatenate assistant text blocks from the new range.
chunks = []
for line in new:
    line = line.strip()
    if not line:
        continue
    try:
        o = json.loads(line)
    except Exception:
        continue
    if o.get("type") != "assistant":
        continue
    for b in o.get("message", {}).get("content", []):
        if isinstance(b, dict) and b.get("type") == "text":
            t = b.get("text", "").rstrip()
            if t:
                chunks.append(t)
print("\n\n".join(chunks))
PY
