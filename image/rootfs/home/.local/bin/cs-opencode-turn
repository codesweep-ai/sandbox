#!/bin/bash
# Remote-side driver for OpenCode remote delegation (server model — the opencode counterpart of
# cs-codex-turn). Runs ON the remote machine. Drives one conversational turn against an
# INTERACTIVE opencode TUI kept warm in a long-running tmux session, over the HTTP API the TUI
# hosts when launched with --port — never by scraping the tmux pane (opencode's TUI strings are
# localized and unstable; the API is deterministic).
#
# One turn =
#   1. ensure the warm TUI exists: the opencode session id is created/known BEFORE the TUI
#      launches (a session minted via a transient `cs-opencode serve` + POST /session when new),
#      and the TUI is always launched `cs-opencode --port <p> -s <id>` so a human attaching sees
#      the driven session render live;
#   2. readiness = GET /global/health on the TUI's port (no pane scraping);
#   3. drive the turn with a blocking `cs-opencode run --attach http://127.0.0.1:<p> -s <id>
#      --auto "<prompt>"`, watching GET /session/status for stalls (absent key = idle);
#   4. on exit 0, UNCONDITIONALLY postcheck the last assistant message via
#      GET /session/<id>/message: an `error` or a missing `time.completed` means the turn failed
#      even though the attached client exited 0 (provider-side API errors are recorded on the
#      session but not propagated to the attached client's exit code — verified at 1.18.10).
#
# The port is derived deterministically from the tmux token. The session id is emitted as a
# trailing sentinel the local cs-opencode-remote maps to the session name (and strips):
#   __CS_OPENCODE_SESSION_ID__ <ses_id>
#
# Usage: echo "prompt" | cs-opencode-turn --tmux <token> [--uuid <ses_id>] [--workdir <dir>] \
#            [--format text|json] [--timeout <secs>] [--name <label>]
# Exit codes: 0 ok, 2 turn timed out/stalled, 3 launch/setup failure, 4 turn failed
# (client error or a provider error recorded on the session), 1 usage.

set -uo pipefail

TOKEN=""; SES_ID=""; WORKDIR=""; FORMAT="text"; TIMEOUT="${CS_OPENCODE_TIMEOUT:-1800}"; LABEL=""
# Stall watchdog: bail early if the server reports the session idle for this long while the
# attached run client still has not returned. 0 disables. Env-overridable.
STALL_SECS="${CS_OPENCODE_STALL_SECS:-180}"
err() { echo "cs-opencode-turn: $*" >&2; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --tmux)    TOKEN="$2"; shift 2 ;;
        --uuid)    SES_ID="$2"; shift 2 ;;
        --workdir) WORKDIR="$2"; shift 2 ;;
        --format)  FORMAT="$2"; shift 2 ;;
        --timeout) TIMEOUT="$2"; shift 2 ;;
        --name)    LABEL="$2"; shift 2 ;;
        -h|--help) sed -n '2,30p' "$0"; exit 0 ;;
        *) err "unknown argument: $1"; exit 1 ;;
    esac
done

[[ -n "$TOKEN" ]] || { err "--tmux <token> is required"; exit 1; }
[[ "$TOKEN" =~ ^[A-Za-z0-9_-]+$ ]] || { err "--tmux token '$TOKEN' has invalid characters"; exit 1; }
if [[ -n "$SES_ID" ]] && ! [[ "$SES_ID" =~ ^ses_[A-Za-z0-9]{20,40}$ ]]; then
    err "--uuid '$SES_ID' is not a valid opencode session id"; exit 1
fi
for bin in opencode tmux curl python3; do
    command -v "$bin" >/dev/null 2>&1 || { err "$bin not found on remote PATH"; exit 3; }
done

TMUX_SESSION="cs-opencode-$TOKEN"
# Deterministic per-token port in 21000-25095: both the TUI and later resumes of the same token
# derive the same value, so nothing needs to be persisted.
PORT=$(( 21000 + 16#$(printf '%s' "$TOKEN" | md5sum | cut -c1-3) ))
BASE="http://127.0.0.1:$PORT"

PROMPT_FILE="$(mktemp "${TMPDIR:-/tmp}/cs-opencode-turn.XXXXXX")"
OUT_FILE="$(mktemp "${TMPDIR:-/tmp}/cs-opencode-out.XXXXXX")"
ERR_FILE="$(mktemp "${TMPDIR:-/tmp}/cs-opencode-err.XXXXXX")"
trap 'rm -f "$PROMPT_FILE" "$OUT_FILE" "$ERR_FILE"' EXIT
cat > "$PROMPT_FILE"
[[ -s "$PROMPT_FILE" ]] || { err "empty prompt on stdin"; exit 1; }

# --- helpers --------------------------------------------------------------

session_alive() { tmux has-session -t "$TMUX_SESSION" 2>/dev/null; }
healthy() { curl -fsS -m 2 "$BASE/global/health" >/dev/null 2>&1; }

wait_healthy() {
    local deadline=$(( SECONDS + ${1:-60} ))
    while (( SECONDS < deadline )); do healthy && return 0; sleep 0.5; done
    return 1
}

# The server deletes a session's /session/status entry when it goes idle: present key = busy.
session_busy() {
    curl -fsS -m 5 "$BASE/session/status" 2>/dev/null \
        | python3 -c 'import json,sys; d=json.load(sys.stdin); sys.exit(0 if sys.argv[1] in d else 1)' "$SES_ID" 2>/dev/null
}

# Guard against a foreign server squatting the derived port (hash collision with another token's
# TUI): our session id must be resolvable on this server.
session_known() { curl -fsS -m 5 "$BASE/session/$SES_ID" >/dev/null 2>&1; }

# Mint a new opencode session bound to the working directory, using a transient headless server
# on the same derived port (freed again before the TUI launches with -s <id>).
mint_session() {
    local serve_pid dir="${WORKDIR:-$PWD}"
    ( cd "$dir" 2>/dev/null || cd "$HOME"; exec cs-opencode serve --port "$PORT" ) >/dev/null 2>&1 &
    serve_pid=$!
    if ! wait_healthy 90; then
        kill "$serve_pid" 2>/dev/null
        err "transient opencode server never became healthy on port $PORT"; return 3
    fi
    SES_ID="$(curl -fsS -m 10 -X POST "$BASE/session" -H 'content-type: application/json' -d '{}' 2>/dev/null \
        | python3 -c 'import json,sys; print(json.load(sys.stdin).get("id",""))' 2>/dev/null)"
    kill "$serve_pid" 2>/dev/null; wait "$serve_pid" 2>/dev/null
    # Wait for the port to actually free before the TUI binds it.
    for _ in $(seq 1 40); do healthy || break; sleep 0.25; done
    [[ "$SES_ID" =~ ^ses_[A-Za-z0-9]{20,40}$ ]] || { err "could not create an opencode session (got '$SES_ID')"; return 3; }
    return 0
}

# Ensure the warm TUI is up, healthy, and rendering OUR session. The session id always exists
# before the TUI launches; a TUI launched bare would sit on the home screen and never show
# externally driven turns.
ensure_session() {
    if session_alive; then
        if ! wait_healthy 30; then
            err "tmux session '$TMUX_SESSION' is alive but its server is not healthy on port $PORT"
            err "  attach to inspect: tmux attach -t $TMUX_SESSION"
            return 3
        fi
        if [[ -n "$SES_ID" ]]; then
            session_known || { err "server on port $PORT does not know session $SES_ID (port collision or wrong profile)"; return 3; }
            return 0
        fi
        # Warm TUI but no recorded session id: the first turn never completed. Start over so the
        # TUI is bound to the id we are about to drive.
        tmux kill-session -t "$TMUX_SESSION" 2>/dev/null
    fi
    if [[ -z "$SES_ID" ]]; then
        mint_session || return $?
    fi
    local newargs=(new-session -d -s "$TMUX_SESSION" -x 220 -y 50)
    [[ -n "$WORKDIR" ]] && newargs+=(-c "$WORKDIR")
    newargs+=("cs-opencode --port $PORT -s $SES_ID")
    tmux "${newargs[@]}" || { err "failed to start tmux session"; return 3; }
    if ! wait_healthy 90; then
        session_alive || { err "opencode TUI exited during startup (port $PORT in use, or launch failure)"; return 3; }
        err "opencode TUI never became healthy on port $PORT"; return 3
    fi
    session_known || { err "TUI server does not know session $SES_ID"; return 3; }
    return 0
}

# --- run one turn ---------------------------------------------------------

ensure_session || exit $?

# Snapshot the session's message count before submitting: the turn's output is
# read back from the session API afterwards — an attached run client renders
# into the TUI, not onto its own stdout (verified at 1.18.10).
PRE_COUNT="$(curl -fsS -m 10 "$BASE/session/$SES_ID/message" 2>/dev/null | python3 -c '
import json, sys
try:
    print(len(json.load(sys.stdin)))
except Exception:
    print(0)
' 2>/dev/null)"
[[ "$PRE_COUNT" =~ ^[0-9]+$ ]] || PRE_COUNT=0

RUN_ARGS=(run --attach "$BASE" -s "$SES_ID" --auto)

cs-opencode "${RUN_ARGS[@]}" "$(cat "$PROMPT_FILE")" > "$OUT_FILE" 2> "$ERR_FILE" &
RUN_PID=$!

# TIMEOUT=0 waits indefinitely; the idle stall watchdog remains the liveness check.
deadline=$(( SECONDS + TIMEOUT ))
idle_since=""
while kill -0 "$RUN_PID" 2>/dev/null; do
    if (( TIMEOUT > 0 && SECONDS >= deadline )); then
        kill "$RUN_PID" 2>/dev/null; wait "$RUN_PID" 2>/dev/null
        err "turn did not complete within ${TIMEOUT}s"; exit 2
    fi
    if ! session_alive; then
        kill "$RUN_PID" 2>/dev/null; wait "$RUN_PID" 2>/dev/null
        err "tmux session died mid-turn"; exit 3
    fi
    if (( STALL_SECS > 0 )); then
        if session_busy; then
            idle_since=""
        else
            [[ -z "$idle_since" ]] && idle_since=$SECONDS
            if (( SECONDS - idle_since >= STALL_SECS )); then
                kill "$RUN_PID" 2>/dev/null; wait "$RUN_PID" 2>/dev/null
                err "turn stalled: session idle for $(( SECONDS - idle_since ))s but the attached run never returned"
                err "  attach to inspect: tmux attach -t $TMUX_SESSION"
                exit 2
            fi
        fi
    fi
    sleep 2
done
wait "$RUN_PID"; RC=$?

if (( RC != 0 )); then
    err "turn failed (opencode run exit $RC)"
    sed 's/^/  /' "$ERR_FILE" >&2
    exit 4
fi

# Postcheck — REQUIRED even on exit 0: provider-side API errors surface only on the session's
# final assistant message (error set / time.completed absent), not on the attached client.
POSTCHECK="$(curl -fsS -m 10 "$BASE/session/$SES_ID/message" 2>/dev/null | python3 -c '
import json, sys
try:
    msgs = json.load(sys.stdin)
except Exception:
    print("unreadable"); sys.exit(0)
last = None
for m in msgs if isinstance(msgs, list) else []:
    info = m.get("info") if isinstance(m, dict) else None
    if isinstance(info, dict) and info.get("role") == "assistant":
        last = info
if last is None:
    print("no-assistant-message")
elif last.get("error"):
    e = last["error"]
    name = e.get("name", "error") if isinstance(e, dict) else "error"
    data = e.get("data", {}) if isinstance(e, dict) else {}
    msg = data.get("message", "") if isinstance(data, dict) else ""
    print(f"error:{name}:{msg[:200]}")
elif not (last.get("time") or {}).get("completed"):
    print("incomplete")
else:
    print("ok")
' 2>/dev/null)"
if [[ "$POSTCHECK" != "ok" ]]; then
    err "turn failed despite run exit 0 — session postcheck: ${POSTCHECK:-unreachable}"
    exit 4
fi

# Emit this turn's new content from the session API (messages appended after
# the pre-submit snapshot): text = the assistant's text parts, json = the raw
# new message objects.
curl -fsS -m 10 "$BASE/session/$SES_ID/message" 2>/dev/null | python3 -c '
import json, sys
pre, fmt = int(sys.argv[1]), sys.argv[2]
try:
    msgs = json.load(sys.stdin)
except Exception:
    msgs = []
new = msgs[pre:] if isinstance(msgs, list) else []
if fmt == "json":
    json.dump(new, sys.stdout, indent=None)
    sys.stdout.write("\n")
    sys.exit(0)
chunks = []
for m in new:
    info = m.get("info") if isinstance(m, dict) else None
    if not isinstance(info, dict) or info.get("role") != "assistant":
        continue
    for p in m.get("parts") or []:
        if isinstance(p, dict) and p.get("type") == "text":
            t = (p.get("text") or "").rstrip()
            if t:
                chunks.append(t)
print("\n\n".join(chunks))
' "$PRE_COUNT" "$FORMAT"
printf '\n__CS_OPENCODE_SESSION_ID__ %s\n' "$SES_ID"
exit 0
