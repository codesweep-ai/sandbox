#!/bin/bash
# Remote-side driver for OpenCode remote delegation (server model — the opencode counterpart of
# cs-codex-turn). Runs ON the remote machine. Drives one conversational turn against an opencode
# server kept warm in a long-running tmux session, over the server's HTTP API — never by scraping
# a pane (opencode's TUI strings are localized and unstable; the API is deterministic).
#
# The tmux session holds two windows. `server` runs `cs-opencode serve` on a port derived from the
# tmux token; the session lives as long as that window does. `tui` runs the interactive TUI as a
# client of the same server, opened on the driven session, so a human attaching sees the turn
# render live and can intervene. opencode has no API that moves a running TUI to another session,
# so the TUI is opened on the session once it exists, and opened again if a human closed it.
#
# One turn =
#   1. ensure the server is up and knows the session: readiness = an authenticated GET /api/info
#      that answers with the server's version (every path outside /api answers 200 with the web
#      UI, so a status code alone proves nothing); a new session is created on it with
#      POST /api/session, bound to the working directory;
#   2. drive the turn with a blocking `cs-opencode run --server http://127.0.0.1:<p> -s <id>
#      --auto`, the prompt on its stdin, watching GET /api/session/active for stalls (absent key =
#      idle);
#   3. read THIS TURN's messages back from GET /api/session/<id>/message and judge the turn by the
#      `idle` message opencode appends when a session stops: its outcome is succeeded, failed or
#      interrupted, with the provider's error. run's exit code is not the verdict. It is 1 after a
#      stream that failed mid-step and was retried to a success, and it is 0 when the client lost
#      its server.
#
# The turn is delimited by the ID of the newest message that existed before it, never by a message
# COUNT: compaction inserts messages of its own, so positions are not stable and a positional
# cursor would silently return the wrong slice. `id` and `time.created` are both required fields
# on every message, giving a primary and a fallback anchor.
#
# The server asks every client for a password. The driver keeps one in the profile, made once at
# mode 600 (~/.cs-opencode/server-password), and hands it to the server and its clients in their
# environment and to curl in ~/.cs-opencode/curlrc, so it never appears in an argv.
#
# The port is derived deterministically from the tmux token. The session id is emitted as a
# trailing sentinel the local cs-opencode-remote maps to the session name (and strips):
#   __CS_OPENCODE_SESSION_ID__ <ses_id>
#
# Usage: echo "prompt" | cs-opencode-turn --tmux <token> [--uuid <ses_id>] [--workdir <dir>] \
#            [--format text|json] [--timeout <secs>] [--name <label>]
#        cs-opencode-turn --state [--tmux <token> [--uuid <ses_id>]]
#        cs-opencode-turn --context [--uuid <ses_id>]
#        cs-opencode-turn --budget
#
# --state says whether opencode is in a turn right now, whoever started the turn, and starts or
# wakes nothing. It prints one line and exits 0: busy, idle, unknown (a server is up and does not
# answer) or absent (no session). It asks the server, as the driver does, so there is no screen
# to be blocked on and that word is never printed. With no --tmux it answers for every opencode
# session here: busy if any is, idle only if all are. With no --uuid a server is busy when any of
# its sessions is.
#
# --context reads opencode's database and says how full the conversation is. It prints one line
# and exits 0: "tokens=<n|-> window=- compactions=<n> compacted=<epoch|-> model=<id|->", or
# "absent" when there is no session, or "unknown" when the database cannot be read. tokens is the
# context the latest model call carried. opencode does not record its window, so window is "-".
# With no --uuid it answers for the newest top-level session. It starts nothing, and asks no
# server: the context hook calls it from inside the server, which cannot answer while it waits.
#
# --budget takes one reading of the sandbox's token budget (CS_METER_URL) and says whether a turn
# would be sent. It prints one line and exits 0: "ok", "ask <types>" when a type is at its ask
# line, the types by their bare names and comma-separated, "none" when no reading could be taken,
# or "off" when the sandbox has no meter. Like --state it starts nothing and writes nothing.
# cs-campaign asks it of a node held on a spent budget, so a raised budget is tried at once.
#
# Exit codes: 0 ok, 2 turn timed out/stalled, 3 launch/setup failure, 5 turn failed (client error,
# a provider error recorded on the session, or the token budget kept it from being sent), 1 usage.
# 5 rather than 4 because cs-opencode-remote already spends 4 on "session busy" (its per-session
# turn lock), as the claude/codex tools do.
#
# A turn the provider refused prints the provider's message, then one line a caller can parse:
#   cs-opencode-turn: failure class=<throttled|capacity|unauthorized|context|unreachable|spent|other> retry_after=<secs|->
#
# spent is the sandbox's token budget, where the lender has a meter for it (CS_METER_URL). It
# ends a turn three ways: exit 5 when a type was already at its ask line and nothing was sent,
# exit 5 when the lender refused a call under a hard budget, and exit 0 when the agent handed
# off as the context hook asked it to on the budget.

set -uo pipefail

STATE_ONLY=false
CONTEXT_ONLY=false
BUDGET_ONLY=false
TOKEN=""; SES_ID=""; WORKDIR=""; FORMAT="text"; TIMEOUT="${CS_OPENCODE_TIMEOUT:-1800}"; LABEL=""
# Stall watchdog: bail early if the server reports the session idle for this long while the
# attached run client still has not returned. 0 disables. Env-overridable.
STALL_SECS="${CS_OPENCODE_STALL_SECS:-180}"
# The turn log. Every turn end appends one line here, on the machine the agent runs on, so a
# harness that asks this machine about this agent can learn how its last turn ended:
#   <epoch> <exit code> <class|-> <retry_after|-> <first line of the reason, or ->
# The class line below goes to whoever started the turn, and that may be another machine, or
# gone. One format serves every agent family. --state and a usage error are not turns and
# write nothing. A driver that is killed writes nothing either, so no line means not known.
# Writing is best effort: a full disk must not change how a turn is reported.
TURN_LOG="${CS_TURN_LOG:-$HOME/.cs-turns/opencode.log}"
TURN_LOG_KEEP=200
TURN_CLASS="-"; TURN_RETRY="-"; TURN_MSG=""
err() {
    echo "cs-opencode-turn: $*" >&2
    case "$*" in
        "failure class="*)
            TURN_CLASS="${*#failure class=}"; TURN_CLASS="${TURN_CLASS%% *}"
            TURN_RETRY="${*##*retry_after=}" ;;
        "turn failed"*) TURN_MSG="$*" ;;
        " "*) ;;
        *) [[ "$TURN_MSG" == "turn failed"* ]] || TURN_MSG="$*" ;;
    esac
}
record_turn_end() {
    local rc="$1" msg
    $STATE_ONLY && return 0
    (( rc == 1 )) && return 0
    msg="$(printf '%s' "${TURN_MSG:--}" | tr '\n\r\t' '   ' | cut -c1-300)"
    {
        mkdir -p "${TURN_LOG%/*}" &&
        printf '%s %s %s %s %s\n' "$(date +%s)" "$rc" "$TURN_CLASS" "$TURN_RETRY" "$msg" >> "$TURN_LOG" &&
        if (( $(wc -l < "$TURN_LOG") > TURN_LOG_KEEP * 2 )); then
            tail -n "$TURN_LOG_KEEP" "$TURN_LOG" > "$TURN_LOG.tmp" && mv "$TURN_LOG.tmp" "$TURN_LOG"
        fi
    } 2>/dev/null || true
    return 0
}
trap 'record_turn_end "$?"' EXIT

# The context hook (the cs-context-hook plugin) records in ~/.cs-turns when it asked the agent
# to hand off, and reads there which tmux session this driver drives. Both are read and
# written here and nowhere else in this driver.
HANDOFF_DIR="$HOME/.cs-turns"
TURN_START=0
# Set when this driver was started from inside the driven session (below).
NESTED=false
# asked_end <ask file> prints what the hook asked about when THIS turn ended because the agent
# handed off as it asked: the hook asked in the session this driver drives, during this turn,
# and the handoff file is newer than the ask. That is the tokens at a context ask (handoff-ask),
# or the types that ran out at a budget ask (budget-ask), each by its bare name with the figures
# the hook recorded. Anything else fails, and the turn is reported as whatever it was.
asked_end() {
    ! $NESTED && [[ -f "$HANDOFF_DIR/$1" ]] || return 1
    python3 - "$HANDOFF_DIR/$1" "$TMUX_SESSION" "$TURN_START" "${CS_HANDOFF_FILE:-$HANDOFF_DIR/handoff.md}" <<'PY'
import json, os, sys
def fmt(n):
    if not isinstance(n, (int, float)):
        return "?"
    for size, unit in ((1e9, "G"), (1e6, "M"), (1e3, "K")):
        if n >= size:
            return "%.2f%s" % (n / size, unit)
    return str(int(n))
try:
    ask = json.load(open(sys.argv[1]))
    at = float(ask.get("at") or 0)
    if ask.get("session") == sys.argv[2] and at >= float(sys.argv[3]) \
            and os.path.getmtime(os.path.expanduser(sys.argv[4])) >= at:
        if isinstance(ask.get("types"), list):
            used = ask.get("used") if isinstance(ask.get("used"), dict) else {}
            limits = ask.get("limits") if isinstance(ask.get("limits"), dict) else {}
            num = lambda v: isinstance(v, (int, float))
            print(", ".join("%s at %s of its %s limit" % (t, fmt(used[t]), fmt(limits[t]))
                            if num(used.get(t)) and num(limits.get(t)) else str(t)
                            for t in ask["types"]) or "-")
        else:
            print(ask.get("tokens", "-"))
        sys.exit(0)
except Exception:
    pass
sys.exit(1)
PY
}
# The turn ended on the context line's ask, or on the budget line's.
handoff_end() { [[ -n "${CS_HANDOFF_TOKENS:-}" && "${CS_HANDOFF_TOKENS}" != 0 ]] && asked_end handoff-ask; }
spent_end() { [[ -n "${CS_METER_URL:-}" ]] && asked_end budget-ask; }

# The token budget. A lent sandbox can carry CS_METER_URL, where the lender answers with this
# sandbox's token count and budget, and CS_METER_TOKEN, the loan the reading is made with. The
# lender sees every call the sandbox makes, so the count is the sandbox's, not this session's.
# Unset, the sandbox has no meter, and nothing about the budget runs.
#
# budget_check takes one reading and prints one line: "ask <what>" when a type is at its ask
# line, "none <why>" when there is no reading, and "ok" otherwise. <what> names each type that ran
# out by its bare name, input, cached or output, and no other: cs-campaign reads the type from
# the turn's reason, and a line that named all three would send it to the wrong one. A reading
# is a 200 within about 3 s whose body is the lender's JSON. Anything else is none, and the turn
# runs through it: under a soft budget, a lender that cannot answer must not stop the work. The reading is
# taken in Python rather than with curl, which here is set up for this profile's own server.
budget_check() {
    python3 - <<'PY' 2>/dev/null || echo "none the reading could not be taken"
import json, os, urllib.error, urllib.request
def fmt(n):
    if not isinstance(n, (int, float)):
        return "?"
    for size, unit in ((1e9, "G"), (1e6, "M"), (1e3, "K")):
        if n >= size:
            return "%.2f%s" % (n / size, unit)
    return str(int(n))
req = urllib.request.Request(os.environ["CS_METER_URL"],
                             headers={"Authorization": "Bearer " + os.environ.get("CS_METER_TOKEN", "")})
try:
    with urllib.request.urlopen(req, timeout=3) as r:
        status, body = r.status, r.read()
except urllib.error.HTTPError as e:
    status, body = e.code, b""
except Exception as e:
    print("none %s" % (getattr(e, "reason", None) or e))
    raise SystemExit(0)
if status != 200:
    print("none the lender answered %s" % status)
    raise SystemExit(0)
try:
    doc = json.loads(body)
    limits, ask = doc["limits"], doc["ask"]
except Exception:
    doc, limits, ask = None, None, None
if not isinstance(limits, dict) or not isinstance(ask, list):
    print("none the answer is not a reading")
    raise SystemExit(0)
ask = [t for t in ask if isinstance(t, str)]
if not ask:
    print("ok")
    raise SystemExit(0)
used = doc.get("used") if isinstance(doc.get("used"), dict) else {}
spent = doc.get("spent") if isinstance(doc.get("spent"), list) else []
what = ", ".join("%s at %s of its %s limit" % (t, fmt(used.get(t)), fmt(limits.get(t))) for t in ask)
# Under a hard budget the ask line is below the limit, so a type can be asked about before it is spent.
state = "spent" if all(t in spent for t in ask) else "at its ask line"
if os.environ.get("BUDGET_PROBE") == "1":
    print("ask " + ",".join(ask))
    raise SystemExit(0)
print("ask token budget %s: %s; the operator raises it on the host" % (state, what))
PY
}
# handoff_fields is what --context adds to a reading when a line is set: the line, and
# floor=<tokens> when the hook found this session over the line on its first reading and so
# never asked (the line is below what a fresh session costs). Nothing when no line is set.
handoff_fields() {
    local h="${CS_HANDOFF_TOKENS:-}" floor="-"
    [[ -n "$h" && "$h" != 0 ]] || return 0
    if [[ -f "$HANDOFF_DIR/handoff-floor" ]]; then
        floor="$(python3 - "$HANDOFF_DIR/handoff-floor" "$SES_ID" <<'PY' 2>/dev/null
import json, sys
f = json.load(open(sys.argv[1]))
print(f.get("tokens", "-") if not sys.argv[2] or f.get("session") == sys.argv[2] else "-")
PY
)" || floor="-"
        [[ -n "$floor" ]] || floor="-"
    fi
    printf ' handoff=%s floor=%s' "$h" "$floor"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --tmux)    TOKEN="$2"; shift 2 ;;
        --uuid)    SES_ID="$2"; shift 2 ;;
        --workdir) WORKDIR="$2"; shift 2 ;;
        --format)  FORMAT="$2"; shift 2 ;;
        --timeout) TIMEOUT="$2"; shift 2 ;;
        --name)    LABEL="$2"; shift 2 ;;
        --state)   STATE_ONLY=true; shift ;;
        # --context is a question, not a turn, so it takes the same no-turn path as --state.
        --context) STATE_ONLY=true; CONTEXT_ONLY=true; shift ;;
        # --budget is a question too, and takes the same no-turn path.
        --budget)  STATE_ONLY=true; BUDGET_ONLY=true; shift ;;
        -h|--help) trap - EXIT; sed -n '2,70p' "$0"; exit 0 ;;
        *) err "unknown argument: $1"; exit 1 ;;
    esac
done

$STATE_ONLY || [[ -n "$TOKEN" ]] || { err "--tmux <token> is required"; exit 1; }
[[ -z "$TOKEN" || "$TOKEN" =~ ^[A-Za-z0-9_-]+$ ]] || { err "--tmux token '$TOKEN' has invalid characters"; exit 1; }
if [[ -n "$SES_ID" ]] && ! [[ "$SES_ID" =~ ^ses_[A-Za-z0-9]{20,40}$ ]]; then
    err "--uuid '$SES_ID' is not a valid opencode session id"; exit 1
fi

# --budget answers from one reading and goes no further: no session, no turn log, no tmux.
if $BUDGET_ONLY; then
    [[ -n "${CS_METER_URL:-}" ]] || { echo off; exit 0; }
    budget="$(BUDGET_PROBE=1 budget_check)"
    case "$budget" in
        ok|"ask "*) echo "$budget" ;;
        *) echo none ;;
    esac
    exit 0
fi
# TIMEOUT reaches here from --timeout or the env default, and 0 legitimately means
# "wait indefinitely". Bash arithmetic reads a non-numeric value as 0, so without
# this check a typo would not fail — it would silently remove the budget and wait
# forever, which is the failure this driver's watchdogs exist to make impossible.
[[ "$TIMEOUT" =~ ^[0-9]+$ ]] || { err "--timeout '$TIMEOUT' must be a non-negative integer (0 = no limit)"; exit 1; }
# cs-opencode (not bare opencode) is what this driver runs: it is the wrapper that binds the
# isolated ~/.cs-opencode profile, so a turn driven without it would use the wrong config/db.
if ! $STATE_ONLY; then
    for bin in opencode cs-opencode tmux curl python3; do
        command -v "$bin" >/dev/null 2>&1 || { err "$bin not found on remote PATH"; exit 3; }
    done
fi

# A working directory that does not exist is not one to run in. opencode binds a session to the
# directory it is given and then fails on every prompt with a path error, so the fallback is chosen
# here and said out loud rather than left to whichever component noticed first.
if [[ -n "$WORKDIR" && ! -d "$WORKDIR" ]]; then
    err "working directory '$WORKDIR' does not exist; running in $HOME instead"
    WORKDIR="$HOME"
fi

# Deterministic per-token port in 21000-25095: both the server and later resumes of the same token
# derive the same value, so nothing needs to be persisted.
port_of() { echo $(( 21000 + 16#$(printf '%s' "$1" | md5sum | cut -c1-3) )); }
TMUX_SESSION="cs-opencode-$TOKEN"
PORT="$(port_of "$TOKEN")"
BASE="http://127.0.0.1:$PORT"

# The profile's server password, and the curl config that carries it. Both are made only with
# builtins, so the value never reaches an argv, and only when a turn is about to start a server.
OC_DIR="$HOME/.cs-opencode"
PW_FILE="$OC_DIR/server-password"
CURLRC="$OC_DIR/curlrc"
ensure_password() {
    local pw
    mkdir -p "$OC_DIR" 2>/dev/null
    if [[ ! -s "$PW_FILE" ]]; then
        ( umask 077; head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$PW_FILE" ) || return 1
    fi
    pw="$(<"$PW_FILE")"
    if [[ ! -s "$CURLRC" || "$(<"$CURLRC")" != "user = \"opencode:$pw\"" ]]; then
        ( umask 077; printf 'user = "opencode:%s"\n' "$pw" > "$CURLRC" ) || return 1
    fi
}
# The prefix a tmux command line starts a server or client of this profile with. It names the file
# rather than the value, which tmux's own argv would publish.
PW_ENV="OPENCODE_PASSWORD=\"\$(cat '$PW_FILE')\""

if ! $STATE_ONLY; then
    ensure_password || { err "could not write the server password under $OC_DIR"; exit 3; }
    PROMPT_FILE="$(mktemp "${TMPDIR:-/tmp}/cs-opencode-turn.XXXXXX")"
    OUT_FILE="$(mktemp "${TMPDIR:-/tmp}/cs-opencode-out.XXXXXX")"
    ERR_FILE="$(mktemp "${TMPDIR:-/tmp}/cs-opencode-err.XXXXXX")"
    trap 'rc=$?; rm -f "$PROMPT_FILE" "$OUT_FILE" "$ERR_FILE"; record_turn_end "$rc"' EXIT
    cat > "$PROMPT_FILE"
    [[ -s "$PROMPT_FILE" ]] || { err "empty prompt on stdin"; exit 1; }
fi

# --- helpers --------------------------------------------------------------

# An authenticated call to the server. Never through a proxy: the server is on loopback.
api() { curl -fsS --noproxy '*' -K "$CURLRC" "$@"; }

session_alive() { tmux has-session -t "=$TMUX_SESSION" 2>/dev/null; }
# The server window is what the session's life is measured by: a TUI left open after the server
# died keeps the tmux session up with nothing behind it.
server_alive() { tmux list-windows -t "=$TMUX_SESSION" -F '#{window_name}' 2>/dev/null | grep -qx server; }
# /api/info answers 503 while the server boots and 401 without the password, which -f turns into
# a failure; the version field is what tells the API from the web UI's fallback page.
healthy() { api -m 2 "$BASE/api/info" 2>/dev/null | grep -q '"version"'; }

wait_healthy() {
    local deadline=$(( SECONDS + ${1:-60} ))
    while (( SECONDS < deadline )); do healthy && return 0; sleep 0.5; done
    return 1
}

# The server lists a session under /api/session/active while it runs and drops it when it goes
# idle: present key = busy. With no session id, any entry: a caller asking about the server rather
# than one session on it.
session_busy() {
    api -m 5 "$BASE/api/session/active" 2>/dev/null \
        | python3 -c 'import json,sys; d=json.load(sys.stdin).get("data") or {}; k=sys.argv[1]; sys.exit(0 if (k in d if k else len(d) > 0) else 1)' "$SES_ID" 2>/dev/null
}

# Several sessions of one family can be up in one sandbox. The answer is the one a caller
# must respect most: a turn anywhere is busy, and idle only when every session is.
state_rank() { case "${1%% *}" in busy) echo 4 ;; blocked) echo 3 ;; unknown) echo 2 ;; idle) echo 1 ;; *) echo 0 ;; esac; }

if $CONTEXT_ONLY; then
    db="${OPENCODE_DB:-$HOME/.cs-opencode/opencode.db}"
    [[ -f "$db" ]] || { echo absent; exit 0; }
    # A compaction is a message of its own, and its token count is the cost of writing the
    # summary, not the conversation, so the reading is unknown until the first model call after
    # it. A subagent's session has a parent and is not the conversation either.
    line="$(python3 - "$db" "$SES_ID" <<'PY' 2>/dev/null
import json, sqlite3, sys
db = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True)
sid = sys.argv[2]
if not sid:
    row = db.execute("SELECT id FROM session_v2 WHERE parent_id IS NULL ORDER BY time_updated DESC LIMIT 1").fetchone()
    sid = row[0] if row else ""
if not sid or not db.execute("SELECT 1 FROM session_v2 WHERE id = ?", (sid,)).fetchone():
    print("absent")
    sys.exit(0)
tokens, comps, last, model = None, 0, None, None
for kind, data in db.execute("SELECT type, data FROM session_message WHERE session_id = ? ORDER BY seq", (sid,)):
    m = json.loads(data)
    if kind == "compaction":
        if m.get("status") == "completed":
            comps += 1
            last = (m.get("time") or {}).get("created")
            tokens = None
        continue
    if kind != "assistant":
        continue
    t = m.get("tokens") or {}
    total = ((t.get("input") or 0) + (t.get("output") or 0) + (t.get("reasoning") or 0)
             + ((t.get("cache") or {}).get("read") or 0) + ((t.get("cache") or {}).get("write") or 0))
    if total:
        tokens = total
        model = (m.get("model") or {}).get("id") or model
epoch = "-" if not last else str(int(last) // 1000)
print(f"tokens={'-' if tokens is None else tokens} window=- compactions={comps} compacted={epoch} model={model or '-'}")
PY
)" || line=unknown
    [[ -n "$line" ]] || line=unknown
    [[ "$line" == tokens=* ]] && line="$line$(handoff_fields)"
    echo "$line"
    exit 0
fi

if $STATE_ONLY; then
    tokens="$TOKEN"
    [[ -n "$TOKEN" ]] || tokens="$(tmux ls -F '#{session_name}' 2>/dev/null | sed -n 's/^cs-opencode-//p')"
    best=absent
    for t in $tokens; do
        TMUX_SESSION="cs-opencode-$t"; BASE="http://127.0.0.1:$(port_of "$t")"
        session_alive || continue
        # The same two questions the driver asks: is the server there, and does it list a turn.
        if ! healthy; then word=unknown; elif session_busy; then word=busy; else word=idle; fi
        (( $(state_rank "$word") > $(state_rank "$best") )) && best="$word"
    done
    echo "$best"; exit 0
fi

# Guard against a foreign server squatting the derived port (hash collision with another token's
# server): our session id must be resolvable on this server.
session_known() { api -m 5 "$BASE/api/session/$SES_ID" >/dev/null 2>&1; }

# The pid listening on the derived port, or empty. ss names the socket's owner, which is the one
# process a kill has to reach; matching the command line instead would also match the tmux process
# whose argv carries the same port.
port_pid() { ss -lptnH "sport = :$PORT" 2>/dev/null | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2; }

# Whether a DIFFERENT live token derives this same port. The port is a hash of the token, so two
# sessions in one sandbox can collide; that server belongs to its own session and reclaiming it
# would kill somebody else's warm server.
port_owned_by_other_token() {
    local session token
    while read -r session; do
        [[ -z "$session" || "$session" == "$TMUX_SESSION" ]] && continue
        token="${session#cs-opencode-}"
        (( 21000 + 16#$(printf '%s' "$token" | md5sum | cut -c1-3) == PORT )) && return 0
    done < <(tmux list-sessions -F '#S' 2>/dev/null | grep '^cs-opencode-')
    return 1
}

# Take the derived port back from a server that no tmux session stands behind.
#
# Such a server is a turn that died before it could clean up. It answers every health check below
# while no window shows it, so the driver would attach to it, run the turn in whatever directory
# it was started in, and leave the human attaching to a blank pane. Nothing else clears it either:
# a restart kills the tmux session, and this process is not in one.
#
# The port belongs to this token, so anything else holding it is stale by construction — except a
# colliding token, which is checked first. The effect is what is verified, not the signal: the
# health check is the test, and SIGKILL follows SIGTERM. Anything listening counts, not only a
# server that answers this profile's password.
reclaim_port() {
    [[ -n "$(port_pid)" ]] || healthy || return 0
    session_alive && return 0
    if port_owned_by_other_token; then
        err "port $PORT is held by another cs-opencode session whose token hashes to it"
        err "  rename this session so its token derives a different port"
        return 3
    fi
    local pid; pid="$(port_pid)"
    err "reclaiming port $PORT from a leftover opencode server (pid ${pid:-unknown})"
    if [[ -n "$pid" ]]; then kill "$pid" 2>/dev/null; else pkill -f "serve --hostname 127.0.0.1 --port $PORT" 2>/dev/null; fi
    for _ in $(seq 1 40); do [[ -z "$(port_pid)" ]] && ! healthy && return 0; sleep 0.25; done
    [[ -n "$pid" ]] && kill -9 "$pid" 2>/dev/null
    for _ in $(seq 1 20); do [[ -z "$(port_pid)" ]] && ! healthy && return 0; sleep 0.25; done
    err "port $PORT is still answering after SIGKILL; cannot start a turn on it"
    return 3
}

# Open the TUI on the driven session, unless a TUI window is already there. A human who quits it
# gets it back on the next turn. The turn is driven over the API and does not depend on it.
ensure_tui() {
    tmux list-windows -t "=$TMUX_SESSION" -F '#{window_name}' 2>/dev/null | grep -qx tui && return 0
    local args=(new-window -t "=$TMUX_SESSION:" -n tui)
    [[ -n "$WORKDIR" ]] && args+=(-c "$WORKDIR")
    args+=("$PW_ENV exec cs-opencode --server $BASE -s $SES_ID")
    tmux "${args[@]}" 2>/dev/null || err "note: the TUI did not open on $SES_ID; the turn still runs"
}

# Ensure the warm server is up, healthy, and knows OUR session.
#
# One server per token, and the TUI is a client of it. A new session is created on the server's
# own API, so nothing else ever binds this port.
ensure_session() {
    if session_alive && ! server_alive; then
        # The server is gone and only a TUI is left: start over, keeping the session id, since
        # the session lives in the database rather than in the server.
        tmux kill-session -t "=$TMUX_SESSION" 2>/dev/null
    fi
    if session_alive; then
        if ! wait_healthy 30; then
            err "tmux session '$TMUX_SESSION' is alive but its server is not healthy on port $PORT"
            err "  attach to inspect: tmux attach -t $TMUX_SESSION"
            return 3
        fi
        if [[ -n "$SES_ID" ]]; then
            session_known || { err "server on port $PORT does not know session $SES_ID (port collision or wrong profile)"; return 3; }
            ensure_tui
            return 0
        fi
        # Warm server but no recorded session id: the first turn never completed. Start over so
        # the window a human attaches to shows the session we are about to drive.
        tmux kill-session -t "=$TMUX_SESSION" 2>/dev/null
    fi
    reclaim_port || return 3
    local newargs=(new-session -d -s "$TMUX_SESSION" -n server -x 220 -y 50)
    [[ -n "$WORKDIR" ]] && newargs+=(-c "$WORKDIR")
    newargs+=("$PW_ENV exec cs-opencode serve --hostname 127.0.0.1 --port $PORT")
    tmux "${newargs[@]}" || { err "failed to start tmux session"; return 3; }
    if ! wait_healthy 90; then
        server_alive || { err "opencode server exited during startup (port $PORT in use, or launch failure)"; return 3; }
        err "opencode server never became healthy on port $PORT"; return 3
    fi
    if [[ -z "$SES_ID" ]]; then
        # The session is bound to the directory named here rather than to the server's cwd, so the
        # turn runs where the caller asked even if the server was started somewhere else.
        SES_ID="$(python3 -c 'import json,os,sys; print(json.dumps({"location": {"directory": os.path.abspath(sys.argv[1])}}))' "${WORKDIR:-$PWD}" \
            | api -m 10 -X POST -H 'content-type: application/json' --data-binary @- "$BASE/api/session" 2>/dev/null \
            | python3 -c 'import json,sys; print((json.load(sys.stdin).get("data") or {}).get("id",""))' 2>/dev/null)"
        [[ "$SES_ID" =~ ^ses_[A-Za-z0-9]{20,40}$ ]] || { err "could not create an opencode session (got '$SES_ID')"; return 3; }
    fi
    session_known || { err "server does not know session $SES_ID"; return 3; }
    ensure_tui
    return 0
}

# --- run one turn ---------------------------------------------------------

# A driver the agent starts from inside the driven session runs with no line, and the hook's
# budget line never asks its session either. Left on, it would name its own session in
# ~/.cs-turns/driven, and the hook would then skip the one driven here. It still reads the budget
# before its turn, because the budget is the sandbox's and its calls spend it too.
# A TMUX_PANE in some other session changes nothing: a shell can carry one from elsewhere. A
# driver started over ssh has no pane, so cs-opencode-remote passes the session it was run from as
# CS_PARENT_TMUX_SESSION.
# A nested driver writes its turn-log line to a log of its own, because the harness reads the
# last lines of the main log as the driven session's turns. The path is set before any turn
# could end, so even a failed start lands there.
if [[ -f "$HANDOFF_DIR/driven" ]] &&
    { [[ -n "${CS_HANDOFF_TOKENS:-}" && "${CS_HANDOFF_TOKENS}" != 0 ]] || [[ -n "${CS_METER_URL:-}" ]]; }; then
    driven_session=""; read -r driven_session < "$HANDOFF_DIR/driven" 2>/dev/null || true
    nested_in=""
    if [[ -n "${TMUX_PANE:-}" ]]; then
        pane_session="$(tmux display-message -p -t "$TMUX_PANE" '#S' 2>/dev/null)" || pane_session=""
        [[ -n "$pane_session" && "$pane_session" == "$driven_session" ]] && nested_in="$pane_session"
    fi
    if [[ -z "$nested_in" && -n "${CS_PARENT_TMUX_SESSION:-}" && "$CS_PARENT_TMUX_SESSION" == "$driven_session" ]]; then
        nested_in="$CS_PARENT_TMUX_SESSION"
    fi
    # Any wrapper breaks that lineage, such as a tmux session the agent starts for a batch, so
    # ownership counts too. The harness drives one session per machine, and ends the old one
    # before it starts the next. So while the session driven names is alive under another name,
    # this driver is one its agent started. A dead claim is a fresh start, and a resume has the
    # same name. The = makes tmux match that exact name, not a longer one that begins with it.
    if [[ -z "$nested_in" && -n "$driven_session" && "$driven_session" != "$TMUX_SESSION" ]] &&
        tmux has-session -t "=$driven_session" 2>/dev/null; then
        nested_in="$driven_session"
    fi
    if [[ -n "$nested_in" ]]; then
        err "started inside the driven session $nested_in: this one has no hand-off line"
        unset CS_HANDOFF_TOKENS CS_HANDOFF_FILE CS_HANDOFF_ASK
        NESTED=true
        [[ -n "${CS_TURN_LOG:-}" ]] || TURN_LOG="$HOME/.cs-turns/opencode-nested.log"
    fi
fi

# A sandbox whose token budget is at its ask line sends nothing: no tokens are spent, and the
# session is left as it was, not even started or resumed. Only the operator can raise the
# budget, so the class says not to send again.
if [[ -n "${CS_METER_URL:-}" ]]; then
    budget="$(budget_check)"
    case "$budget" in
        "ask "*)
            err "turn not sent, ${budget#ask }"
            err "failure class=spent retry_after=-"
            exit 5 ;;
        "none "*) err "no reading of the token budget (${budget#none }); the turn runs without one" ;;
    esac
fi

ensure_session || exit $?

# Name the session this turn drives, for the context hook: a CLI session the agent starts
# itself is another one, and is never asked to hand off over this agent's file.
TURN_START="$(date +%s)"
if ! $NESTED && [[ -n "${CS_HANDOFF_TOKENS:-}${CS_METER_URL:-}" ]]; then
    { mkdir -p "$HANDOFF_DIR" && printf '%s\n' "$TMUX_SESSION" > "$HANDOFF_DIR/driven"; } 2>/dev/null || true
fi

# Anchor this turn in the session's history before submitting: the turn's output and verdict are
# read back from the session API afterwards. The anchor is the id of the newest existing message,
# NOT a message COUNT. The list is newest first, so one message is all it takes.
#
# TURN_START_MS is the secondary anchor for the case where the anchor message is gone by the time
# the turn is read back: `time.created` is a required epoch-ms field, so "messages created since
# the turn began" still delimits the turn.
ANCHOR_ID="$(api -m 10 "$BASE/api/session/$SES_ID/message?order=desc&limit=1" 2>/dev/null | python3 -c '
import json, sys
try:
    msgs = json.load(sys.stdin).get("data") or []
    print((msgs[0] if msgs else {}).get("id") or "")
except Exception:
    print("")
' 2>/dev/null)"
TURN_START_MS="$(python3 -c 'import time; print(int(time.time() * 1000))')"

# The prompt goes in on stdin, which run takes as the message: no argv carries it, and no length
# limit applies to it.
OPENCODE_PASSWORD="$(<"$PW_FILE")" cs-opencode run --server "$BASE" -s "$SES_ID" --auto \
    < "$PROMPT_FILE" > "$OUT_FILE" 2> "$ERR_FILE" &
RUN_PID=$!

# TIMEOUT=0 waits indefinitely; the idle stall watchdog remains the liveness check.
deadline=$(( SECONDS + TIMEOUT ))
idle_since=""
while kill -0 "$RUN_PID" 2>/dev/null; do
    if (( TIMEOUT > 0 && SECONDS >= deadline )); then
        kill "$RUN_PID" 2>/dev/null; wait "$RUN_PID" 2>/dev/null
        err "turn did not complete within ${TIMEOUT}s"; exit 2
    fi
    if ! server_alive; then
        kill "$RUN_PID" 2>/dev/null; wait "$RUN_PID" 2>/dev/null
        err "opencode server died mid-turn"; exit 3
    fi
    if (( STALL_SECS > 0 )); then
        if session_busy; then
            idle_since=""
        else
            [[ -z "$idle_since" ]] && idle_since=$SECONDS
            if (( SECONDS - idle_since >= STALL_SECS )); then
                kill "$RUN_PID" 2>/dev/null; wait "$RUN_PID" 2>/dev/null
                err "turn stalled: session idle for $(( SECONDS - idle_since ))s but the attached run never returned"
                err "  attach to inspect: tmux attach -t $TMUX_SESSION"
                exit 2
            fi
        fi
    fi
    sleep 2
done
wait "$RUN_PID"; RC=$?

# Verdict + output extraction, from ONE read of the turn's messages.
#
# The verdict is the turn's own `idle` message. A session the provider refused records the error
# there and on the assistant message, and checking the session's last idle message instead of
# this turn's would pass on the PREVIOUS turn's success whenever this turn recorded nothing.
#
# Both the verdict and the output come from the same read, so they cannot disagree about what the
# turn produced (two reads could straddle a concurrent write). The read pages newest first until
# it reaches the anchor, so a turn of any length is read whole.
RESULT_FILE="$(mktemp "${TMPDIR:-/tmp}/cs-opencode-result.XXXXXX")"
CHECK_ERR="$(mktemp "${TMPDIR:-/tmp}/cs-opencode-check.XXXXXX")"
trap 'rc=$?; rm -f "$PROMPT_FILE" "$OUT_FILE" "$ERR_FILE" "$RESULT_FILE" "$CHECK_ERR"; record_turn_end "$rc"' EXIT
verdict() {
    python3 - "$BASE" "$SES_ID" "$ANCHOR_ID" "$TURN_START_MS" "$FORMAT" "$CURLRC" <<'PY' > "$RESULT_FILE" 2> "$CHECK_ERR"
import json, math, subprocess, sys, urllib.parse

base, sid, anchor, start_ms, fmt, curlrc = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4]), sys.argv[5], sys.argv[6]

def fail(reason):
    sys.stderr.write(reason + "\n")
    sys.exit(1)

def page(query):
    r = subprocess.run(["curl", "-fsS", "--noproxy", "*", "-K", curlrc, "-m", "10",
                        f"{base}/api/session/{sid}/message?{query}"], capture_output=True, text=True)
    if r.returncode != 0:
        fail("unreadable")
    try:
        doc = json.loads(r.stdout)
    except Exception:
        fail("unreadable")
    return doc if isinstance(doc, dict) else {}

# Newest first, back to the anchor. If the anchor is not met, creation time bounds the turn.
newest, found, query = [], False, "order=desc&limit=200"
for _ in range(500):
    doc = page(query)
    data = doc.get("data") or []
    for m in data:
        if anchor and isinstance(m, dict) and m.get("id") == anchor:
            found = True
            break
        newest.append(m if isinstance(m, dict) else {})
    nxt = (doc.get("cursor") or {}).get("next")
    if found or not data or not nxt:
        break
    query = "limit=200&cursor=" + urllib.parse.quote(nxt, safe="")
if anchor and not found:
    newest = [m for m in newest if (m.get("time") or {}).get("created", 0) >= start_ms]
new = newest[::-1]

def emit():
    if fmt == "json":
        json.dump(new, sys.stdout, indent=None)
        sys.stdout.write("\n")
        return
    chunks = []
    for m in new:
        if m.get("type") != "assistant":
            continue
        for c in m.get("content") or []:
            if isinstance(c, dict) and c.get("type") == "text":
                t = (c.get("text") or "").rstrip()
                if t:
                    chunks.append(t)
    print("\n\n".join(chunks))

idle = None
for m in new:
    if m.get("type") == "idle":
        idle = m
if idle is None:
    fail("no-outcome-this-turn")
outcome = idle.get("outcome")
if outcome == "succeeded":
    emit()
    sys.exit(0)
# The turn text still goes out, for the one failure the driver reports as a success: an
# interrupt that was the context hook ending a turn that had handed off.
emit()
e = idle.get("error")
if not isinstance(e, dict):
    for m in new:
        if m.get("type") == "assistant" and isinstance(m.get("error"), dict):
            e = m["error"]
e = e if isinstance(e, dict) else {}
kind, msg, status = str(e.get("type") or outcome), str(e.get("message") or ""), e.get("status")
# The class a caller acts on, as cs-codex-turn and cs-claude-turn print it. opencode names the
# kind of refusal and keeps the provider's HTTP status, so the class comes from those first and
# from the message only when both are silent.
low = (kind + " " + msg).lower()
limits = ("provider.rate-limit", "provider.quota", "provider.free-limit", "provider.budget-limit",
          "provider.model-budget-limit", "provider.go-limit", "provider.chatgpt-limit")
if "cs-sandbox token budget spent" in low:
    # The lender refused the call because this sandbox has used a hard token budget. It answers
    # with a 400, which a malformed request gets too, and OpenCode may file it under any kind,
    # its own provider.budget-limit among them, which the tuple above reads as a throttle. So
    # the marker in the message is read first, before the kind and the status.
    cls = "spent"
elif kind in limits or status == 429 or "rate limit" in low or "too many requests" in low:
    cls = "throttled"
elif kind == "provider.internal" or status in (500, 502, 503, 529) or "overloaded" in low or "at capacity" in low:
    cls = "capacity"
elif kind == "provider.auth" or status in (401, 403) or "incorrect api key" in low or "invalid api key" in low:
    cls = "unauthorized"
elif "context" in low and ("length" in low or "window" in low or "too long" in low or "exceed" in low):
    cls = "context"
elif status is None and (kind in ("provider.transport", "provider.timeout") or any(
        w in low for w in ("unable to connect", "connection", "fetch failed", "econnrefused",
                           "enotfound", "etimedout", "timed out", "socket"))):
    # No provider answered at all, so a caller waits it out as it does a throttle.
    cls = "unreachable"
else:
    cls = "other"
wait = "-"
ms = e.get("retryAfterMs")
if isinstance(ms, (int, float)) and ms >= 0:
    wait = str(math.ceil(ms / 1000))
sys.stderr.write(f"outcome:{outcome}:{kind}:{msg[:200]}\n")
sys.stderr.write(f"class={cls} retry_after={wait}\n")
sys.exit(1)
PY
}
# run returns once the server reports the session idle, and the idle message is written as the
# session stops; a read that finds none is retried briefly before it counts.
for try in 1 2 3; do
    verdict && { CHECK_RC=0; break; }
    CHECK_RC=1
    # Only a read that found no outcome, while the session is idle, is worth another look.
    [[ "$(sed -n 1p "$CHECK_ERR")" == no-outcome-this-turn ]] && (( try < 3 )) && ! session_busy || break
    sleep 1
done
if (( CHECK_RC != 0 )); then
    CHECK_FIRST="$(sed -n 1p "$CHECK_ERR")"
    # An interrupt can be the context hook's own hard stop: after the handoff is written and the
    # agent keeps making tool calls, the plugin interrupts the session, and opencode records the
    # turn's outcome as interrupted. When the hook asked in this session and this turn and the
    # handoff file is newer than the ask, the turn is a hand-off the hook ended, and is reported as
    # one: class spent when the budget asked, as below. An interrupt with no fresh handoff stays a
    # failed turn.
    if [[ "$CHECK_FIRST" == outcome:interrupted:* ]]; then
        ended=""
        if t="$(spent_end)"; then
            ended="spent"
            err "handoff on the token budget: $t; the operator raises it on the host; the hook ended the turn"
        elif t="$(handoff_end)"; then
            ended="handoff"
            err "handoff at $t tokens, over the line of $CS_HANDOFF_TOKENS; the hook ended the turn"
        fi
        if [[ -n "$ended" ]]; then
            TURN_CLASS="$ended"
            cat "$RESULT_FILE"
            printf '\n__CS_OPENCODE_SESSION_ID__ %s\n' "$SES_ID"
            exit 0
        fi
    fi
    # Nothing this turn reached the session: the client itself failed, and its stderr says why.
    if [[ "$CHECK_FIRST" != outcome:* ]] && (( RC != 0 )); then
        err "turn failed (opencode run exit $RC)"
        sed 's/^/  /' "$ERR_FILE" >&2
        exit 5
    fi
    err "turn failed — session postcheck: $(printf '%s' "$CHECK_FIRST" | head -c 300)"
    # A provider's refusal carries a class line, as the other two drivers print it.
    CLASS_LINE="$(sed -n '2{/^class=/p}' "$CHECK_ERR")"
    [[ -n "$CLASS_LINE" ]] && err "failure $CLASS_LINE"
    exit 5
fi

# A turn the agent ended by handing off, as the context hook asked it to in this session and
# this turn, is reported as one: exit 0, class handoff. One that ended on the budget's ask is
# class spent, even when the context line asked in the same turn too: the budget holds back the
# next turn, and a fresh session started on the handoff would not be sent its prompt either. A
# refused turn never reaches here.
if t="$(spent_end)"; then
    TURN_CLASS="spent"
    err "handoff on the token budget: $t; the operator raises it on the host"
elif t="$(handoff_end)"; then
    TURN_CLASS="handoff"
    err "handoff at $t tokens, over the line of $CS_HANDOFF_TOKENS"
fi

cat "$RESULT_FILE"
printf '\n__CS_OPENCODE_SESSION_ID__ %s\n' "$SES_ID"
exit 0
