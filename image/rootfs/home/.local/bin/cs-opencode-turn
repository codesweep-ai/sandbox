#!/bin/bash
# Remote-side driver for OpenCode remote delegation (server model — the opencode counterpart of
# cs-codex-turn). Runs ON the remote machine. Drives one conversational turn against an
# INTERACTIVE opencode TUI kept warm in a long-running tmux session, over the HTTP API the TUI
# hosts when launched with --port — never by scraping the tmux pane (opencode's TUI strings are
# localized and unstable; the API is deterministic).
#
# One turn =
#   1. ensure the warm TUI exists: it is the only server on the derived port, and a new session is
#      minted on its own API (POST /session) and then selected in it (POST /tui/select-session), so
#      a human attaching sees the driven session render live;
#   2. readiness = GET /global/health on the TUI's port (no pane scraping);
#   3. drive the turn with a blocking `cs-opencode run --attach http://127.0.0.1:<p> -s <id>
#      --auto "<prompt>"`, watching GET /session/status for stalls (absent key = idle);
#   4. on exit 0, UNCONDITIONALLY postcheck THIS TURN's last assistant message via
#      GET /session/<id>/message: an `error` or a missing `time.completed` means the turn failed
#      even though the attached client exited 0 (provider-side API errors are recorded on the
#      session but not propagated to the attached client's exit code — verified at 1.18.10).
#
# The turn is delimited by the ID of the last message that existed before it, never by a message
# COUNT: compaction rewrites the history and inserts summary messages, so positions are not stable
# and a positional cursor would silently return the wrong slice. `id` and `time.created` are both
# required fields on every message, giving a primary and a fallback anchor.
#
# The port is derived deterministically from the tmux token. The session id is emitted as a
# trailing sentinel the local cs-opencode-remote maps to the session name (and strips):
#   __CS_OPENCODE_SESSION_ID__ <ses_id>
#
# Usage: echo "prompt" | cs-opencode-turn --tmux <token> [--uuid <ses_id>] [--workdir <dir>] \
#            [--format text|json] [--timeout <secs>] [--name <label>]
# Exit codes: 0 ok, 2 turn timed out/stalled, 3 launch/setup failure, 5 turn failed (client error
# or a provider error recorded on the session), 1 usage. 5 rather than 4 because cs-opencode-remote
# already spends 4 on "session busy" (its per-session turn lock), as the claude/codex tools do.

set -uo pipefail

TOKEN=""; SES_ID=""; WORKDIR=""; FORMAT="text"; TIMEOUT="${CS_OPENCODE_TIMEOUT:-1800}"; LABEL=""
# Stall watchdog: bail early if the server reports the session idle for this long while the
# attached run client still has not returned. 0 disables. Env-overridable.
STALL_SECS="${CS_OPENCODE_STALL_SECS:-180}"
err() { echo "cs-opencode-turn: $*" >&2; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --tmux)    TOKEN="$2"; shift 2 ;;
        --uuid)    SES_ID="$2"; shift 2 ;;
        --workdir) WORKDIR="$2"; shift 2 ;;
        --format)  FORMAT="$2"; shift 2 ;;
        --timeout) TIMEOUT="$2"; shift 2 ;;
        --name)    LABEL="$2"; shift 2 ;;
        -h|--help) sed -n '2,34p' "$0"; exit 0 ;;
        *) err "unknown argument: $1"; exit 1 ;;
    esac
done

[[ -n "$TOKEN" ]] || { err "--tmux <token> is required"; exit 1; }
[[ "$TOKEN" =~ ^[A-Za-z0-9_-]+$ ]] || { err "--tmux token '$TOKEN' has invalid characters"; exit 1; }
if [[ -n "$SES_ID" ]] && ! [[ "$SES_ID" =~ ^ses_[A-Za-z0-9]{20,40}$ ]]; then
    err "--uuid '$SES_ID' is not a valid opencode session id"; exit 1
fi
# TIMEOUT reaches here from --timeout or the env default, and 0 legitimately means
# "wait indefinitely". Bash arithmetic reads a non-numeric value as 0, so without
# this check a typo would not fail — it would silently remove the budget and wait
# forever, which is the failure this driver's watchdogs exist to make impossible.
[[ "$TIMEOUT" =~ ^[0-9]+$ ]] || { err "--timeout '$TIMEOUT' must be a non-negative integer (0 = no limit)"; exit 1; }
# cs-opencode (not bare opencode) is what this driver runs: it is the wrapper that binds the
# isolated ~/.cs-opencode profile, so a turn driven without it would use the wrong config/db.
for bin in opencode cs-opencode tmux curl python3; do
    command -v "$bin" >/dev/null 2>&1 || { err "$bin not found on remote PATH"; exit 3; }
done

# A working directory that does not exist is not one to run in. opencode binds a session to the
# directory it is given and then fails on every prompt with a path error, so the fallback is chosen
# here and said out loud rather than left to whichever component noticed first.
if [[ -n "$WORKDIR" && ! -d "$WORKDIR" ]]; then
    err "working directory '$WORKDIR' does not exist; running in $HOME instead"
    WORKDIR=""
fi

TMUX_SESSION="cs-opencode-$TOKEN"
# Deterministic per-token port in 21000-25095: both the TUI and later resumes of the same token
# derive the same value, so nothing needs to be persisted.
PORT=$(( 21000 + 16#$(printf '%s' "$TOKEN" | md5sum | cut -c1-3) ))
BASE="http://127.0.0.1:$PORT"

PROMPT_FILE="$(mktemp "${TMPDIR:-/tmp}/cs-opencode-turn.XXXXXX")"
OUT_FILE="$(mktemp "${TMPDIR:-/tmp}/cs-opencode-out.XXXXXX")"
ERR_FILE="$(mktemp "${TMPDIR:-/tmp}/cs-opencode-err.XXXXXX")"
trap 'rm -f "$PROMPT_FILE" "$OUT_FILE" "$ERR_FILE"' EXIT
cat > "$PROMPT_FILE"
[[ -s "$PROMPT_FILE" ]] || { err "empty prompt on stdin"; exit 1; }

# --- helpers --------------------------------------------------------------

session_alive() { tmux has-session -t "$TMUX_SESSION" 2>/dev/null; }
healthy() { curl -fsS -m 2 "$BASE/global/health" >/dev/null 2>&1; }

wait_healthy() {
    local deadline=$(( SECONDS + ${1:-60} ))
    while (( SECONDS < deadline )); do healthy && return 0; sleep 0.5; done
    return 1
}

# The server deletes a session's /session/status entry when it goes idle: present key = busy.
session_busy() {
    curl -fsS -m 5 "$BASE/session/status" 2>/dev/null \
        | python3 -c 'import json,sys; d=json.load(sys.stdin); sys.exit(0 if sys.argv[1] in d else 1)' "$SES_ID" 2>/dev/null
}

# Guard against a foreign server squatting the derived port (hash collision with another token's
# TUI): our session id must be resolvable on this server.
session_known() { curl -fsS -m 5 "$BASE/session/$SES_ID" >/dev/null 2>&1; }

# The pid listening on the derived port, or empty. ss names the socket's owner, which is the one
# process a kill has to reach; matching the command line instead would also match the tmux process
# whose argv carries the same port.
port_pid() { ss -lptnH "sport = :$PORT" 2>/dev/null | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2; }

# Whether a DIFFERENT live token derives this same port. The port is a hash of the token, so two
# sessions in one sandbox can collide; that server belongs to its own session and reclaiming it
# would kill somebody else's warm TUI.
port_owned_by_other_token() {
    local session token
    while read -r session; do
        [[ -z "$session" || "$session" == "$TMUX_SESSION" ]] && continue
        token="${session#cs-opencode-}"
        (( 21000 + 16#$(printf '%s' "$token" | md5sum | cut -c1-3) == PORT )) && return 0
    done < <(tmux list-sessions -F '#S' 2>/dev/null | grep '^cs-opencode-')
    return 1
}

# Take the derived port back from a server that no tmux session stands behind.
#
# Such a server is a turn that died before it could clean up. It answers every health check below
# while the TUI it shadows renders nothing, so the driver would attach to it, run the turn in
# whatever directory it was started in, and leave the human attaching to a blank pane. Nothing else
# clears it either: a restart kills the tmux session, and this process is not in one.
#
# The port belongs to this token, so anything else holding it is stale by construction — except a
# colliding token, which is checked first. The effect is what is verified, not the signal: the
# health check is the test, and SIGKILL follows SIGTERM.
reclaim_port() {
    healthy || return 0
    session_alive && return 0
    if port_owned_by_other_token; then
        err "port $PORT is held by another cs-opencode session whose token hashes to it"
        err "  rename this session so its token derives a different port"
        return 3
    fi
    local pid; pid="$(port_pid)"
    err "reclaiming port $PORT from a leftover opencode server (pid ${pid:-unknown})"
    if [[ -n "$pid" ]]; then kill "$pid" 2>/dev/null; else pkill -f "opencode serve --port $PORT" 2>/dev/null; fi
    for _ in $(seq 1 40); do healthy || return 0; sleep 0.25; done
    [[ -n "$pid" ]] && kill -9 "$pid" 2>/dev/null
    for _ in $(seq 1 20); do healthy || return 0; sleep 0.25; done
    err "port $PORT is still answering after SIGKILL; cannot start a turn on it"
    return 3
}

# Ensure the warm TUI is up, healthy, and rendering OUR session.
#
# One server, and the TUI is it. A new session is minted on the TUI's own API and the TUI is then
# navigated to it, so nothing else ever binds this port: a second server would have to be started,
# killed and waited for, and a turn that died in that window left it running to shadow every turn
# after it.
ensure_session() {
    if session_alive; then
        if ! wait_healthy 30; then
            err "tmux session '$TMUX_SESSION' is alive but its server is not healthy on port $PORT"
            err "  attach to inspect: tmux attach -t $TMUX_SESSION"
            return 3
        fi
        if [[ -n "$SES_ID" ]]; then
            session_known || { err "server on port $PORT does not know session $SES_ID (port collision or wrong profile)"; return 3; }
            return 0
        fi
        # Warm TUI but no recorded session id: the first turn never completed. Start over so the
        # TUI is bound to the id we are about to drive.
        tmux kill-session -t "$TMUX_SESSION" 2>/dev/null
    fi
    reclaim_port || return 3
    local newargs=(new-session -d -s "$TMUX_SESSION" -x 220 -y 50)
    [[ -n "$WORKDIR" ]] && newargs+=(-c "$WORKDIR")
    # -s only when the id is known. A bare launch is the new-session case, where the session does
    # not exist yet and there is nothing for the TUI to render until it is selected below.
    if [[ -n "$SES_ID" ]]; then
        newargs+=("cs-opencode --port $PORT -s $SES_ID")
    else
        newargs+=("cs-opencode --port $PORT")
    fi
    tmux "${newargs[@]}" || { err "failed to start tmux session"; return 3; }
    if ! wait_healthy 90; then
        session_alive || { err "opencode TUI exited during startup (port $PORT in use, or launch failure)"; return 3; }
        err "opencode TUI never became healthy on port $PORT"; return 3
    fi
    if [[ -z "$SES_ID" ]]; then
        # The session is bound to the directory named here rather than to the server's cwd, so the
        # turn runs where the caller asked even if the TUI was started somewhere else.
        SES_ID="$(curl -fsS -m 10 -X POST "$BASE/session?directory=${WORKDIR:-$PWD}" \
            -H 'content-type: application/json' -d '{}' 2>/dev/null \
            | python3 -c 'import json,sys; print(json.load(sys.stdin).get("id",""))' 2>/dev/null)"
        [[ "$SES_ID" =~ ^ses_[A-Za-z0-9]{20,40}$ ]] || { err "could not create an opencode session (got '$SES_ID')"; return 3; }
        # Navigate the TUI to it, so a human attaching sees the driven turn rather than the home
        # screen. The turn itself is driven over the API and does not depend on this.
        curl -fsS -m 10 -X POST "$BASE/tui/select-session" -H 'content-type: application/json' \
            -d "{\"sessionID\":\"$SES_ID\"}" >/dev/null 2>&1 \
            || err "note: the TUI did not navigate to $SES_ID; the turn still runs"
    fi
    session_known || { err "TUI server does not know session $SES_ID"; return 3; }
    return 0
}

# --- run one turn ---------------------------------------------------------

ensure_session || exit $?

# Anchor this turn in the session's history before submitting: the turn's output is read back
# from the session API afterwards (an attached run client renders into the TUI, not onto its own
# stdout). The anchor is the id of the last existing message, NOT a message COUNT — the history is
# not append-only, because compaction rewrites it and inserts summary messages (`summary: true` on
# AssistantMessage). A positional cursor silently returns the wrong slice the moment that happens.
# `id` is a required field on every message, so the anchor is always available.
#
# TURN_START_MS is the secondary anchor for the case where compaction removed the anchor message
# itself while we were running: `time.created` is a required epoch-ms field, so "messages created
# since the turn began" still delimits the turn.
ANCHOR_ID="$(curl -fsS -m 10 "$BASE/session/$SES_ID/message" 2>/dev/null | python3 -c '
import json, sys
try:
    msgs = json.load(sys.stdin)
    info = msgs[-1].get("info") or {} if isinstance(msgs, list) and msgs else {}
    print(info.get("id") or "")
except Exception:
    print("")
' 2>/dev/null)"
TURN_START_MS="$(python3 -c 'import time; print(int(time.time() * 1000))')"

RUN_ARGS=(run --attach "$BASE" -s "$SES_ID" --auto)

cs-opencode "${RUN_ARGS[@]}" "$(cat "$PROMPT_FILE")" > "$OUT_FILE" 2> "$ERR_FILE" &
RUN_PID=$!

# TIMEOUT=0 waits indefinitely; the idle stall watchdog remains the liveness check.
deadline=$(( SECONDS + TIMEOUT ))
idle_since=""
while kill -0 "$RUN_PID" 2>/dev/null; do
    if (( TIMEOUT > 0 && SECONDS >= deadline )); then
        kill "$RUN_PID" 2>/dev/null; wait "$RUN_PID" 2>/dev/null
        err "turn did not complete within ${TIMEOUT}s"; exit 2
    fi
    if ! session_alive; then
        kill "$RUN_PID" 2>/dev/null; wait "$RUN_PID" 2>/dev/null
        err "tmux session died mid-turn"; exit 3
    fi
    if (( STALL_SECS > 0 )); then
        if session_busy; then
            idle_since=""
        else
            [[ -z "$idle_since" ]] && idle_since=$SECONDS
            if (( SECONDS - idle_since >= STALL_SECS )); then
                kill "$RUN_PID" 2>/dev/null; wait "$RUN_PID" 2>/dev/null
                err "turn stalled: session idle for $(( SECONDS - idle_since ))s but the attached run never returned"
                err "  attach to inspect: tmux attach -t $TMUX_SESSION"
                exit 2
            fi
        fi
    fi
    sleep 2
done
wait "$RUN_PID"; RC=$?

if (( RC != 0 )); then
    err "turn failed (opencode run exit $RC)"
    sed 's/^/  /' "$ERR_FILE" >&2
    exit 5
fi

# Postcheck + output extraction, from ONE snapshot of the session history.
#
# The postcheck is REQUIRED even on exit 0: provider-side API errors surface only on the session's
# assistant message (error set / time.completed absent), never on the attached client. It is scoped
# to THIS turn's messages — checking the session's last assistant message instead would pass on the
# PREVIOUS turn's reply whenever this turn produced nothing, reporting a silent empty success.
#
# Both the check and the output come from the same fetch, so they cannot disagree about what the
# turn produced (two fetches could straddle a concurrent write).
TURN_JSON="$(curl -fsS -m 10 "$BASE/session/$SES_ID/message" 2>/dev/null)"
RESULT_FILE="$(mktemp "${TMPDIR:-/tmp}/cs-opencode-result.XXXXXX")"
CHECK_ERR="$(mktemp "${TMPDIR:-/tmp}/cs-opencode-check.XXXXXX")"
trap 'rm -f "$PROMPT_FILE" "$OUT_FILE" "$ERR_FILE" "$RESULT_FILE" "$CHECK_ERR"' EXIT
printf '%s' "$TURN_JSON" | python3 -c '
import json, sys

anchor, start_ms, fmt = sys.argv[1], int(sys.argv[2]), sys.argv[3]

def fail(reason):
    sys.stderr.write(reason + "\n")
    sys.exit(1)

try:
    msgs = json.load(sys.stdin)
except Exception:
    fail("unreadable")
if not isinstance(msgs, list):
    fail("unreadable")

def info_of(m):
    i = m.get("info") if isinstance(m, dict) else None
    return i if isinstance(i, dict) else {}

# Delimit this turn: everything after the anchor message. If the anchor is gone (compaction
# rewrote the history mid-turn) fall back to creation time, which bounds the turn just as well.
new, idx = [], -1
if anchor:
    for n, m in enumerate(msgs):
        if info_of(m).get("id") == anchor:
            idx = n
            break
if idx >= 0:
    new = msgs[idx + 1:]
elif anchor:
    new = [m for m in msgs if (info_of(m).get("time") or {}).get("created", 0) >= start_ms]
else:
    new = msgs  # empty session before the turn: everything is this turn

last = None
for m in new:
    if info_of(m).get("role") == "assistant":
        last = info_of(m)
if last is None:
    fail("no-assistant-message-this-turn")
if last.get("error"):
    e = last["error"]
    name = e.get("name", "error") if isinstance(e, dict) else "error"
    data = e.get("data", {}) if isinstance(e, dict) else {}
    msg = data.get("message", "") if isinstance(data, dict) else ""
    fail(f"error:{name}:{msg[:200]}")
if not (last.get("time") or {}).get("completed"):
    fail("incomplete")

if fmt == "json":
    json.dump(new, sys.stdout, indent=None)
    sys.stdout.write("\n")
    sys.exit(0)
chunks = []
for m in new:
    if info_of(m).get("role") != "assistant":
        continue
    for p in m.get("parts") or []:
        if isinstance(p, dict) and p.get("type") == "text":
            t = (p.get("text") or "").rstrip()
            if t:
                chunks.append(t)
print("\n\n".join(chunks))
' "$ANCHOR_ID" "$TURN_START_MS" "$FORMAT" > "$RESULT_FILE" 2> "$CHECK_ERR"
CHECK_RC=$?
if (( CHECK_RC != 0 )); then
    err "turn failed despite run exit 0 — session postcheck: $(tr -d '\n' < "$CHECK_ERR" | head -c 300)"
    exit 5
fi

cat "$RESULT_FILE"
printf '\n__CS_OPENCODE_SESSION_ID__ %s\n' "$SES_ID"
exit 0
