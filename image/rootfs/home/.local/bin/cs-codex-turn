#!/bin/bash
# Remote-side driver for Codex remote delegation (tmux model — mirrors cs-claude-turn).
# Runs ON the remote machine. Drives one conversational turn against an INTERACTIVE codex TUI
# kept warm in a long-running tmux session, and returns that turn's output by reading the codex
# session JSONL (the rollout file) — NOT by scraping the tmux pane (which is full of TUI/ANSI).
#
# One turn =
#   1. ensure the tmux session is alive (launch `cs-codex` for a new session, or
#      `cs-codex resume <uuid>` if it died and we know the codex session id), auto-clearing the
#      first-run trust prompt and refusing screens that need a human (sign-in);
#   2. paste the prompt (read from stdin) via tmux load-buffer + bracketed paste, submit Enter;
#   3. wait for the turn to finish by watching the rollout JSONL for a new task_complete event
#      ({"payload":{"type":"task_complete"}}) — codex's deterministic end-of-turn edge;
#   4. print the agent message(s) appended since the prompt was sent.
#
# codex assigns the session id itself (it can't be forced), so the tmux session is named by a
# stable local token (cs-codex-<token>) passed in by the caller, and the codex session id is
# captured from the new rollout file after the first turn and emitted as a trailing sentinel:
#   __CS_CODEX_SESSION_ID__ <uuid>
# which the local cs-codex-remote maps to the session name (and strips from the output).
#
# Usage: echo "prompt" | cs-codex-turn --tmux <token> [--uuid <uuid>] [--workdir <dir>] \
#            [--format text|json] [--timeout <secs>] [--name <label>]
#        cs-codex-turn --state [--tmux <token>]
#        cs-codex-turn --context [--uuid <uuid>]
#        cs-codex-turn --budget
#
# --state says whether codex is in a turn right now, whoever started the turn, and starts or
# wakes nothing. It prints one line and exits 0: busy, idle, blocked (a screen that needs a
# person), unknown (a screen this driver does not recognise) or absent (no session). busy may
# be followed by a second word, "busy retrying", while codex waits out a provider error. With
# no --tmux it answers for every codex session here: busy if any is, idle only if all are.
# It is the judgement the driver itself waits on, so the two cannot disagree.
#
# --context reads the session rollout and says how full the conversation is. It prints one line
# and exits 0: "tokens=<n|-> window=<n|-> compactions=<n> compacted=<epoch|-> model=<id|->", or
# "absent" when there is no rollout, or "unknown" when it cannot be read. tokens is the context the
# latest model call carried, and window is the usable window codex records, which is below the
# model's full window. With no --uuid it answers for the newest rollout. It starts nothing.
# --budget takes one reading of the sandbox's token budget (CS_METER_URL) and says whether a turn
# would be sent. It prints one line and exits 0: "ok", "ask <types>" when a type is at its ask
# line, the types by their bare names and comma-separated, "none" when no reading could be taken,
# or "off" when the sandbox has no meter. Like --state it starts nothing and writes nothing.
# cs-campaign asks it of a node held on a spent budget, so a raised budget is tried at once.
#
# Exit codes: 0 ok, 2 turn timed out/stalled, 3 launch/setup failure (e.g. needs sign-in), 5 turn
# failed (the provider ended it with an error, or the token budget kept it from being sent),
# 1 usage. 5 matches cs-opencode-turn, and stays clear of cs-codex-remote's 4 (session busy).
#
# A failed turn prints the provider's message on stderr, then one line a caller can parse:
#   cs-codex-turn: failure class=<throttled|capacity|unauthorized|context|unreachable|spent|other> retry_after=<secs|->
#
# spent is the sandbox's token budget, where the lender has a meter for it (CS_METER_URL). It
# ends a turn three ways: exit 5 when a type was already at its ask line and nothing was sent,
# exit 5 when the lender refused a call under a hard budget, and exit 0 when the agent handed
# off as the context hook asked it to on the budget.

set -uo pipefail

STATE_ONLY=false
CONTEXT_ONLY=false
BUDGET_ONLY=false
TOKEN=""; UUID=""; WORKDIR=""; FORMAT="text"; TIMEOUT="${CS_CODEX_TIMEOUT:-1800}"; LABEL=""
# Stall watchdog: bail early if the JSONL stops growing AND the TUI is no longer working before
# a task_complete appears. 0 disables. Env-overridable.
STALL_SECS="${CS_CODEX_STALL_SECS:-180}"
CODEX_DIR="$HOME/.cs-codex"
# The turn log. Every turn end appends one line here, on the machine the agent runs on, so a
# harness that asks this machine about this agent can learn how its last turn ended:
#   <epoch> <exit code> <class|-> <retry_after|-> <first line of the reason, or ->
# The class line below goes to whoever started the turn, and that may be another machine, or
# gone. One format serves every agent family. --state and a usage error are not turns and
# write nothing. A driver that is killed writes nothing either, so no line means not known.
# Writing is best effort: a full disk must not change how a turn is reported.
TURN_LOG="${CS_TURN_LOG:-$HOME/.cs-turns/codex.log}"
TURN_LOG_KEEP=200
TURN_CLASS="-"; TURN_RETRY="-"; TURN_MSG=""
err() {
    echo "cs-codex-turn: $*" >&2
    case "$*" in
        "failure class="*)
            TURN_CLASS="${*#failure class=}"; TURN_CLASS="${TURN_CLASS%% *}"
            TURN_RETRY="${*##*retry_after=}" ;;
        "turn failed"*) TURN_MSG="$*" ;;
        " "*) ;;
        *) [[ "$TURN_MSG" == "turn failed"* ]] || TURN_MSG="$*" ;;
    esac
}
record_turn_end() {
    local rc="$1" msg
    $STATE_ONLY && return 0
    (( rc == 1 )) && return 0
    msg="$(printf '%s' "${TURN_MSG:--}" | tr '\n\r\t' '   ' | cut -c1-300)"
    {
        mkdir -p "${TURN_LOG%/*}" &&
        printf '%s %s %s %s %s\n' "$(date +%s)" "$rc" "$TURN_CLASS" "$TURN_RETRY" "$msg" >> "$TURN_LOG" &&
        if (( $(wc -l < "$TURN_LOG") > TURN_LOG_KEEP * 2 )); then
            tail -n "$TURN_LOG_KEEP" "$TURN_LOG" > "$TURN_LOG.tmp" && mv "$TURN_LOG.tmp" "$TURN_LOG"
        fi
    } 2>/dev/null || true
    return 0
}
trap 'record_turn_end "$?"' EXIT

# The context hook (cs-context-hook) records in ~/.cs-turns when it asked the agent to hand
# off, and reads there which tmux session this driver drives. Both are read and written here
# and nowhere else in this driver.
HANDOFF_DIR="$HOME/.cs-turns"
TURN_START=0
# Set when this driver was started from inside the driven session (below).
NESTED=false
# asked_end <ask file> prints what the hook asked about when THIS turn ended because the agent
# handed off as it asked: the hook asked in the session this driver drives, during this turn,
# and the handoff file is newer than the ask. That is the tokens at a context ask (handoff-ask),
# or the types that ran out at a budget ask (budget-ask), each by its bare name with the figures
# the hook recorded. Anything else fails, and the turn is reported as whatever it was.
asked_end() {
    ! $NESTED && [[ -f "$HANDOFF_DIR/$1" ]] || return 1
    python3 - "$HANDOFF_DIR/$1" "$TMUX_SESSION" "$TURN_START" "${CS_HANDOFF_FILE:-$HANDOFF_DIR/handoff.md}" <<'PY'
import json, os, sys
def fmt(n):
    if not isinstance(n, (int, float)):
        return "?"
    for size, unit in ((1e9, "G"), (1e6, "M"), (1e3, "K")):
        if n >= size:
            return "%.2f%s" % (n / size, unit)
    return str(int(n))
try:
    ask = json.load(open(sys.argv[1]))
    at = float(ask.get("at") or 0)
    if ask.get("session") == sys.argv[2] and at >= float(sys.argv[3]) \
            and os.path.getmtime(os.path.expanduser(sys.argv[4])) >= at:
        if isinstance(ask.get("types"), list):
            used = ask.get("used") if isinstance(ask.get("used"), dict) else {}
            limits = ask.get("limits") if isinstance(ask.get("limits"), dict) else {}
            num = lambda v: isinstance(v, (int, float))
            print(", ".join("%s at %s of its %s limit" % (t, fmt(used[t]), fmt(limits[t]))
                            if num(used.get(t)) and num(limits.get(t)) else str(t)
                            for t in ask["types"]) or "-")
        else:
            print(ask.get("tokens", "-"))
        sys.exit(0)
except Exception:
    pass
sys.exit(1)
PY
}
# The turn ended on the context line's ask, or on the budget line's.
handoff_end() { [[ -n "${CS_HANDOFF_TOKENS:-}" && "${CS_HANDOFF_TOKENS}" != 0 ]] && asked_end handoff-ask; }
spent_end() { [[ -n "${CS_METER_URL:-}" ]] && asked_end budget-ask; }

# The token budget. A lent sandbox can carry CS_METER_URL, where the lender answers with this
# sandbox's token count and budget, and CS_METER_TOKEN, the loan the reading is made with. The
# lender sees every call the sandbox makes, so the count is the sandbox's, not this session's.
# Unset, the sandbox has no meter, and nothing about the budget runs.
#
# budget_check takes one reading and prints one line: "ask <what>" when a type is at its ask
# line, "none <why>" when there is no reading, and "ok" otherwise. <what> names each type that ran
# out by its bare name, input, cached or output, and no other: cs-campaign reads the type from
# the turn's reason, and a line that named all three would send it to the wrong one. A reading
# is a 200 within about 3 s whose body is the lender's JSON. Anything else is none, and the turn
# runs through it: under a soft budget, a lender that cannot answer must not stop the work.
budget_check() {
    python3 - <<'PY' 2>/dev/null || echo "none the reading could not be taken"
import json, os, urllib.error, urllib.request
def fmt(n):
    if not isinstance(n, (int, float)):
        return "?"
    for size, unit in ((1e9, "G"), (1e6, "M"), (1e3, "K")):
        if n >= size:
            return "%.2f%s" % (n / size, unit)
    return str(int(n))
req = urllib.request.Request(os.environ["CS_METER_URL"],
                             headers={"Authorization": "Bearer " + os.environ.get("CS_METER_TOKEN", "")})
try:
    with urllib.request.urlopen(req, timeout=3) as r:
        status, body = r.status, r.read()
except urllib.error.HTTPError as e:
    status, body = e.code, b""
except Exception as e:
    print("none %s" % (getattr(e, "reason", None) or e))
    raise SystemExit(0)
if status != 200:
    print("none the lender answered %s" % status)
    raise SystemExit(0)
try:
    doc = json.loads(body)
    limits, ask = doc["limits"], doc["ask"]
except Exception:
    doc, limits, ask = None, None, None
if not isinstance(limits, dict) or not isinstance(ask, list):
    print("none the answer is not a reading")
    raise SystemExit(0)
ask = [t for t in ask if isinstance(t, str)]
if not ask:
    print("ok")
    raise SystemExit(0)
used = doc.get("used") if isinstance(doc.get("used"), dict) else {}
spent = doc.get("spent") if isinstance(doc.get("spent"), list) else []
what = ", ".join("%s at %s of its %s limit" % (t, fmt(used.get(t)), fmt(limits.get(t))) for t in ask)
# Under a hard budget the ask line is below the limit, so a type can be asked about before it is spent.
state = "spent" if all(t in spent for t in ask) else "at its ask line"
if os.environ.get("BUDGET_PROBE") == "1":
    print("ask " + ",".join(ask))
    raise SystemExit(0)
print("ask token budget %s: %s; the operator raises it on the host" % (state, what))
PY
}
# handoff_fields is what --context adds to a reading when a line is set: the line, and
# floor=<tokens> when the hook found this session over the line on its first reading and so
# never asked (the line is below what a fresh session costs). Nothing when no line is set.
handoff_fields() {
    local h="${CS_HANDOFF_TOKENS:-}" floor="-"
    [[ -n "$h" && "$h" != 0 ]] || return 0
    if [[ -f "$HANDOFF_DIR/handoff-floor" ]]; then
        floor="$(python3 - "$HANDOFF_DIR/handoff-floor" "$UUID" <<'PY' 2>/dev/null
import json, sys
f = json.load(open(sys.argv[1]))
print(f.get("tokens", "-") if not sys.argv[2] or f.get("session") == sys.argv[2] else "-")
PY
)" || floor="-"
        [[ -n "$floor" ]] || floor="-"
    fi
    printf ' handoff=%s floor=%s' "$h" "$floor"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --tmux)    TOKEN="$2"; shift 2 ;;
        --uuid)    UUID="$2"; shift 2 ;;
        --workdir) WORKDIR="$2"; shift 2 ;;
        --format)  FORMAT="$2"; shift 2 ;;
        --timeout) TIMEOUT="$2"; shift 2 ;;
        --name)    LABEL="$2"; shift 2 ;;
        --state)   STATE_ONLY=true; shift ;;
        # --context is a question, not a turn, so it takes the same no-turn path as --state.
        --context) STATE_ONLY=true; CONTEXT_ONLY=true; shift ;;
        # --budget is a question too, and takes the same no-turn path.
        --budget)  STATE_ONLY=true; BUDGET_ONLY=true; shift ;;
        -h|--help) trap - EXIT; sed -n '2,49p' "$0"; exit 0 ;;
        *) err "unknown argument: $1"; exit 1 ;;
    esac
done

$STATE_ONLY || [[ -n "$TOKEN" ]] || { err "--tmux <token> is required"; exit 1; }
[[ -z "$TOKEN" || "$TOKEN" =~ ^[A-Za-z0-9_-]+$ ]] || { err "--tmux token '$TOKEN' has invalid characters"; exit 1; }
if [[ -n "$UUID" ]] && ! [[ "$UUID" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
    err "--uuid '$UUID' is not a valid uuid"; exit 1
fi

# --budget answers from one reading and goes no further: no session, no turn log, no tmux.
if $BUDGET_ONLY; then
    [[ -n "${CS_METER_URL:-}" ]] || { echo off; exit 0; }
    budget="$(BUDGET_PROBE=1 budget_check)"
    case "$budget" in
        ok|"ask "*) echo "$budget" ;;
        *) echo none ;;
    esac
    exit 0
fi
# TIMEOUT reaches here from --timeout or the env default, and 0 legitimately means
# "wait indefinitely". Bash arithmetic reads a non-numeric value as 0, so without
# this check a typo would not fail — it would silently remove the budget and wait
# forever, which is the failure this driver's watchdogs exist to make impossible.
[[ "$TIMEOUT" =~ ^[0-9]+$ ]] || { err "--timeout '$TIMEOUT' must be a non-negative integer (0 = no limit)"; exit 1; }
if ! $STATE_ONLY; then
    command -v codex >/dev/null 2>&1 || { err "codex not found on remote PATH"; exit 3; }
    command -v tmux  >/dev/null 2>&1 || { err "tmux not found on remote PATH"; exit 3; }
fi

export CODEX_HOME="$CODEX_DIR"
SESS="$CODEX_HOME/sessions"
TMUX_SESSION="cs-codex-$TOKEN"

if ! $STATE_ONLY; then
    PROMPT_FILE="$(mktemp "${TMPDIR:-/tmp}/cs-codex-turn.XXXXXX")"
    trap 'rc=$?; rm -f "$PROMPT_FILE"; record_turn_end "$rc"' EXIT
    cat > "$PROMPT_FILE"
    [[ -s "$PROMPT_FILE" ]] || { err "empty prompt on stdin"; exit 1; }
fi

# --- helpers --------------------------------------------------------------

# Locate the rollout JSONL for a codex session id (rollout-<ts>-<uuid>.jsonl), if it exists.
sess_file_for() { find "$SESS" -type f -name "*-$1.jsonl" 2>/dev/null | head -1; }

# Count completed turns = number of task_complete events in the rollout JSONL.
task_count() {
    local f="$1"; [[ -f "$f" ]] || { echo 0; return; }
    python3 - "$f" <<'PY'
import json, sys
n = 0
try:
    for line in open(sys.argv[1], encoding="utf-8", errors="replace"):
        line = line.strip()
        if not line: continue
        try: o = json.loads(line)
        except Exception: continue
        p = o.get("payload")
        if isinstance(p, dict) and p.get("type") == "task_complete":
            n += 1
except FileNotFoundError:
    pass
print(n)
PY
}

line_count() { local f="$1"; [[ -f "$f" ]] && wc -l < "$f" | tr -d ' ' || echo 0; }
newest_rollout() {
    find "$SESS" -type f -name '*.jsonl' -printf '%T@ %p\n' 2>/dev/null \
        | sort -nr | head -1 | cut -d' ' -f2-
}

pane() { tmux capture-pane -p -t "$TMUX_SESSION" 2>/dev/null; }

# The provider rejected the credential, and codex is retrying it anyway. codex keeps one retry
# count for every failure and spends it on a 401 as it would on a dropped stream, doubling its
# wait each time, so a key that can never work holds the turn for minutes. It writes nothing
# to the rollout while it waits. The pane is the only place that says why:
#   • Reconnecting... 3/10 (12s • esc to interrupt)
#     └ Unexpected status 401 Unauthorized: Incorrect API key provided …
# Only the bottom of the pane counts, so a refusal left in the scrollback by an earlier turn
# does not end this one. Prints the reason, or nothing.
auth_rejected() {
    local tail_; tail_="$(pane | sed -e 's/[[:space:]]*$//' -e '/^$/d' | tail -n 8)"
    grep -q "Reconnecting\.\.\." <<<"$tail_" || return 1
    grep -Eio "status 40[13][^,]*" <<<"$tail_" | head -1 | cut -c1-160
}
session_alive() { tmux has-session -t "$TMUX_SESSION" 2>/dev/null; }

# The bottom of the screen, where a dialog draws its choices. What the model wrote higher up
# is left out, so a numbered list in an answer is not read as a question. This and the
# helpers below read the screen they are given, or capture one: every judgement of one
# state has to be about one capture, since Codex can open a dialog between two (SBX-103).
pane_bottom() { printf '%s\n' "${1-$(pane)}" | sed -e 's/[[:space:]]*$//' -e '/^$/d' | tail -n 15; }

# Dialogs codex shows once, whose answer keeps what the caller configured, and the key that
# gives that answer. The driver answers them itself and carries on. One entry per line:
# <text it shows>|<key>.
KNOWN_DIALOGS=(
    # 0.157 offers a newer model when the configured one has a successor, as "Meet GPT-6
    # Sol". "2" is "Use existing model": the member keeps the model it was given, and codex
    # records the answer in config.toml so it does not ask again (SBX-085).
    "Use existing model|2"
)
# Codex ignores keys that arrive before its screen takes input, and on a busy host that can
# be seconds after a dialog is drawn. So a known dialog is answered again for this long
# before it is taken for one this driver does not know (SBX-090).
DIALOG_SECS="${CS_CODEX_DIALOG_SECS:-15}"

# Prints the entry for the known dialog on screen, or nothing.
known_dialog() {
    local bottom d; bottom="$(pane_bottom "$@")"
    for d in "${KNOWN_DIALOGS[@]}"; do
        [[ "$bottom" == *"${d%|*}"* ]] && { printf '%s\n' "$d"; return 0; }
    done
    return 1
}

# The screen's own words, on one line, for a message that has to say what a person is asked.
screen_text() { pane_bottom "$@" | tr -s ' \t' ' ' | sed 's/^ //' | paste -sd'|' - | sed 's/|/ | /g' | cut -c1-240; }

# Classify the current TUI screen from the pane. Order matters: blocking overlays (trust,
# sign-in) before the "working" indicator, before dialogs, before the ready status line.
detect_state() {
    local p; p="${1-$(pane)}"
    [[ -z "$p" ]] && { echo "unknown"; return; }
    case "$p" in
        *"Do you trust the contents of this directory"*)                 echo "trust_folder"; return ;;
        *"Sign in with ChatGPT"*|*"Welcome to Codex"*|*"Provide your own API key"*) echo "login"; return ;;
        *"esc to interrupt"*)                                            echo "working"; return ;;
    esac
    known_dialog "$p" >/dev/null && { echo "dialog"; return; }
    # A modal this driver has never seen. codex draws "enter/esc confirm" or "enter/esc
    # continue" under one, and that footer carries the " · " the ready check below keys on:
    # read as ready, the dialog had the prompt pasted into it and no turn ever started
    # (SBX-085). It waits for a person, so it is named rather than waited out.
    if pane_bottom "$p" | grep -Eqi "enter/esc (confirm|continue) ·"; then
        echo "prompt"; return
    fi
    # No blocking overlay and not working: ready once codex's status line is up. Match its
    # SHAPE, not any segment's text — the bottom-most non-blank row, carrying the separator
    # codex joins status segments with. Every segment varies: the model slug differs per
    # provider, the items are user-configurable, and the reasoning segment reads "default"
    # only while no effort is set, so keying on that left any member with an explicit
    # reasoning effort permanently un-ready.
    local last
    last="$(printf '%s\n' "$p" | sed -e 's/[[:space:]]*$//' -e '/^$/d' | tail -n 1)"
    case "$last" in
        *" · "*) echo "ready"; return ;;
    esac
    echo "unknown"
}

# Wait until the TUI is ready to accept input. Auto-clears the first-run trust prompt; fails fast
# on a sign-in screen (needs a human).
wait_ready() {
    local deadline=$(( SECONDS + 60 )) st d scr answered=0 dialog_at=-1
    while (( SECONDS < deadline )); do
        session_alive || { err "tmux session died during startup"; return 3; }
        scr="$(pane)"
        st="$(detect_state "$scr")"
        case "$st" in
            trust_folder)
                # Option 1 ("Yes, continue") is preselected.
                tmux send-keys -t "$TMUX_SESSION" Enter; sleep 1 ;;
            login)
                err "remote codex needs interactive sign-in — cannot proceed unattended"
                err "  sign in on the remote: 'cs-codex login' (or 'cs-sandbox codex-login <name>')"
                return 3 ;;
            dialog)
                # A dialog still up after DIALOG_SECS of answers is not the one this driver knows.
                d="$(known_dialog "$scr")"
                (( dialog_at >= 0 )) || dialog_at=$SECONDS
                if (( SECONDS - dialog_at >= DIALOG_SECS )); then
                    err "remote codex is on a screen that needs a person: $(screen_text "$scr")"
                    err "  attach to answer it: tmux attach -t $TMUX_SESSION"
                    return 3
                fi
                tmux send-keys -t "$TMUX_SESSION" "${d##*|}"
                if (( answered++ == 0 )); then err "answered a dialog: ${d%|*}"; fi
                sleep 1 ;;
            prompt)
                err "remote codex is on a screen that needs a person: $(screen_text "$scr")"
                err "  attach to answer it: tmux attach -t $TMUX_SESSION"
                return 3 ;;
            ready)
                return 0 ;;
            working|unknown|*)
                sleep 0.5 ;;
        esac
    done
    err "timed out waiting for the codex TUI to become ready (last state: $(detect_state))"
    return 3
}

# Launch (or relaunch) the warm tmux session if it is not alive. New session = `cs-codex`;
# known prior session = `cs-codex resume <uuid>`. The permission mode is INHERITED from the target
# host's cs-codex wrapper (its ~/.cs-codex/.yolo marker / CS_CODEX_YOLO) — we do NOT force it here,
# mirroring cs-claude-turn. A non-yolo target can wedge on an approval prompt a headless TUI cannot
# answer; that surfaces as the ready-timeout (exit 3) → attach, or set .yolo on that host.
ensure_session() {
    session_alive && return 0
    local launch="cs-codex"
    if [[ -n "$UUID" && -n "$(sess_file_for "$UUID")" ]]; then
        launch="cs-codex resume $UUID"
    fi
    local newargs=(new-session -d -s "$TMUX_SESSION" -x 220 -y 50)
    [[ -n "$WORKDIR" ]] && newargs+=(-c "$WORKDIR")
    newargs+=("$launch")
    tmux "${newargs[@]}" || { err "failed to start tmux session ($launch)"; return 3; }
    wait_ready
}

# The state of one session in a caller's words. It is detect_state and nothing else, so a
# screen the driver learns to read is one this answers for too.
state_word() {
    case "$(detect_state)" in
        working)
            if pane | grep -q "Reconnecting\.\.\."; then echo "busy retrying"; else echo busy; fi ;;
        trust_folder|login|prompt) echo blocked ;;
        # A known one-time dialog is answered by the driver at the start of the next turn.
        ready|dialog)              echo idle ;;
        *)                  echo unknown ;;
    esac
}

# Several sessions of one family can be up in one sandbox. The answer is the one a caller
# must respect most: a turn anywhere is busy, and idle only when every session is.
state_rank() { case "${1%% *}" in busy) echo 4 ;; blocked) echo 3 ;; unknown) echo 2 ;; idle) echo 1 ;; *) echo 0 ;; esac; }

if $CONTEXT_ONLY; then
    rec="$(find "$SESS" -type f -name "rollout-*${UUID}.jsonl" -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -n 1 | cut -d' ' -f2-)"
    [[ -n "$rec" ]] || { echo absent; exit 0; }
    # A compaction writes a "compacted" line and replaces the history, so the reading is the
    # newest token_count after the newest compaction, and unknown until the first one.
    line="$(python3 - "$rec" <<'PY' 2>/dev/null
import json, sys
from datetime import datetime
tokens, window, comps, last, model = None, None, 0, None, None
for line in open(sys.argv[1], errors="replace"):
    if '"compacted"' not in line and '"token_count"' not in line and '"turn_context"' not in line:
        continue
    try:
        r = json.loads(line)
    except ValueError:
        continue
    t, p = r.get("type"), r.get("payload") or {}
    if t == "compacted":
        comps += 1
        last = r.get("timestamp")
        tokens = None
    elif t == "turn_context":
        model = p.get("model") or model
    elif t == "event_msg" and p.get("type") == "token_count" and p.get("info"):
        u = p["info"].get("last_token_usage") or {}
        tokens = (u.get("input_tokens") or 0) + (u.get("output_tokens") or 0)
        window = p["info"].get("model_context_window") or window
epoch = "-"
if last:
    epoch = str(int(datetime.fromisoformat(last.replace("Z", "+00:00")).timestamp()))
dash = lambda v: "-" if v is None else v
print(f"tokens={dash(tokens)} window={dash(window)} compactions={comps} compacted={epoch} model={model or '-'}")
PY
)" || line=unknown
    [[ -n "$line" ]] || line=unknown
    [[ "$line" == tokens=* ]] && line="$line$(handoff_fields)"
    echo "$line"
    exit 0
fi

if $STATE_ONLY; then
    names="cs-codex-$TOKEN"
    [[ -n "$TOKEN" ]] || names="$(tmux ls -F '#{session_name}' 2>/dev/null | grep '^cs-codex-' || true)"
    best=absent
    for TMUX_SESSION in $names; do
        session_alive || continue
        word="$(state_word)"
        (( $(state_rank "$word") > $(state_rank "$best") )) && best="$word"
    done
    echo "$best"; exit 0
fi

# --- run one turn ---------------------------------------------------------

# A driver the agent starts from inside the driven session runs with no line, and the hook's
# budget line never asks its session either. Left on, it would name its own session in
# ~/.cs-turns/driven, and the hook would then skip the one driven here. It still reads the budget
# before its turn, because the budget is the sandbox's and its calls spend it too.
# A TMUX_PANE in some other session changes nothing: a shell can carry one from elsewhere. A
# driver started over ssh has no pane, so cs-codex-remote passes the session it was run from as
# CS_PARENT_TMUX_SESSION.
# A nested driver writes its turn-log line to a log of its own, because the harness reads the
# last lines of the main log as the driven session's turns. The path is set before any turn
# could end, so even a failed start lands there.
if [[ -f "$HANDOFF_DIR/driven" ]] &&
    { [[ -n "${CS_HANDOFF_TOKENS:-}" && "${CS_HANDOFF_TOKENS}" != 0 ]] || [[ -n "${CS_METER_URL:-}" ]]; }; then
    driven_session=""; read -r driven_session < "$HANDOFF_DIR/driven" 2>/dev/null || true
    nested_in=""
    if [[ -n "${TMUX_PANE:-}" ]]; then
        pane_session="$(tmux display-message -p -t "$TMUX_PANE" '#S' 2>/dev/null)" || pane_session=""
        [[ -n "$pane_session" && "$pane_session" == "$driven_session" ]] && nested_in="$pane_session"
    fi
    if [[ -z "$nested_in" && -n "${CS_PARENT_TMUX_SESSION:-}" && "$CS_PARENT_TMUX_SESSION" == "$driven_session" ]]; then
        nested_in="$CS_PARENT_TMUX_SESSION"
    fi
    # Any wrapper breaks that lineage, such as a tmux session the agent starts for a batch, so
    # ownership counts too. The harness drives one session per machine, and ends the old one
    # before it starts the next. So while the session driven names is alive under another name,
    # this driver is one its agent started. A dead claim is a fresh start, and a resume has the
    # same name. The = makes tmux match that exact name, not a longer one that begins with it.
    if [[ -z "$nested_in" && -n "$driven_session" && "$driven_session" != "$TMUX_SESSION" ]] &&
        tmux has-session -t "=$driven_session" 2>/dev/null; then
        nested_in="$driven_session"
    fi
    if [[ -n "$nested_in" ]]; then
        err "started inside the driven session $nested_in: this one has no hand-off line"
        unset CS_HANDOFF_TOKENS CS_HANDOFF_FILE CS_HANDOFF_ASK
        NESTED=true
        [[ -n "${CS_TURN_LOG:-}" ]] || TURN_LOG="$HOME/.cs-turns/codex-nested.log"
    fi
fi

# A sandbox whose token budget is at its ask line sends nothing: no tokens are spent, and the
# session is left as it was, not even started or resumed. Only the operator can raise the
# budget, so the class says not to send again.
if [[ -n "${CS_METER_URL:-}" ]]; then
    budget="$(budget_check)"
    case "$budget" in
        "ask "*)
            err "turn not sent, ${budget#ask }"
            err "failure class=spent retry_after=-"
            exit 5 ;;
        "none "*) err "no reading of the token budget (${budget#none }); the turn runs without one" ;;
    esac
fi

# Snapshot rollouts before launching a missing TUI. The ready screen can appear
# a fraction before Codex creates its rollout, so selecting the globally newest
# file after startup can accidentally bind this turn to a previous session.
BEFORE_LAUNCH="$(find "$SESS" -type f -name '*.jsonl' 2>/dev/null | sort)"
WAS_ALIVE=false; session_alive && WAS_ALIVE=true
ensure_session || exit $?
wait_ready || exit $?

# Name the session this turn drives, for the context hook: a CLI session the agent starts
# itself is another one, and is never asked to hand off over this agent's file.
TURN_START="$(date +%s)"
if ! $NESTED && [[ -n "${CS_HANDOFF_TOKENS:-}${CS_METER_URL:-}" ]]; then
    { mkdir -p "$HANDOFF_DIR" && printf '%s\n' "$TMUX_SESSION" > "$HANDOFF_DIR/driven"; } 2>/dev/null || true
fi

# Snapshot which rollout files exist before submission. Older Codex versions
# create the file only after the first prompt, so the post-submit fallback below
# still compares against this set.
BEFORE="$(find "$SESS" -type f -name '*.jsonl' 2>/dev/null | sort)"
# If we already know this session's file, snapshot its turn/line counts for the wait below.
JSONL=""; PRE_TASKS=0; PRE_LINES=0
if [[ -n "$UUID" ]]; then
    JSONL="$(sess_file_for "$UUID")"
    PRE_TASKS="$(task_count "$JSONL")"; PRE_LINES="$(line_count "$JSONL")"
else
    # Current Codex creates the rollout at TUI startup. For a newly launched
    # session, wait for and select the file absent from the pre-launch snapshot.
    # Only an already-warm session without a recorded UUID uses newest_rollout.
    if ! $WAS_ALIVE; then
        for _ in $(seq 1 30); do
            AFTER_LAUNCH="$(find "$SESS" -type f -name '*.jsonl' 2>/dev/null | sort)"
            JSONL="$(comm -13 <(printf '%s\n' "$BEFORE_LAUNCH") <(printf '%s\n' "$AFTER_LAUNCH") | head -1)"
            [[ -n "$JSONL" ]] && break
            sleep 0.2
        done
    else
        JSONL="$(newest_rollout)"
    fi
    PRE_TASKS="$(task_count "$JSONL")"; PRE_LINES="$(line_count "$JSONL")"
fi

# Paste the prompt as one bracketed-paste block, then submit.
tmux load-buffer -b cs-codex-buf "$PROMPT_FILE"
tmux paste-buffer -p -d -b cs-codex-buf -t "$TMUX_SESSION"
sleep 0.4
tmux send-keys -t "$TMUX_SESSION" Enter

# Locate the rollout JSONL for this session: known one, or the file that appears post-submit.
if [[ -z "$JSONL" ]]; then
    for _ in $(seq 1 30); do
        AFTER="$(find "$SESS" -type f -name '*.jsonl' 2>/dev/null | sort)"
        JSONL="$(comm -13 <(printf '%s\n' "$BEFORE") <(printf '%s\n' "$AFTER") | head -1)"
        [[ -n "$JSONL" ]] && break
        sleep 0.5
    done
fi
if [[ -z "$JSONL" ]]; then
    # The first Enter is occasionally swallowed while the TUI finishes rendering the paste; retry.
    tmux send-keys -t "$TMUX_SESSION" Enter
    for _ in $(seq 1 20); do
        AFTER="$(find "$SESS" -type f -name '*.jsonl' 2>/dev/null | sort)"
        JSONL="$(comm -13 <(printf '%s\n' "$BEFORE") <(printf '%s\n' "$AFTER") | head -1)"
        [[ -n "$JSONL" ]] && break
        sleep 0.5
    done
fi
[[ -n "$JSONL" ]] || { err "could not locate the codex rollout JSONL after submitting"; exit 3; }

# Wait for a new task_complete (turn done), with a stall watchdog. TIMEOUT=0
# waits indefinitely; the stall watchdog remains the liveness check either way.
deadline=$(( SECONDS + TIMEOUT ))
completed=false; last_lines="$PRE_LINES"; last_change=$SECONDS
while (( TIMEOUT == 0 || SECONDS < deadline )); do
    session_alive || { err "tmux session died mid-turn"; exit 3; }
    # Waiting cannot fix a rejected credential, so the retries are cut short: Esc stops codex,
    # and the turn is reported for what it is rather than minutes later, or as a timeout.
    if why="$(auth_rejected)" && [[ -n "$why" ]]; then
        tmux send-keys -t "$TMUX_SESSION" Escape
        err "turn failed: the provider rejected the credential (${why})"
        err "failure class=unauthorized retry_after=-"
        sid="${UUID:-$(python3 -c 'import json,sys;print(json.loads(open(sys.argv[1]).readline())["payload"]["id"])' "$JSONL" 2>/dev/null)}"
        [[ -n "$sid" ]] && printf '\n__CS_CODEX_SESSION_ID__ %s\n' "$sid"
        exit 5
    fi
    if (( $(task_count "$JSONL") > PRE_TASKS )); then completed=true; break; fi
    if (( STALL_SECS > 0 )); then
        cur_lines="$(line_count "$JSONL")"
        if (( cur_lines != last_lines )); then
            last_lines="$cur_lines"; last_change=$SECONDS
        elif (( SECONDS - last_change >= STALL_SECS )); then
            st="$(detect_state)"
            if [[ "$st" != "working" ]]; then
                err "turn stalled: JSONL unchanged for $(( SECONDS - last_change ))s, TUI state '$st', no task_complete"
                err "  attach to inspect: tmux attach -t $TMUX_SESSION"
                exit 2
            fi
            last_change=$SECONDS
        fi
    fi
    sleep 1
done
$completed || { err "turn did not complete within ${TIMEOUT}s"; exit 2; }

# Determine the codex session id (for the local name->id map): from the rollout file we used.
OUT_UUID="$UUID"
[[ -z "$OUT_UUID" ]] && OUT_UUID="$(python3 -c 'import json,sys;print(json.loads(open(sys.argv[1]).readline())["payload"]["id"])' "$JSONL" 2>/dev/null)"

# task_complete is written for a turn the provider refused as well as for one the model
# finished, so its arrival is not success. A refused turn carries `error` on that event: the
# provider's message, and codex's own classification of it in codex_error_info. Counting the
# event without reading it reported a rate-limited turn as a completed one with an empty reply.
FAILURE="$(python3 - "$JSONL" "$PRE_LINES" <<'PY'
import json, re, sys
last = None
with open(sys.argv[1], encoding="utf-8", errors="replace") as fh:
    for line in fh.readlines()[int(sys.argv[2]):]:
        try: p = json.loads(line).get("payload")
        except Exception: continue
        if isinstance(p, dict) and p.get("type") == "task_complete":
            last = p
err = (last or {}).get("error")
if not err:
    sys.exit(0)
if not isinstance(err, dict):
    err = {"message": str(err)}
msg = " ".join(str(err.get("message") or "provider error").split())
# codex_error_info is a bare name, or {name: {detail}} when the kind carries an HTTP status.
info = err.get("codex_error_info"); kind = ""; status = None
if isinstance(info, dict) and info:
    kind, detail = next(iter(info.items()))
    if isinstance(detail, dict): status = detail.get("http_status_code")
elif isinstance(info, str):
    kind = info
low = msg.lower()
# An HTTP failure codex has no kind for arrives as "unexpected status 503 Service Unavailable: …".
if status is None:
    m = re.search(r"unexpected status (\d{3})", low)
    if m: status = int(m.group(1))
if "cs-sandbox token budget spent" in low:
    # The lender refused the call because this sandbox has used a hard token budget. Codex records
    # the lender's whole body as the message, with no status, so only the marker says so.
    cls = "spent"
elif kind in ("rate_limit_exceeded", "usage_limit_exceeded") or status == 429 or "rate limit" in low:
    cls = "throttled"
elif kind == "server_overloaded" or status in (502, 503, 529) or "at capacity" in low or "overloaded" in low:
    cls = "capacity"
elif kind == "unauthorized" or status in (401, 403):
    cls = "unauthorized"
elif kind == "context_window_exceeded" or "context window" in low or "context length" in low:
    cls = "context"
elif status is None and ("error sending request" in low or "stream disconnected" in low
                         or "connection" in low or "timed out" in low or "dns error" in low):
    # No provider answered at all: a network that is down, a proxy that is gone, a name
    # that does not resolve. A caller waits this out as it does a throttle, where "other"
    # tells it to try again at once.
    cls = "unreachable"
else:
    cls = "other"
# The provider's own wait, when its message names one ("Please try again in 12.52s").
wait = "-"
m = re.search(r"try again in\s+([0-9.]+)\s*(ms|s)\b", low)
if m:
    secs = float(m.group(1)) / (1000.0 if m.group(2) == "ms" else 1.0)
    wait = ("%.3f" % secs).rstrip("0").rstrip(".")
print(msg[:500]); print("class=%s retry_after=%s" % (cls, wait))
PY
)"
if [[ -n "$FAILURE" ]]; then
    err "turn failed: $(sed -n 1p <<<"$FAILURE")"
    err "failure $(sed -n 2p <<<"$FAILURE")"
    # The session id still goes out: the TUI is alive, and the next turn resumes this session.
    [[ -n "$OUT_UUID" ]] && printf '\n__CS_CODEX_SESSION_ID__ %s\n' "$OUT_UUID"
    exit 5
fi

# A turn the agent ended by handing off, as the context hook asked it to in this session and
# this turn, is reported as one: exit 0, class handoff. One that ended on the budget's ask is
# class spent, even when the context line asked in the same turn too: the budget holds back the
# next turn, and a fresh session started on the handoff would not be sent its prompt either. A
# refused turn never reaches here.
if t="$(spent_end)"; then
    TURN_CLASS="spent"
    err "handoff on the token budget: $t; the operator raises it on the host"
elif t="$(handoff_end)"; then
    TURN_CLASS="handoff"
    err "handoff at $t tokens, over the line of $CS_HANDOFF_TOKENS"
fi

# Emit this turn's new content from the JSONL (lines appended after PRE_LINES).
python3 - "$JSONL" "$PRE_LINES" "$FORMAT" <<'PY'
import json, sys
path, pre_lines, fmt = sys.argv[1], int(sys.argv[2]), sys.argv[3]
with open(path, encoding="utf-8", errors="replace") as fh:
    lines = fh.readlines()
new = lines[pre_lines:]
if fmt == "json":
    sys.stdout.write("".join(new)); sys.exit(0)
# text: concatenate the agent's final-answer messages from this turn.
#
# Two shapes, because the rollout schema moved and this driver has to read both.
# Codex used to emit the answer as its own `agent_message` event carrying a
# plain string. 0.152 stopped: the answer now arrives as an ordinary rollout
# `response_item` -- an assistant message whose content array holds the
# output_text parts -- and the agent_message event is gone.
#
# Reading only the old shape does not fail, which is what makes it worth
# spelling out. task_complete is still written, so the turn is detected as
# finished, the driver exits 0, and it prints NOTHING. The caller sees a
# successful turn with an empty answer, and nothing anywhere says why.
chunks = []
for line in new:
    line = line.strip()
    if not line: continue
    try: o = json.loads(line)
    except Exception: continue
    p = o.get("payload")
    if not isinstance(p, dict): continue
    if p.get("type") == "agent_message":
        t = (p.get("message") or "").rstrip()
        if t: chunks.append(t)
        continue
    if p.get("type") == "message" and p.get("role") == "assistant":
        parts = [c.get("text") or "" for c in (p.get("content") or [])
                 if isinstance(c, dict) and c.get("type") == "output_text"]
        t = "".join(parts).rstrip()
        if t: chunks.append(t)
print("\n\n".join(chunks))
PY

[[ -n "$OUT_UUID" ]] && printf '\n__CS_CODEX_SESSION_ID__ %s\n' "$OUT_UUID"
exit 0
