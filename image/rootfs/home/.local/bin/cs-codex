#!/usr/bin/env bash
# Launch codex under the cs-codex profile (CODEX_HOME=~/.cs-codex) — the Codex counterpart
# of cs-claude. A dedicated profile keeps the sandbox's Codex config/auth isolated from any
# personal ~/.codex and lets us ship sane defaults (config.toml in the home skeleton).
#
# YOLO mode (no approvals, no sandbox) is enabled when CS_CODEX_YOLO is set in the
# environment or the marker file ~/.cs-codex/.yolo exists; cs-sandbox creates that marker for
# `--yolo` agent instances. YOLO uses `--dangerously-bypass-approvals-and-sandbox`, which is
# only safe because the instance is itself an isolated container/VM. Otherwise codex runs with
# the profile's defaults (approval_policy=on-request, sandbox_mode=workspace-write, from
# config.toml) — the analogue of cs-claude's `--permission-mode auto`.
CODEX_DIR="$HOME/.cs-codex"
mkdir -p "$CODEX_DIR" 2>/dev/null || true   # ensure the profile dir exists (first run / fresh host)
export CODEX_HOME="$CODEX_DIR"

# Provider auth (API key / custom provider), scoped to codex rather than the whole sandbox:
# anything you put in ~/.cs-codex/env (OPENAI_API_KEY, or a custom provider's env_key var) is
# sourced here. Nothing creates this file for you — write it inside the sandbox, or use
# `cs-sandbox create --env` to inject vars sandbox-wide instead.
[ -f "$CODEX_DIR/env" ] && { set -a; . "$CODEX_DIR/env"; set +a; }

# Pre-trust the project so codex never stops at the "Do you trust the contents of this
# directory?" gate. That gate is separate from approvals/sandbox (it controls loading
# project-local config/hooks/exec policies), so even --yolo would otherwise hit it. codex keys
# trust by the project root — the git repo root if any, else the launch dir — and persists it
# as a [projects."<root>"] table in config.toml; write that exact entry (what accepting the
# prompt would persist), once per root.
cfg="$CODEX_DIR/config.toml"
root="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"; root="${root:-$PWD}"
if ! grep -qF "[projects.\"$root\"]" "$cfg" 2>/dev/null; then
  printf '\n[projects."%s"]\ntrust_level = "trusted"\n' "$root" >> "$cfg"
fi

# Point codex at an alternative OpenAI-compatible endpoint, the way every other
# OpenAI client is pointed at one. codex reads no base-URL variable of its own —
# it takes a whole provider block — so this translates OPENAI_BASE_URL into the
# `-c` overrides that declare one. `-c` sets the same keys config.toml would,
# per invocation and with nothing written, so switching endpoints leaves no state
# behind and an unset variable changes nothing at all.
#
# Its reason for existing is a record/replay proxy in front of the model, which
# is how a fleet's traffic is captured and replayed for $0. cs-claude and
# cs-opencode need no such block: claude and opencode read ANTHROPIC_BASE_URL and
# OPENAI_BASE_URL themselves.
#
# The auth mode has to follow the endpoint. An API key travels in a header, so
# the provider names the variable holding it. A ChatGPT subscription travels as
# codex's own OAuth, which is what requires_openai_auth turns on — and that path
# has no /v1 on the base URL, so a caller pointing at a proxy for a subscription
# member gives the URL its provider expects.
#
# A key present wins, which is the useful default and also the trap: a sandbox
# meant to run on its ChatGPT subscription, but carrying an OPENAI_API_KEY for
# something else, is put on the key path here. Give a subscription sandbox no
# OPENAI_API_KEY.
if [ -n "${OPENAI_BASE_URL:-}" ]; then
  if [ -n "${OPENAI_API_KEY:-}" ]; then
    cs_auth='env_key="OPENAI_API_KEY"'
  else
    cs_auth='requires_openai_auth=true'
  fi
  set -- -c 'model_provider="cs-proxy"' \
         -c "model_providers.cs-proxy={name=\"cs-proxy\", base_url=\"$OPENAI_BASE_URL\", $cs_auth, wire_api=\"responses\"}" \
         "$@"
fi

if [ -n "${CS_CODEX_YOLO:-}" ] || [ -f "$CODEX_DIR/.yolo" ]; then
  exec codex --dangerously-bypass-approvals-and-sandbox "$@"
fi
exec codex "$@"
