#!/bin/bash
# Show progress of a remote opencode session.
# Exports the session as JSON on the session's remote host (via the cs-opencode wrapper, so the
# profile's OPENCODE_DB is used — no live server required) and summarizes recent activity.
#
# Usage:
#   cs-opencode-remote-status <name-or-id>         # session name or opencode session id REQUIRED
#   cs-opencode-remote-status <name-or-id> -n 5    # last 5 agent messages
#   cs-opencode-remote-status <name-or-id> -t      # show tool calls too

set -euo pipefail

SESSION_MAP_DIR="$HOME/.cs-opencode-remote-sessions"

HOST_FLAG=""
resolve_remote_host() {
    local name="${1:-}" h
    if [[ -n "$HOST_FLAG" ]]; then printf '%s\n' "$HOST_FLAG"; return; fi
    if [[ -n "$name" && -f "$SESSION_MAP_DIR/${name}.host" ]]; then
        h="$(cat "$SESSION_MAP_DIR/${name}.host" 2>/dev/null)"
        [[ -n "$h" ]] && { printf '%s\n' "$h"; return; }
    fi
    if [[ -n "${CS_OPENCODE_REMOTE_HOST:-}" ]]; then printf '%s\n' "$CS_OPENCODE_REMOTE_HOST"; return; fi
    hostname -s
}

NUM_MESSAGES=3; SESSION=""; SHOW_TOOLS=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        -n) NUM_MESSAGES="$2"; shift 2 ;;
        -t) SHOW_TOOLS=true; shift ;;
        -H|--host) HOST_FLAG="$2"; shift 2 ;;
        -h|--help)
            echo "Usage: cs-opencode-remote-status <name-or-session-id> [-n NUM] [-t]"
            echo "  -n NUM   Show last NUM agent messages (default: 3)"
            echo "  -t       Include tool calls"
            echo "  -H, --host <host>  SSH target host (default: the session's stored host)"
            exit 0 ;;
        *) SESSION="$1"; shift ;;
    esac
done

[[ -n "$SESSION" ]] || { echo "Error: session name or id is required" >&2; echo "  List: cs-opencode-remote-sessions" >&2; exit 1; }

ORIG_NAME=""
if ! [[ "$SESSION" =~ ^ses_[A-Za-z0-9]{20,40}$ ]]; then
    ORIG_NAME="$SESSION"
    if [[ -f "$SESSION_MAP_DIR/$SESSION" ]]; then SESSION="$(cat "$SESSION_MAP_DIR/$SESSION")"; fi
    [[ "$SESSION" =~ ^ses_[A-Za-z0-9]{20,40}$ ]] || { echo "No opencode session id known for '$ORIG_NAME' yet (has it run a turn?)" >&2; exit 1; }
fi

REMOTE_HOST="$(resolve_remote_host "$ORIG_NAME")"
SHOW_TOOLS_PY=$( $SHOW_TOOLS && echo True || echo False )

# `cs-opencode export` emits one JSON document {info, messages: [{info, parts}]} with per-part
# tool inputs/outputs and per-message timestamps — the same evidence the archive layer captures.
EXPORT_JSON="$(ssh "$REMOTE_HOST" "cs-opencode export '$SESSION'" 2>/dev/null)" \
    || { echo "Session $SESSION not found on $REMOTE_HOST" >&2; exit 1; }
[[ -n "$EXPORT_JSON" ]] || { echo "Session $SESSION not found on $REMOTE_HOST" >&2; exit 1; }

printf '%s' "$EXPORT_JSON" | python3 -u -c "
import sys, json, datetime
NUM = $NUM_MESSAGES
SHOW_TOOLS = $SHOW_TOOLS_PY
IS_TTY = sys.stdout.isatty()
def dim(t):  return f'\033[2m{t}\033[0m' if IS_TTY else t
def cyan(t): return f'\033[36m{t}\033[0m' if IS_TTY else t

try:
    doc = json.load(sys.stdin)
except json.JSONDecodeError:
    print('Could not parse session export', file=sys.stderr); sys.exit(1)

entries = []
for m in doc.get('messages', []):
    info = m.get('info') or {}
    if info.get('role') != 'assistant':
        continue
    ts = ((info.get('time') or {}).get('created') or 0)
    ts_short = datetime.datetime.fromtimestamp(ts / 1000).strftime('%Y-%m-%d %H:%M:%S') if ts else ''
    texts, tools = [], []
    for p in m.get('parts', []):
        pt = p.get('type')
        if pt == 'text':
            t = (p.get('text') or '').strip()
            if t: texts.append(t)
        elif pt == 'tool' and SHOW_TOOLS:
            name = p.get('tool', 'tool')
            state = p.get('state') or {}
            inp = state.get('input') or {}
            if isinstance(inp, (dict, list)): inp = json.dumps(inp)
            tools.append(f'{name}({str(inp)[:90]})')
    err = info.get('error')
    entries.append((ts_short, '\n'.join(texts), tools, err))

for ts_short, text, tools, err in entries[-NUM:]:
    print(dim(f'--- {ts_short} ---'))
    for t in tools: print(cyan(f'  [tool] {t}'))
    if err:
        name = err.get('name', 'error') if isinstance(err, dict) else 'error'
        print(f'  [ERROR] {name}')
    if text:
        if len(text) > 2000: text = text[:2000] + '\n... (truncated)'
        print(text)
    print()
"
