# Tier 1 of three: the OS and every toolchain, rebuilt on a schedule rather than per commit.
#
# WHY THIS IS ITS OWN IMAGE. Two consecutive CI builds of the old single-file image shared ZERO
# of their 26 layer blobs, so everyone re-pulled 2167.8 MB for 542 MB of real change — and in
# the two dnf layers below the only package that actually moved was one Bluetooth library, at
# 189 KB. None of this is reproducible and none of it can be made so: any dnf transaction
# rewrites a 29.5 MB rpm database keyed on install timestamps, plus 1.7 MB of dnf logs and a
# random /etc/machine-id. So the fix is not to make these steps deterministic, it is to stop
# re-running them. This file is built weekly, published as ghcr.io/codesweep-ai/sandbox-base,
# and named by tag from the tier above.
#
# WHAT BELONGS HERE: anything that does not read this repository. The Neovim config is the one
# exception — the pre-build below needs it — and the last stanza in this file exists to catch
# the mismatch that buys. Everything else that reads the checkout lives in Containerfile
# (tier 3); the agent CLIs live in Containerfile.agents (tier 2) because they move faster than
# this and slower than that.

FROM registry.fedoraproject.org/fedora:44

# This image is GENERIC: it bakes in NO developer-specific user name / uid / gid and
# no per-user home. The toolchains live under /opt (shared, root-owned), and the
# container user (matching the host's name/uid/gid/home) is created at first boot by
# the entrypoint. So one image serves every developer and machine — no rebuild to
# match your local identity. See SPEC.md.

# Make dnf resilient to slow/flaky mirrors: drop any mirror that can't sustain ~100 KiB/s
# for 20s and fail over to the next, with parallel downloads + extra retries. First step so
# it governs every later dnf invocation.
#
# install_weak_deps=False is here for the same reason — one setting, every later dnf. Fedora's
# Recommends are sized for a desktop, and three of them cost ~380 MB in a sandbox that can use
# none of them:
#   qemu-user-static     ~171 MB across 18 per-arch emulators. Recommended by
#                        containers-common-extra, which podman and buildah require outright, so
#                        it arrives with the container tooling and is only ever used to `podman
#                        build` for a foreign architecture. `sudo dnf install qemu-user-static`
#                        inside a sandbox brings it back for the session that wants it.
#   mesa-vulkan-drivers  ~169 MB, recommended by mesa-libGL/EGL, which Chromium requires.
#                        Chromium here is headless and renders through SwiftShader; it never
#                        opens a Vulkan device. (mesa-dri-drivers is a HARD dep of libGL and
#                        stays, and it drags llvm-libs with it — that ~190 MB only leaves if
#                        Chromium does.)
#   intel-*              ~36 MB of Intel GPU video-encode runtime, recommended by the same
#                        stack, for hardware a container is not talking to.
# A dropped Recommends is still installable by name, which is what makes this safe to set
# globally rather than per-package.
RUN printf '%s\n' \
      'max_parallel_downloads=10' \
      'minrate=102400' \
      'timeout=20' \
      'retries=15' \
      'install_weak_deps=False' \
    >> /etc/dnf/dnf.conf

# Install Fedora packages
RUN dnf update -y && dnf install -y \
  vim findutils fd procps-ng tar zip unzip patch jq yq which lsof \
  iputils dnsutils iproute tcpdump wireshark-cli hostname netstat socat \
  sudo openssl openssh-clients openssh-server nmap telnet curl \
  git gcc gcc-c++ automake make cmake patch \
  zlib-devel bzip2 bzip2-devel \
  readline-devel sqlite sqlite-devel \
  openssl-devel tk-devel libffi-devel xz xz-devel \
  libuuid-devel gdbm-libs libnsl2 lzma lzma-sdk-devel \
  ncurses ncurses-devel ncurses-term tmux \
  g++ python-devel \
  graphviz graphviz-devel \
  podman skopeo buildah rsync shadow-utils \
  fuse-overlayfs crun slirp4netns passt containers-common \
  dnf-utils rclone bash-completion \
  ripgrep fzf bat git-delta tree htop less wget nmap-ncat gh uv \
  ninja-build gettext glibc-gconv-extra \
  pandoc && \
  dnf clean all

# Install Chromium
RUN dnf -y install \
    chromium \
    nss atk cups-libs pango alsa-lib \
    libXcomposite libXcursor libXdamage libXext libXi libXrandr libXScrnSaver libXtst \
    xorg-x11-fonts-Type1 xorg-x11-fonts-misc liberation-fonts \
    mesa-libEGL mesa-libGL && \
    dnf clean all

# CHROME_BIN is declared in rootfs/etc/cs-sandbox/env — an image ENV never reaches
# an SSH session or a microVM. See that file.

# NOTE: this file reads the checkout exactly once, for the editor config the Neovim
# pre-build needs. Everything else the repository ships — the entrypoint, the home
# skeleton, the vendored scripts — arrives through `COPY . /sandbox` in the leaf
# (Containerfile), two tiers up, so editing any of it invalidates 25 MB rather than
# the toolchain compiles and the 956 MB pre-build below.

# Disable PAM for sudo.
#
# SAFETY ASSUMPTION: this unconditionally-succeeding sudo (passwordless NOPASSWD:ALL) is
# safe ONLY because the security boundary is the engine, not in-sandbox sudo — rootless
# `--userns=keep-id` (container "root" == your unprivileged host uid) or a microVM's own
# kernel. The agent already owns its disposable sandbox, so sudo grants nothing outside it.
# Running this image rootful, `--privileged`, or `--userns=host` would break that boundary
# and turn this into real host-root. See SPEC.md "Security model".
#
# The container user is created at first boot (see image/rootfs/entrypoint) with a LOCKED
# password (useradd -p '*') and is granted NOPASSWD:ALL via /etc/sudoers.d. There is no
# password to authenticate against, and the image is a minimal rootless container with no
# running systemd/logind — so stock PAM modules for sudo would either reject the locked
# account (pam_unix auth/account) or fail/hang trying to open a login session
# (pam_systemd registering with a logind that isn't there). Replacing every PAM stack with
# pam_permit.so makes the sudo PAM transaction unconditionally succeed, so passwordless
# sudo is reliable and non-interactive — otherwise `sudo` in a sandbox hangs or refuses.
# sshd is likewise run with UsePAM=no for the same reason.
RUN echo -e "auth       sufficient   pam_permit.so\n\
account    sufficient   pam_permit.so\n\
password   sufficient   pam_permit.so\n\
session    sufficient   pam_permit.so" > /etc/pam.d/sudo

# Configure nested podman. It runs ROOTLESS, as the sandbox user, exactly as podman does
# on any normal machine and in a microVM; /sandbox/nested-rootless supplies the two things
# a container otherwise lacks (mapped subuid ranges and newuidmap file caps). The outer
# container runs with a scaled-down cap set (SYS_ADMIN/SETFCAP + /dev/net/tun +
# unmask=ALL, seccomp on; --privileged is an opt-in fallback) and is itself rootless, so
# those caps are bounded by the unprivileged host user. Default to the kernel's NATIVE
# overlay driver (fast path): the per-instance cs-sandbox-containers volume mounted at the
# user's rootless graphroot gives the store a non-overlay backing fs, so on kernel >= 5.13
# native overlay mounts directly — no fuse-overlayfs userspace layer and its perf cost.
# The entrypoint auto-falls-back to fuse-overlayfs (still installed) if a native overlay
# mount isn't possible here.
RUN mkdir -p /etc/containers && \
    printf '[storage]\ndriver = "overlay"\n' > /etc/containers/storage.conf && \
    printf '[containers]\ncgroups = "disabled"\n\n[engine]\ncgroup_manager = "cgroupfs"\nevents_logger = "file"\n' > /etc/containers/containers.conf

# Default internal sshd port (overridable at runtime via -e CS_SANDBOX_SSH_PORT)
ENV CS_SANDBOX_SSH_PORT=2222

# Configure sshd.
#
# No `ssh-keygen -A` here: host keys are per-INSTANCE, not per-image. internal/seed writes a
# fresh set into every sandbox seed and both engines install them at boot (rootfs/entrypoint,
# guest/init), each falling back to generating its own when a seed carries none. Baking a set
# into the image defeated that fallback — `ssh-keygen -A` only creates keys that are MISSING, so
# the image's set survived the fallback and every sandbox built from one image shared it.
RUN mkdir -p /var/run/sshd \
  && sed -i 's/^#PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config \
  && sed -i 's/^#PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config \
  && sed -i 's/^#PubkeyAuthentication.*/PubkeyAuthentication yes/' /etc/ssh/sshd_config \
  && sed -i 's/^#\?Port .*/Port 2222/' /etc/ssh/sshd_config

# Neovim — the official prebuilt release tarball, not a source build. Upstream publishes a
# self-contained Linux tarball for both arches (it links only libc/libm/libgcc_s), so there is
# nothing to gain from compiling it here: this turns a multi-minute build of Neovim plus its
# bundled deps into an 11 MB download. It installs into /usr/local exactly where `make install`
# used to put it, so $VIMRUNTIME and PATH are unchanged.
#
# Bump NVIM_VERSION (or pass --build-arg) to upgrade, and update BOTH checksums — Neovim
# publishes no checksum file for these assets, so the digests are pinned here (GitHub release
# assets are immutable, so this is a genuine pin, verified on every build).
#
# 0.12 is a hard requirement of the config in image/rootfs/home/.config/nvim: nvim-treesitter's
# `main` branch (the only maintained one) refuses to run on anything older.
ARG NVIM_VERSION=0.12.5
ARG NVIM_SHA256_X86_64=bce0f56eda1f1b1db6eee8f4133d7a38813ea07933837dd1777411ca384c6875
ARG NVIM_SHA256_ARM64=1aa5ca085249580ae0f91eb14f27ec0919773ff2d99a163d03f3d6c21ac29725
RUN case "$(uname -m)" in \
      x86_64|amd64)  arch=x86_64; want="$NVIM_SHA256_X86_64" ;; \
      arm64|aarch64) arch=arm64;  want="$NVIM_SHA256_ARM64" ;; \
      *) echo "unsupported arch $(uname -m)" >&2; exit 1 ;; \
    esac \
  && curl -fsSL -o /tmp/nvim.tar.gz \
       "https://github.com/neovim/neovim/releases/download/v${NVIM_VERSION}/nvim-linux-${arch}.tar.gz" \
  && got=$(sha256sum /tmp/nvim.tar.gz | cut -d' ' -f1) \
  && { [ "$want" = "$got" ] || { echo "nvim checksum mismatch: want=$want got=$got" >&2; exit 1; }; } \
  && tar -xzf /tmp/nvim.tar.gz -C /usr/local --strip-components=1 --no-same-owner \
  && rm -f /tmp/nvim.tar.gz \
  && nvim --version | head -2

# tree-sitter CLI: a hard requirement of nvim-treesitter's `main` branch, which uses it to
# install/update parsers (`:TSInstall`, `:TSUpdate`, and the parser pre-build below).
# Its Recommends pull in a second, unwanted Node (gcc is already installed, and the shared
# /opt/nvm Node is on PATH for `tree-sitter generate`) — now covered by the global
# install_weak_deps=False in dnf.conf, which this stanza used to set on its own.
RUN dnf install -y tree-sitter-cli && dnf clean all \
  && tree-sitter --version

# --- Toolchains under /opt (shared, root-owned, path-independent) ---------------
# No developer user is created at build time (the entrypoint does that on first boot),
# so the heavy toolchains can't live in a per-user $HOME. They go under /opt instead,
# installed as root and shared by every runtime user. Read-only at runtime: to add
# more Python/Node versions or global npm/pip packages, use `sudo`. Per-project work
# (virtualenvs, node_modules) is unaffected — it lives in the user's repos.

# Pyenv + Python 3.14.7 (PYENV_ROOT=/opt/pyenv)
# 3.14 is the current stable line. This image previously pinned 3.12 on the argument that it
# was where the wheels were; two years on, 3.14 has the C-extension coverage that argument was
# protecting against, and staying on a security-only line to buy compatibility that already
# exists is the worse trade. A project that genuinely needs an older interpreter gets one with
# `sudo pyenv install <ver>` and a `.python-version` in its repo — which is the whole reason
# pyenv is here rather than a bare CPython.
ENV PYENV_ROOT=/opt/pyenv
RUN curl -fsSL https://pyenv.run | PYENV_GIT_TAG=v2.8.4 bash \
  && PATH="$PYENV_ROOT/bin:$PATH" pyenv install -s 3.14.7 \
  && PATH="$PYENV_ROOT/bin:$PATH" pyenv global 3.14.7 \
  && chmod -R a+rX "$PYENV_ROOT"

# NVM + Node 24.19.0 (NVM_DIR=/opt/nvm): a general JS/TS runtime; npm -g lands in shared node.
# 24.x is the Active LTS line ("Krypton", LTS since 2025-10, maintenance from 2026-10) — so
# this line is worth re-evaluating in Oct 2026, when 24 goes to maintenance and 26 takes over
# as Active LTS.
# (The Claude Code & Codex agents are self-contained binaries under /opt, not npm packages.)
ENV NVM_DIR=/opt/nvm
RUN mkdir -p "$NVM_DIR" \
  && curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.7/install.sh | bash \
  && bash -c '. "$NVM_DIR/nvm.sh" && nvm install v24.19.0 && nvm alias default v24.19.0' \
  && chmod -R a+rX "$NVM_DIR"

# Go 1.27.0 (GOROOT=/opt/go) — the upstream tarball, pinned and checksum-verified, replacing
# Fedora's golang-bin. Go is a first-class runtime here, on the same footing as the pyenv and
# nvm toolchains above rather than whatever `dnf update` last pulled in:
#   * pinned + reproducible, and an unpatched upstream build (Fedora ships a patched
#     `go1.26.4-X:nodwarf5`);
#   * GOTOOLCHAIN stays at upstream's `auto` (Fedora forces `local`), so a repo whose go.mod
#     asks for a different `go 1.x` fetches that toolchain on demand into the user's module
#     cache — Go's own answer to nvm/pyenv version switching, and it works despite /opt being
#     read-only because the download lands in $GOPATH, not $GOROOT;
#   * ~/.bashrc sets GOPATH/GOBIN and puts $GOPATH/bin on PATH, so `go install x@latest`
#     produces a runnable command the way `npm -g` and `pip install` already do.
# go.dev publishes the digests in its release JSON (https://go.dev/dl/?mode=json); bump
# GO_VERSION and both checksums together to upgrade.
# Temurin JDK 25 (JAVA_HOME=/opt/java) + Maven (/opt/maven), replacing Fedora's
# java-latest-openjdk/maven. Pinned like every other runtime here, and it removes a mess:
# `java-latest-openjdk` installed a 256 MB JDK 26 that nothing used, because `maven` dragged
# in java-25-openjdk as its own dependency and /usr/bin/java resolved to THAT — so the image
# shipped two JDKs, ran the one it never asked for, and floated on both. One pinned JDK on
# PATH now, which is also what mason's `jdtls` language server runs on.
# 25 is the current LTS line. 25.0.4.1 is an out-of-band patch on top of 25.0.4, which is why
# the version has four components and the build number restarts at 1 — the URL template below
# takes both from the ARGs, so nothing else changes.
# Checksums are Adoptium's published digests (https://api.adoptium.net/v3/assets/…);
# bump JAVA_VERSION/JAVA_BUILD and both checksums together to upgrade.
ARG JAVA_VERSION=25.0.4.1
ARG JAVA_BUILD=1
ARG JAVA_SHA256_X64=dbb698396d478e7fa2b1e50f4103324b2a99b90569ee27c33f2261f9215cf41e
ARG JAVA_SHA256_AARCH64=69df11a02cfa3ef7d7ca645e03edce6778ec090e100f6ae2b42097865730ac52
RUN case "$(uname -m)" in \
      x86_64|amd64)  jarch=x64;     want="$JAVA_SHA256_X64" ;; \
      arm64|aarch64) jarch=aarch64; want="$JAVA_SHA256_AARCH64" ;; \
      *) echo "unsupported arch $(uname -m)" >&2; exit 1 ;; \
    esac \
  && curl -fsSL -o /tmp/jdk.tar.gz \
       "https://github.com/adoptium/temurin25-binaries/releases/download/jdk-${JAVA_VERSION}%2B${JAVA_BUILD}/OpenJDK25U-jdk_${jarch}_linux_hotspot_${JAVA_VERSION}_${JAVA_BUILD}.tar.gz" \
  && got=$(sha256sum /tmp/jdk.tar.gz | cut -d' ' -f1) \
  && { [ "$want" = "$got" ] || { echo "jdk checksum mismatch: want=$want got=$got" >&2; exit 1; }; } \
  && mkdir -p /opt/java \
  && tar -xzf /tmp/jdk.tar.gz -C /opt/java --strip-components=1 --no-same-owner \
  && rm -f /tmp/jdk.tar.gz \
  && chmod -R a+rX /opt/java \
  && /opt/java/bin/java -version 2>&1 | head -1
# (java -version writes to stderr, which `podman build -q` does NOT suppress — the 2>&1
#  keeps this sanity check out of a quiet build's console.)

# Maven is a pure-Java tarball; Apache publishes a .sha512 next to it, verified here.
ARG MAVEN_VERSION=3.9.16
ARG MAVEN_SHA512=831a8591fe20c8243b1dbe7d71e3244f31d1665b0804b2e825e38cbbe5ce0cafb8338851f90780735568773e0a6cd07bbec107cda0b896b008b861075358b6f6
RUN curl -fsSL -o /tmp/maven.tar.gz \
       "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" \
  && got=$(sha512sum /tmp/maven.tar.gz | cut -d' ' -f1) \
  && { [ "$MAVEN_SHA512" = "$got" ] || { echo "maven checksum mismatch" >&2; exit 1; }; } \
  && mkdir -p /opt/maven \
  && tar -xzf /tmp/maven.tar.gz -C /opt/maven --strip-components=1 --no-same-owner \
  && rm -f /tmp/maven.tar.gz \
  && chmod -R a+rX /opt/maven \
  && JAVA_HOME=/opt/java /opt/maven/bin/mvn --version | head -1

ARG GO_VERSION=1.27.0
ARG GO_SHA256_AMD64=675c26c449cbb18fc24b74650de1eabbae6e16f64326fd85a283fb3b58280685
ARG GO_SHA256_ARM64=51798d2c42d0e1c6ed7fd9f48728b4193abac9e8aad6dbac2fe96a81f5909bda
RUN case "$(uname -m)" in \
      x86_64|amd64)  garch=amd64; want="$GO_SHA256_AMD64" ;; \
      arm64|aarch64) garch=arm64; want="$GO_SHA256_ARM64" ;; \
      *) echo "unsupported arch $(uname -m)" >&2; exit 1 ;; \
    esac \
  && curl -fsSL -o /tmp/go.tar.gz "https://go.dev/dl/go${GO_VERSION}.linux-${garch}.tar.gz" \
  && got=$(sha256sum /tmp/go.tar.gz | cut -d' ' -f1) \
  && { [ "$want" = "$got" ] || { echo "go checksum mismatch: want=$want got=$got" >&2; exit 1; }; } \
  && tar -xzf /tmp/go.tar.gz -C /opt --no-same-owner \
  && rm -f /tmp/go.tar.gz \
  && chmod -R a+rX /opt/go \
  && /opt/go/bin/go version

# The dev toolchain this project is worked on with, prebuilt so a sandbox is useful the moment it
# boots: build it, lint it, vet the workflows. `make check` no longer needs any of it on the PATH,
# because golangci-lint, actionlint and deadcode are pinned as Go tools and the gates build them
# from the module cache; these copies are the same versions, ahead of time. Keep them in step with
# go.mod and go.golangci.mod, or a sandbox reports something a laptop does not.
#
# goreleaser is here because `make build` prefers it and falls back to `go build` without it, which
# would quietly produce a binary stamped differently from a released one.
#
# Each is fetched as the binary its own project publishes, verified against the checksum that
# release ships. Building them from source instead cost minutes of every image build to arrive at
# the same three binaries, and put this image's Go between the tool and the one its authors tested.
ARG GOLANGCI_VERSION=2.13.1
ARG GOLANGCI_SHA256_AMD64=b17bfbc9d4aaa48be7f4f1ce3240bc3d8200c870c072bacf15c26219e2cfb9cc
ARG GOLANGCI_SHA256_ARM64=908317c23db18448f924e853b3d8a659fd919614cd438f224810a4053daa2607
ARG ACTIONLINT_VERSION=1.7.12
ARG ACTIONLINT_SHA256_AMD64=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
ARG ACTIONLINT_SHA256_ARM64=325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6
ARG GORELEASER_VERSION=2.18.0
ARG GORELEASER_SHA256_AMD64=41cdf49b653784b03a08013dd99e382cd5d463049e915c2d818eaed182ae6197
ARG GORELEASER_SHA256_ARM64=1975566c9668e6f4247e6bb57656f21da13635c24d948ef47b1232e5c864a35b
RUN set -eu; \
    case "$(uname -m)" in \
      x86_64|amd64)  arch=amd64; grel=x86_64; \
        gcl="$GOLANGCI_SHA256_AMD64"; acl="$ACTIONLINT_SHA256_AMD64"; grl="$GORELEASER_SHA256_AMD64" ;; \
      arm64|aarch64) arch=arm64; grel=arm64; \
        gcl="$GOLANGCI_SHA256_ARM64"; acl="$ACTIONLINT_SHA256_ARM64"; grl="$GORELEASER_SHA256_ARM64" ;; \
      *) echo "unsupported arch $(uname -m)" >&2; exit 1 ;; \
    esac; \
    fetch() { \
      curl -fsSL -o /tmp/t.tar.gz "$1"; \
      got=$(sha256sum /tmp/t.tar.gz | cut -d" " -f1); \
      [ "$2" = "$got" ] || { echo "checksum mismatch for $1: want=$2 got=$got" >&2; exit 1; }; \
      rm -rf /tmp/x; mkdir -p /tmp/x; tar -xzf /tmp/t.tar.gz -C /tmp/x --no-same-owner; \
      bin=$(find /tmp/x -type f -name "$3" | head -1); \
      [ -n "$bin" ] || { echo "no $3 inside $1" >&2; exit 1; }; \
      install -m0755 "$bin" /usr/local/bin/"$3"; \
      rm -rf /tmp/t.tar.gz /tmp/x; \
    }; \
    fetch "https://github.com/golangci/golangci-lint/releases/download/v${GOLANGCI_VERSION}/golangci-lint-${GOLANGCI_VERSION}-linux-${arch}.tar.gz" "$gcl" golangci-lint; \
    fetch "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_linux_${arch}.tar.gz" "$acl" actionlint; \
    fetch "https://github.com/goreleaser/goreleaser/releases/download/v${GORELEASER_VERSION}/goreleaser_Linux_${grel}.tar.gz" "$grl" goreleaser; \
    for t in golangci-lint actionlint goreleaser; do \
      command -v "$t" >/dev/null || { echo "missing after install: $t" >&2; exit 1; }; \
    done

# deadcode is the exception: golang.org/x/tools publishes no binaries, so this one is built. The
# version is the golang.org/x/tools pin in go.mod, which is where the gates get theirs.
RUN GOBIN=/usr/local/bin GOTOOLCHAIN=local PATH=/opt/go/bin:$PATH \
      go install golang.org/x/tools/cmd/deadcode@v0.49.0 \
  && /opt/go/bin/go clean -modcache -cache \
  && command -v deadcode >/dev/null

# Python CLI tools in an isolated, root-owned venv
# --disable-pip-version-check: pip's "a new release of pip is available" notice goes to
# stderr, which `podman build -q` does not suppress, so it would show up in a quiet build.
RUN python3 -m venv /opt/py-tools \
  && /opt/py-tools/bin/pip install --no-cache-dir --disable-pip-version-check claude-code-transcripts \
  && chmod -R a+rX /opt/py-tools

# Note: there is deliberately no `RUN chmod -R a+rX /opt` here. Each stanza above chmods the
# tree it just installed, in the same layer. A separate chmod pass costs 1.9 GB: chmod writes
# every inode, overlayfs copies up every file it writes, and the result is a second, complete
# copy of /opt in the image — identical bytes, no new content. Doing it in-layer is free.
# A new toolchain under /opt therefore has to end with its own `chmod -R a+rX`; the
# image_slim_test guards that (TestOptStanzasChmodInLayer).

# Toolchains on PATH for ALL shells (incl. non-interactive `ssh cs-sandbox-x <cmd>`), so node,
# the agents (claude, codex, opencode), and the py-tools are found without sourcing ~/.bashrc.
# (~/.bashrc additionally runs pyenv/nvm init for interactive version switching.)
ENV JAVA_HOME=/opt/java
ENV PATH=/opt/nvm/versions/node/v24.19.0/bin:/opt/py-tools/bin:/opt/claude/bin:/opt/codex/bin:/opt/opencode/bin:/opt/pyenv/bin:/opt/go/bin:/opt/java/bin:/opt/maven/bin:${PATH}

# The Neovim config, and ONLY that, ahead of the pre-build below — 72 KB of the 392 KB
# `COPY . /sandbox` used to bring here. That pre-build is the single largest layer in the
# image at 956 MB, and everything copied above it is one more thing whose edit re-creates
# it: with the whole repo context up here, touching the entrypoint or one of the vendored
# cs- scripts rebuilt 956 MB of language servers that had not changed. Now only a real
# edit to the editor config or lazy-lock.json does.
COPY home/.config/nvim /sandbox/home/.config/nvim

# Pre-build the ENTIRE Neovim setup, so the first `nvim` in a sandbox is instant and needs
# no network. Three kinds of artifact, and they can't all live in the same place:
#
#   1. plugins  -> the home SEED (/sandbox/home/.local/share/nvim/lazy). The entrypoint copies
#                  the seed into the user's home on first boot. `install` + `restore` (NOT
#                  `sync`) so the checked-in lazy-lock.json decides the revisions and the build
#                  is reproducible — `sync` updates to whatever is HEAD today and rewrites the
#                  lockfile inside the image, where nobody ever sees it.
#   2. treesitter parsers -> also the seed (~18 MB of .so + queries, position-independent).
#                  `:TSInstallSync` is defined by lua/plugins/treesitter.lua; nvim-treesitter's
#                  own install is async, so a plain headless call would exit before it finished.
#   3. LSP servers / formatters -> /opt/nvim/mason, NOT the home. Mason bakes the absolute
#                  install path into its bin/ wrappers (and into the venv it builds for
#                  basedpyright), so ~1 GB of servers pre-installed under /sandbox/home would
#                  still point at /sandbox/home after being copied to a developer's home. They
#                  go under /opt with the other shared toolchains instead: one root-owned,
#                  path-stable copy, never duplicated into an instance's home. lua/plugins/
#                  mason.lua picks that root up automatically (override with $MASON_ROOT).
#
# The `!` on the two sync commands makes them exit non-zero when something did not install,
# so a partial pre-build fails the image build here instead of shipping a sandbox that
# quietly downloads half its editor the first time you open a file.
#
# The rm near the end drops build-time caches — mason's installers leave npm/pip/Go caches
# behind (gopls alone leaves ~550 MB in ~/.cache/go-build and ~/go), plus the path-keyed Lua
# bytecode cache and logs — which would otherwise be copied into every sandbox home. That
# leak is invisible (the build still succeeds), so the final `du` check fails the build if
# the seed grows past ~100 MB. $HOME holds the nvim config and what this step made and
# nothing else — the rest of the home skeleton is copied in below — so that number is this
# step's own output: ~80 MB is plugins + treesitter parsers, and anything beyond
# means a newly added package left a cache that needs adding to the rm list.
#
# `step` keeps the console quiet. `podman build -q` (what `cs-sandbox build` uses unless
# you pass --verbose) only suppresses a RUN's stdout — its stderr goes straight to the
# terminal, and `nvim --headless` writes everything there, so these four commands used to
# spray ~120 lines of lazy/mason/treesitter progress over every build. Output is captured
# instead and replayed only if a step fails; BUILD_VERBOSE=1 (set by `cs-sandbox build
# --verbose`) passes it through live.
ARG BUILD_VERBOSE=0
RUN set -e; \
    export HOME=/sandbox/home \
           XDG_CONFIG_HOME=/sandbox/home/.config \
           XDG_DATA_HOME=/sandbox/home/.local/share \
           XDG_STATE_HOME=/sandbox/home/.local/state \
           XDG_CACHE_HOME=/sandbox/home/.cache; \
    mkdir -p /opt/nvim/mason; \
    log=/tmp/nvim-setup.log; \
    step() { \
      if [ "${BUILD_VERBOSE:-0}" = 1 ]; then "$@"; \
      else "$@" >>"$log" 2>&1 \
        || { echo "cs-sandbox: neovim pre-install failed: $*" >&2; cat "$log" >&2; exit 1; }; \
      fi; \
    }; \
    step nvim --headless '+Lazy! install' +qa; \
    step nvim --headless '+Lazy! restore' +qa; \
    step nvim --headless '+TSInstallSync!' +qa; \
    step nvim --headless '+MasonInstallSync!' +qa; \
    rm -f "$log"; \
    chmod -R a+rX /opt/nvim; \
    rm -rf "$HOME/.npm" "$HOME/.cache/pip" "$HOME/.cache/go-build" "$HOME/go" \
           "$HOME/.cache/tree-sitter" \
           "$XDG_CACHE_HOME/nvim/luac" "$XDG_STATE_HOME/nvim" \
           "$XDG_DATA_HOME/nvim/mason"; \
    seed_mb=$(du -sm "$HOME" | cut -f1); \
    echo "home seed: ${seed_mb} MB"; \
    [ "$seed_mb" -lt 100 ] || { echo "home seed too large (${seed_mb} MB) — a build cache leaked into /sandbox/home" >&2; du -sm "$HOME"/* "$HOME"/.[a-z]* 2>/dev/null | sort -n | tail -10 >&2; exit 1; }

# Record what the Neovim pre-build above was built FROM, so tier 3 can refuse to ship a
# mismatch. `COPY . /sandbox` down there re-copies .config/nvim out of the checkout, over the
# copy this tier pre-built against — and if the two differ the image ships a config naming
# plugins that were never installed. No build error, no failing test, and it surfaces only when
# somebody opens nvim inside a sandbox. Sorted before hashing so readdir order cannot fake a
# change; the file list is hashed too, so an added or deleted file counts.
RUN find /sandbox/home/.config/nvim -type f -exec sha256sum {} + \
      | sort | sha256sum | cut -d' ' -f1 > /opt/nvim/.config-hash
