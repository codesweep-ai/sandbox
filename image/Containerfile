# Tier 3 of three: this repository — the entrypoint, the home skeleton, the vendored scripts
# and the codesweep tools — on top of the tier-2 agents image.
#
# This is what a commit rebuilds, and it is 25 MB: `COPY . /sandbox` plus a ~25 MB Go install.
# The 2.14 GB underneath moves only when somebody bumps AGENTS_REF.
#
# AGENTS_REF is REQUIRED and has no default. The pin lives in image/tiers.env — one file for
# both families, because the slim Containerfiles are derived and cannot carry a pin of their
# own — and `cs-sandbox build` reads it from there. Bumping it is a deliberate commit, the same
# gesture as bumping GO_VERSION or CLAUDE_CODE_VERSION; `cs-sandbox build --rebuild-base`
# overrides it to build all three tiers locally instead.
ARG AGENTS_REF
FROM ${AGENTS_REF}

# Placed LOW, below the toolchains and the agents. This is the one stanza a caller changes per
# build — `cs-sandbox build` forwards CS_SANDBOX_PRIVATE_REGISTRY[_INSECURE] on every invocation
# — so everything expensive has to sit above it. Up top, a 1.5 kB file invalidated ~2 GB of
# toolchain layers.
#
# Register a private podman registry so nested podman can pull from a local/private registry.
# Build-args (cs-sandbox forwards the matching CS_SANDBOX_PRIVATE_REGISTRY[_INSECURE] env vars;
# see SPEC.md "Private registry"):
#   CS_SANDBOX_PRIVATE_REGISTRY=host:port    registry to trust, as a BARE host:port (podman's
#                                            registries.conf `location` form — no scheme); empty
#                                            -> register none.
#   CS_SANDBOX_PRIVATE_REGISTRY_INSECURE=1   insecure: `insecure = true` lets podman use plain-HTTP
#                                            and skip TLS verification; 0 (default) -> secure (HTTPS,
#                                            TLS-verified).
# Per docker/podman convention the protocol is IMPLICIT in this flag — a registry is named by its
# bare host:port, secure means HTTPS, insecure permits HTTP / untrusted certs; there is no
# http://-vs-https:// scheme. Secure is the default; insecure is opt-in (e.g. a plain-HTTP registry:
# --build-arg CS_SANDBOX_PRIVATE_REGISTRY=registry.internal:5000 --build-arg ..._INSECURE=1).
ARG CS_SANDBOX_PRIVATE_REGISTRY=
ARG CS_SANDBOX_PRIVATE_REGISTRY_INSECURE=0
RUN if [ -n "$CS_SANDBOX_PRIVATE_REGISTRY" ]; then \
      { printf '[[registry]]\nlocation = "%s"\n' "$CS_SANDBOX_PRIVATE_REGISTRY"; \
        case "$CS_SANDBOX_PRIVATE_REGISTRY_INSECURE" in \
          1|true|TRUE|yes|YES|on|ON) printf 'insecure = true\n' ;; \
        esac; \
      } >> /etc/containers/registries.conf; \
    fi

# Repo context (entrypoint, home skeleton, vendored scripts). Deferred to here — below the
# toolchain compiles AND below the Neovim pre-build — so editing any of it re-creates 392 KB
# rather than the 956 MB above. It merges into the home that pre-build just seeded: COPY
# adds and overwrites but never deletes, so the plugins and parsers under
# /sandbox/home/.local/share/nvim survive, and .config/nvim is rewritten with the same bytes
# it was copied from a moment ago.
COPY . /sandbox

# The other half of the guard written in Containerfile.base. Fail loudly rather than ship a
# Neovim config whose plugins were pre-built from a different one.
RUN want=$(cat /opt/nvim/.config-hash) \
  && got=$(find /sandbox/home/.config/nvim -type f -exec sha256sum {} + | sort | sha256sum | cut -d' ' -f1) \
  && { [ "$want" = "$got" ] || { \
       echo "the Neovim config changed since sandbox-base was built (want=$want got=$got)" >&2; \
       echo "rebuild the base with: cs-sandbox build --rebuild-base" >&2; \
       exit 1; }; }

# The guest environment declaration, at a path both entry paths read. Installed
# rather than referenced under /sandbox so it looks like the config it is.
RUN install -Dm0644 /sandbox/etc/cs-sandbox/env /etc/cs-sandbox/env

# The codesweep tools. cs-sandbox is here because a sandbox is a place to work FROM, and some of
# that work is driving another sandbox: create a peer for a second experiment, `ls` what is running,
# `fetch` a branch back. Its siblings come with it, so a sandbox can lint prose, keep a ledger and
# trace a run without installing anything first. Each is a single static Go binary.
#
# The three siblings are installed at the versions THIS repository's go.mod pins, passed in by
# `cs-sandbox build` from that manifest, so the image ships what `make versions` reports rather than
# whatever each branch tip held the moment the image was built. `make repin` moves them, in a diff
# somebody reviews. There is no default: an empty version means the image was built by something
# other than `cs-sandbox build`, and guessing @latest there is the drift this replaced.
#
# cs-sandbox pins itself: its version is not in the manifest, because a module cannot name its own,
# but the cs-sandbox running the build knows which revision built it and passes that. So the image
# ships the cs-sandbox that made it, and a sandbox can drive a peer with the same binary it came
# from. That revision has to be pushed for the install to resolve.
#
# LAST of the build steps, under even the Neovim pre-build (it needs only the Go toolchain above,
# and nothing below needs it). CS_SANDBOX_VERSION moves on every commit, and buildah writes EVERY
# in-scope build arg into each later step's cache key — an arg a step never reads still busts it,
# so the ARG lines below matter as much as the RUN. Sitting where it used to, one version bump
# invalidated the ~2.0 GB beneath it (the three agent CLIs, the py-tools venv, the 956 MB Neovim
# pre-build) to change the ~31 MB of Go binaries it installs, and a registry would store and serve
# that ~2.0 GB again for every version. Here it invalidates nothing: two images that differ only
# by cs-sandbox version share every layer but this one. A stanza appended AFTER it pays that cost
# all over again — new ones go above. image_slim_test guards the position.
#
# The module cache and build cache go in the same layer, or the ~400 MB they hold ships too. One
# `go install` per tool: it refuses a command line naming packages from more than one module.
# CS_GOPROXY/CS_GONOSUMDB are set only by `cs-sandbox build --local-sandbox`, which mounts a
# file:// proxy holding this checkout's own module zip so a revision nobody has pushed can still be
# installed by version. Empty on every other build, which leaves the toolchain defaults alone.
ARG CS_GOPROXY=
ARG CS_GONOSUMDB=
ARG CS_SANDBOX_VERSION=
ARG CS_SANDBOX_REVISION=
ARG CS_LINT_VERSION=
ARG CS_LEDGER_VERSION=
ARG CS_TRACER_VERSION=
ARG CS_VCR_VERSION=

# The install itself, in a stanza of its own so ci-slim.sh can drop it and keep the
# declarations above: the CI image ships no cs-sandbox, and is still tagged and
# labelled with the version that built it.
RUN export GOBIN=/usr/local/bin GOTOOLCHAIN=local PATH=/opt/go/bin:$PATH \
  && if [ -n "${CS_GOPROXY}" ]; then export GOPROXY="${CS_GOPROXY}" GONOSUMDB="${CS_GONOSUMDB}"; fi \
  && for v in "${CS_SANDBOX_VERSION}" "${CS_LINT_VERSION}" "${CS_LEDGER_VERSION}" "${CS_TRACER_VERSION}" "${CS_VCR_VERSION}"; do \
       test -n "$v" || { echo "a cs- tool version is empty: build with 'cs-sandbox build', which passes the go.mod pins" >&2; exit 1; }; \
     done \
  && go install github.com/codesweep-ai/sandbox/cmd/cs-sandbox@${CS_SANDBOX_VERSION} \
  && go install github.com/codesweep-ai/lint/cmd/cs-lint@${CS_LINT_VERSION} \
  && go install github.com/codesweep-ai/ledger/cmd/cs-ledger@${CS_LEDGER_VERSION} \
  && go install github.com/codesweep-ai/tracer/cmd/cs-tracer@${CS_TRACER_VERSION} \
  && go install github.com/codesweep-ai/vcr/cmd/cs-vcr@${CS_VCR_VERSION} \
  && go clean -modcache -cache \
  && for t in cs-sandbox cs-lint cs-ledger cs-tracer cs-vcr; do \
       command -v "$t" >/dev/null || { echo "missing after install: $t" >&2; exit 1; }; \
     done

# Image metadata. Placed here — after the heavy toolchain/COPY layers — so editing a
# label only rebuilds this cheap layer, not the build above. It reads the two ARGs
# declared by the stanza above, which is the last one to declare any.
#
# version is the cs-sandbox this image ships and is tagged with, so a running sandbox
# can say which build it came from without anyone reading a tag off the host. revision
# is the commit that version resolves to: a release build's version is `v0.1.0`, which
# carries no revision of its own, so this is the only way back to the source from
# inside the image. The version/vendor/licenses/url here OVERRIDE values inherited from
# the Fedora base (which would otherwise read 44 / "Fedora Project" / MIT /
# fedoraproject.org and misdescribe this image); os-version below is the Fedora major,
# which is a different thing and keeps its own label.
LABEL org.opencontainers.image.title="sandbox" \
      org.opencontainers.image.description="Generic sandbox image (Fedora 44 base, shared /opt toolchains; per-developer user created at first boot)." \
      org.opencontainers.image.base.name="registry.fedoraproject.org/fedora:44" \
      org.opencontainers.image.version="${CS_SANDBOX_VERSION}" \
      org.opencontainers.image.revision="${CS_SANDBOX_REVISION}" \
      org.opencontainers.image.vendor="CodeSweep" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.url="https://github.com/codesweep-ai/sandbox" \
      org.opencontainers.image.source="https://github.com/codesweep-ai/sandbox" \
      ai.codesweep.sandbox.os-version="44"

# Create the per-developer user + finish home setup on first boot, then drop to them.
ENTRYPOINT ["/sandbox/entrypoint"]

# Shell
CMD ["/bin/bash"]
