FROM registry.fedoraproject.org/fedora:44

# This image is GENERIC: it bakes in NO developer-specific user name / uid / gid and
# no per-user home. The toolchains live under /opt (shared, root-owned), and the
# container user (matching the host's name/uid/gid/home) is created at first boot by
# the entrypoint. So one image serves every developer and machine — no rebuild to
# match your local identity. See SPEC.md.

# Make dnf resilient to slow/flaky mirrors: drop any mirror that can't sustain ~100 KiB/s
# for 20s and fail over to the next, with parallel downloads + extra retries. First step so
# it governs every later dnf invocation.
RUN printf '%s\n' \
      'max_parallel_downloads=10' \
      'minrate=102400' \
      'timeout=20' \
      'retries=15' \
    >> /etc/dnf/dnf.conf

# Install Fedora packages
RUN dnf update -y && dnf install -y \
  vim findutils fd procps-ng tar zip unzip patch jq yq which lsof \
  iputils dnsutils iproute tcpdump wireshark-cli hostname netstat socat \
  sudo openssl openssh-clients openssh-server nmap telnet curl \
  git gcc gcc-c++ automake make cmake patch \
  zlib-devel bzip2 bzip2-devel \
  readline-devel sqlite sqlite-devel \
  openssl-devel tk-devel libffi-devel xz xz-devel \
  libuuid-devel gdbm-libs libnsl2 lzma lzma-sdk-devel \
  ncurses ncurses-devel ncurses-term tmux \
  g++ python-devel \
  graphviz graphviz-devel \
  podman skopeo buildah rsync shadow-utils \
  fuse-overlayfs crun slirp4netns passt containers-common \
  dnf-utils rclone bash-completion \
  ripgrep fzf bat git-delta tree htop less wget nmap-ncat gh uv \
  ninja-build gettext glibc-gconv-extra \
  pandoc && \
  dnf clean all

# Install Chromium
RUN dnf -y install \
    chromium \
    nss atk cups-libs pango alsa-lib \
    libXcomposite libXcursor libXdamage libXext libXi libXrandr libXScrnSaver libXtst \
    xorg-x11-fonts-Type1 xorg-x11-fonts-misc liberation-fonts \
    mesa-libEGL mesa-libGL && \
    dnf clean all

# CHROME_BIN is declared in rootfs/etc/cs-sandbox/env — an image ENV never reaches
# an SSH session or a microVM. See that file.

# NOTE: `COPY . /sandbox` is intentionally deferred to just before it's first needed
# (the Neovim plugin pre-build / entrypoint), AFTER the expensive toolchain compiles, so
# editing the entrypoint / dotfiles / vendored scripts doesn't invalidate those layers.

# Disable PAM for sudo.
#
# SAFETY ASSUMPTION: this unconditionally-succeeding sudo (passwordless NOPASSWD:ALL) is
# safe ONLY because the security boundary is the engine, not in-sandbox sudo — rootless
# `--userns=keep-id` (container "root" == your unprivileged host uid) or a microVM's own
# kernel. The agent already owns its disposable sandbox, so sudo grants nothing outside it.
# Running this image rootful, `--privileged`, or `--userns=host` would break that boundary
# and turn this into real host-root. See SPEC.md "Security model".
#
# The container user is created at first boot (see image/rootfs/entrypoint) with a LOCKED
# password (useradd -p '*') and is granted NOPASSWD:ALL via /etc/sudoers.d. There is no
# password to authenticate against, and the image is a minimal rootless container with no
# running systemd/logind — so stock PAM modules for sudo would either reject the locked
# account (pam_unix auth/account) or fail/hang trying to open a login session
# (pam_systemd registering with a logind that isn't there). Replacing every PAM stack with
# pam_permit.so makes the sudo PAM transaction unconditionally succeed, so passwordless
# sudo is reliable and non-interactive. That matters because the rootful nested-podman
# wrapper shells out to `sudo` on every podman call (see below); a PAM stall there would
# wedge nested podman. sshd is likewise run with UsePAM=no for the same reason.
RUN echo -e "auth       sufficient   pam_permit.so\n\
account    sufficient   pam_permit.so\n\
password   sufficient   pam_permit.so\n\
session    sufficient   pam_permit.so" > /etc/pam.d/sudo

# Register a private podman registry so nested podman can pull from a local/private registry.
# Build-args (cs-sandbox forwards the matching CS_SANDBOX_PRIVATE_REGISTRY[_INSECURE] env vars;
# see SPEC.md "Private registry"):
#   CS_SANDBOX_PRIVATE_REGISTRY=host:port    registry to trust, as a BARE host:port (podman's
#                                            registries.conf `location` form — no scheme); empty
#                                            -> register none.
#   CS_SANDBOX_PRIVATE_REGISTRY_INSECURE=1   insecure: `insecure = true` lets podman use plain-HTTP
#                                            and skip TLS verification; 0 (default) -> secure (HTTPS,
#                                            TLS-verified).
# Per docker/podman convention the protocol is IMPLICIT in this flag — a registry is named by its
# bare host:port, secure means HTTPS, insecure permits HTTP / untrusted certs; there is no
# http://-vs-https:// scheme. Secure is the default; insecure is opt-in (e.g. a plain-HTTP registry:
# --build-arg CS_SANDBOX_PRIVATE_REGISTRY=registry.internal:5000 --build-arg ..._INSECURE=1).
ARG CS_SANDBOX_PRIVATE_REGISTRY=
ARG CS_SANDBOX_PRIVATE_REGISTRY_INSECURE=0
RUN if [ -n "$CS_SANDBOX_PRIVATE_REGISTRY" ]; then \
      { printf '[[registry]]\nlocation = "%s"\n' "$CS_SANDBOX_PRIVATE_REGISTRY"; \
        case "$CS_SANDBOX_PRIVATE_REGISTRY_INSECURE" in \
          1|true|TRUE|yes|YES|on|ON) printf 'insecure = true\n' ;; \
        esac; \
      } >> /etc/containers/registries.conf; \
    fi

# Configure nested podman. The container runs with a scaled-down cap set by default
# (SYS_ADMIN/NET_ADMIN/MKNOD/SYS_PTRACE + /dev/net/tun + unmask=/proc/sys, seccomp on;
# --privileged is an opt-in fallback) — and it's rootless, so caps are bounded by the
# unprivileged host user, while nested podman runs ROOTFUL as container-root (which
# under keep-id is your unprivileged host user). Default to the
# kernel's NATIVE overlay driver (fast path): the per-instance cs-sandbox-containers volume
# mounted at /var/lib/containers gives the store a non-overlay backing fs, so on
# kernel >= 5.11 native overlay mounts directly — no fuse-overlayfs userspace layer
# and its perf cost. The entrypoint auto-falls-back to fuse-overlayfs (still
# installed) if a native overlay mount isn't possible here.
RUN mkdir -p /etc/containers && \
    printf '[storage]\ndriver = "overlay"\n' > /etc/containers/storage.conf && \
    printf '[containers]\ncgroups = "disabled"\n\n[engine]\ncgroup_manager = "cgroupfs"\nevents_logger = "file"\n' > /etc/containers/containers.conf

# (Nested podman runs rootful in a container and rootless in a microVM; the
# /usr/local/bin/podman wrapper installed below picks per engine.)

# Default internal sshd port (overridable at runtime via -e CS_SANDBOX_SSH_PORT)
ENV CS_SANDBOX_SSH_PORT=2222

# Configure sshd
RUN mkdir -p /var/run/sshd \
  && sed -i 's/^#PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config \
  && sed -i 's/^#PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config \
  && sed -i 's/^#PubkeyAuthentication.*/PubkeyAuthentication yes/' /etc/ssh/sshd_config \
  && sed -i 's/^#\?Port .*/Port 2222/' /etc/ssh/sshd_config \
  && ssh-keygen -A

# Neovim — the official prebuilt release tarball, not a source build. Upstream publishes a
# self-contained Linux tarball for both arches (it links only libc/libm/libgcc_s), so there is
# nothing to gain from compiling it here: this turns a multi-minute build of Neovim plus its
# bundled deps into an 11 MB download. It installs into /usr/local exactly where `make install`
# used to put it, so $VIMRUNTIME and PATH are unchanged.
#
# Bump NVIM_VERSION (or pass --build-arg) to upgrade, and update BOTH checksums — Neovim
# publishes no checksum file for these assets, so the digests are pinned here (GitHub release
# assets are immutable, so this is a genuine pin, verified on every build).
#
# 0.12 is a hard requirement of the config in image/rootfs/home/.config/nvim: nvim-treesitter's
# `main` branch (the only maintained one) refuses to run on anything older.
ARG NVIM_VERSION=0.12.4
ARG NVIM_SHA256_X86_64=012bf3fcac5ade43914df3f174668bf64d05e049a4f032a388c027b1ebd78628
ARG NVIM_SHA256_ARM64=ceb7e88c6b681f0515d135dcdfad54f5eb4373b25ce6172197cd9a69c758063f
RUN case "$(uname -m)" in \
      x86_64|amd64)  arch=x86_64; want="$NVIM_SHA256_X86_64" ;; \
      arm64|aarch64) arch=arm64;  want="$NVIM_SHA256_ARM64" ;; \
      *) echo "unsupported arch $(uname -m)" >&2; exit 1 ;; \
    esac \
  && curl -fsSL -o /tmp/nvim.tar.gz \
       "https://github.com/neovim/neovim/releases/download/v${NVIM_VERSION}/nvim-linux-${arch}.tar.gz" \
  && got=$(sha256sum /tmp/nvim.tar.gz | cut -d' ' -f1) \
  && { [ "$want" = "$got" ] || { echo "nvim checksum mismatch: want=$want got=$got" >&2; exit 1; }; } \
  && tar -xzf /tmp/nvim.tar.gz -C /usr/local --strip-components=1 --no-same-owner \
  && rm -f /tmp/nvim.tar.gz \
  && nvim --version | head -2

# tree-sitter CLI: a hard requirement of nvim-treesitter's `main` branch, which uses it to
# install/update parsers (`:TSInstall`, `:TSUpdate`, and the parser pre-build below).
# --setopt=install_weak_deps=False: its Recommends pull in a second, unwanted Node
# (gcc is already installed, and the shared /opt/nvm Node is on PATH for `tree-sitter generate`).
RUN dnf install -y --setopt=install_weak_deps=False tree-sitter-cli && dnf clean all \
  && tree-sitter --version

# --- Toolchains under /opt (shared, root-owned, path-independent) ---------------
# No developer user is created at build time (the entrypoint does that on first boot),
# so the heavy toolchains can't live in a per-user $HOME. They go under /opt instead,
# installed as root and shared by every runtime user. Read-only at runtime: to add
# more Python/Node versions or global npm/pip packages, use `sudo`. Per-project work
# (virtualenvs, node_modules) is unaffected — it lives in the user's repos.

# Pyenv + Python 3.12.13 (PYENV_ROOT=/opt/pyenv)
# 3.12 (not the newest 3.14) on purpose: it is the line the ecosystem actually runs — ~28% of
# PyPI downloads vs ~12% for 3.13 and ~5% for 3.14 — so wheels and C extensions are most
# likely to exist for it. `sudo pyenv install <ver>` adds another version alongside.
ENV PYENV_ROOT=/opt/pyenv
RUN curl -fsSL https://pyenv.run | PYENV_GIT_TAG=v2.8.1 bash \
  && PATH="$PYENV_ROOT/bin:$PATH" pyenv install -s 3.12.13 \
  && PATH="$PYENV_ROOT/bin:$PATH" pyenv global 3.12.13

# NVM + Node 24.18.1 (NVM_DIR=/opt/nvm): a general JS/TS runtime; npm -g lands in shared node.
# 24.x is the Active LTS line ("Krypton", LTS since 2025-10, maintenance from 2026-10).
# (The Claude Code & Codex agents are self-contained binaries under /opt, not npm packages.)
ENV NVM_DIR=/opt/nvm
RUN mkdir -p "$NVM_DIR" \
  && curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash \
  && bash -c '. "$NVM_DIR/nvm.sh" && nvm install v24.18.1 && nvm alias default v24.18.1'

# Go 1.26.5 (GOROOT=/opt/go) — the upstream tarball, pinned and checksum-verified, replacing
# Fedora's golang-bin. Go is a first-class runtime here, on the same footing as the pyenv and
# nvm toolchains above rather than whatever `dnf update` last pulled in:
#   * pinned + reproducible, and an unpatched upstream build (Fedora ships a patched
#     `go1.26.4-X:nodwarf5`);
#   * GOTOOLCHAIN stays at upstream's `auto` (Fedora forces `local`), so a repo whose go.mod
#     asks for a different `go 1.x` fetches that toolchain on demand into the user's module
#     cache — Go's own answer to nvm/pyenv version switching, and it works despite /opt being
#     read-only because the download lands in $GOPATH, not $GOROOT;
#   * ~/.bashrc sets GOPATH/GOBIN and puts $GOPATH/bin on PATH, so `go install x@latest`
#     produces a runnable command the way `npm -g` and `pip install` already do.
# go.dev publishes the digests in its release JSON (https://go.dev/dl/?mode=json); bump
# GO_VERSION and both checksums together to upgrade.
# Temurin JDK 25 (JAVA_HOME=/opt/java) + Maven (/opt/maven), replacing Fedora's
# java-latest-openjdk/maven. Pinned like every other runtime here, and it removes a mess:
# `java-latest-openjdk` installed a 256 MB JDK 26 that nothing used, because `maven` dragged
# in java-25-openjdk as its own dependency and /usr/bin/java resolved to THAT — so the image
# shipped two JDKs, ran the one it never asked for, and floated on both. One pinned JDK on
# PATH now, which is also what mason's `jdtls` language server runs on.
# 25 is the current LTS line and is the version the image was already running (25.0.4).
# Checksums are Adoptium's published digests (https://api.adoptium.net/v3/assets/…);
# bump JAVA_VERSION/JAVA_BUILD and both checksums together to upgrade.
ARG JAVA_VERSION=25.0.4
ARG JAVA_BUILD=7
ARG JAVA_SHA256_X64=e58fcdcd637b25c03ca84cbbcefc70d11efb8f4b4cbd05decc9f661769d77f94
ARG JAVA_SHA256_AARCH64=621f7196f0b682fb557da58bec89bd7dfe5419811fe1c0ba75c9cc8432f084c7
RUN case "$(uname -m)" in \
      x86_64|amd64)  jarch=x64;     want="$JAVA_SHA256_X64" ;; \
      arm64|aarch64) jarch=aarch64; want="$JAVA_SHA256_AARCH64" ;; \
      *) echo "unsupported arch $(uname -m)" >&2; exit 1 ;; \
    esac \
  && curl -fsSL -o /tmp/jdk.tar.gz \
       "https://github.com/adoptium/temurin25-binaries/releases/download/jdk-${JAVA_VERSION}%2B${JAVA_BUILD}/OpenJDK25U-jdk_${jarch}_linux_hotspot_${JAVA_VERSION}_${JAVA_BUILD}.tar.gz" \
  && got=$(sha256sum /tmp/jdk.tar.gz | cut -d' ' -f1) \
  && { [ "$want" = "$got" ] || { echo "jdk checksum mismatch: want=$want got=$got" >&2; exit 1; }; } \
  && mkdir -p /opt/java \
  && tar -xzf /tmp/jdk.tar.gz -C /opt/java --strip-components=1 --no-same-owner \
  && rm -f /tmp/jdk.tar.gz \
  && /opt/java/bin/java -version 2>&1 | head -1
# (java -version writes to stderr, which `podman build -q` does NOT suppress — the 2>&1
#  keeps this sanity check out of a quiet build's console.)

# Maven is a pure-Java tarball; Apache publishes a .sha512 next to it, verified here.
ARG MAVEN_VERSION=3.9.16
ARG MAVEN_SHA512=831a8591fe20c8243b1dbe7d71e3244f31d1665b0804b2e825e38cbbe5ce0cafb8338851f90780735568773e0a6cd07bbec107cda0b896b008b861075358b6f6
RUN curl -fsSL -o /tmp/maven.tar.gz \
       "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" \
  && got=$(sha512sum /tmp/maven.tar.gz | cut -d' ' -f1) \
  && { [ "$MAVEN_SHA512" = "$got" ] || { echo "maven checksum mismatch" >&2; exit 1; }; } \
  && mkdir -p /opt/maven \
  && tar -xzf /tmp/maven.tar.gz -C /opt/maven --strip-components=1 --no-same-owner \
  && rm -f /tmp/maven.tar.gz \
  && JAVA_HOME=/opt/java /opt/maven/bin/mvn --version | head -1

ARG GO_VERSION=1.26.5
ARG GO_SHA256_AMD64=5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053
ARG GO_SHA256_ARM64=fe4789e92b1f33358680864bbe8704289e7bb5fc207d80623c308935bd696d49
RUN case "$(uname -m)" in \
      x86_64|amd64)  garch=amd64; want="$GO_SHA256_AMD64" ;; \
      arm64|aarch64) garch=arm64; want="$GO_SHA256_ARM64" ;; \
      *) echo "unsupported arch $(uname -m)" >&2; exit 1 ;; \
    esac \
  && curl -fsSL -o /tmp/go.tar.gz "https://go.dev/dl/go${GO_VERSION}.linux-${garch}.tar.gz" \
  && got=$(sha256sum /tmp/go.tar.gz | cut -d' ' -f1) \
  && { [ "$want" = "$got" ] || { echo "go checksum mismatch: want=$want got=$got" >&2; exit 1; }; } \
  && tar -xzf /tmp/go.tar.gz -C /opt --no-same-owner \
  && rm -f /tmp/go.tar.gz \
  && /opt/go/bin/go version

# Claude Code — native single-binary install (no Node/npm runtime dependency). Anthropic's
# install.sh normally drops a self-updating launcher in ~/.local/bin; instead we fetch the same
# verified binary straight into root-owned /opt. /opt is read-only at runtime, so the version is
# pinned and reproducible (no background auto-update fighting the read-only tree). The binary IS
# the full CLI — the launcher is only convenience + auto-update, neither of which we want here.
# Bump CLAUDE_CODE_VERSION (or pass --build-arg) to upgrade; checksum is verified from the manifest.
# This pin is ahead of the `stable` channel (2.1.212) on purpose: Opus 5 needs >= 2.1.219, below
# which the `opus` alias resolves to Opus 4.8 and Opus 5 never appears. Held at the minimum that
# satisfies that — 2.1.220 showed issues in use.
ARG CLAUDE_CODE_VERSION=2.1.219
RUN base=https://downloads.claude.ai/claude-code-releases \
  && case "$(uname -m)" in x86_64|amd64) arch=x64 ;; arm64|aarch64) arch=arm64 ;; *) echo "unsupported arch $(uname -m)" >&2; exit 1 ;; esac \
  && plat="linux-${arch}" \
  && mkdir -p /opt/claude/bin \
  && curl -fsSL -o /opt/claude/bin/claude "$base/$CLAUDE_CODE_VERSION/$plat/claude" \
  && want=$(curl -fsSL "$base/$CLAUDE_CODE_VERSION/manifest.json" | jq -r ".platforms[\"$plat\"].checksum") \
  && got=$(sha256sum /opt/claude/bin/claude | cut -d' ' -f1) \
  && { [ "$want" = "$got" ] || { echo "claude checksum mismatch: want=$want got=$got" >&2; exit 1; }; } \
  && chmod +x /opt/claude/bin/claude \
  && /opt/claude/bin/claude --version

# Claude Code's install-health check expects a "native"/npm install at ~/.local/bin or in
# node_modules; ours is a pinned single binary in read-only /opt (externally managed), which
# matches none of those, so it nags ("claude command at ~/.local/bin/claude missing or broken
# · run claude install to repair") and `claude install` would shadow-install a second copy.
# Disable the install checks and the auto-updater (it can't write /opt anyway). This covers
# the container engine for any direct `claude`; the cs-claude wrapper exports the same
# for the microVM engine (whose guest init doesn't inherit image ENV) and for either engine.
# DISABLE_INSTALLATION_CHECKS / DISABLE_AUTOUPDATER are declared in
# rootfs/etc/cs-sandbox/env (an image ENV reaches neither SSH sessions nor a microVM).

# OpenAI Codex — the release package OpenAI's own installer uses
# (https://chatgpt.com/codex/install.sh): the static musl build plus the helpers codex ships for
# itself (its own ripgrep, bwrap, the code-mode host). It is also the only Linux asset with a
# published checksum — codex-package_SHA256SUMS covers the codex-package-* archives, not the
# bare-binary ones — so taking it is what lets this download be verified at all. Extracted whole
# into /opt for the same reason as Claude Code above: pinned, read-only-friendly, no Node.
# --no-same-owner because the archive carries a build-machine uid: preserving it would leave the
# agent binaries owned by whichever sandbox user happens to share that uid, and writable by them.
# Bump CODEX_VERSION (or pass --build-arg) to upgrade.
ARG CODEX_VERSION=0.145.0
RUN case "$(uname -m)" in x86_64|amd64) tgt=x86_64-unknown-linux-musl ;; arm64|aarch64) tgt=aarch64-unknown-linux-musl ;; *) echo "unsupported arch $(uname -m)" >&2; exit 1 ;; esac \
  && base="https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}" \
  && asset="codex-package-${tgt}.tar.gz" \
  && mkdir -p /opt/codex /tmp/codex-dl \
  && curl -fsSL -o "/tmp/codex-dl/$asset" "$base/$asset" \
  && want=$(curl -fsSL "$base/codex-package_SHA256SUMS" | awk -v a="$asset" '$2 == a { print $1 }') \
  && got=$(sha256sum "/tmp/codex-dl/$asset" | cut -d' ' -f1) \
  && { [ -n "$want" ] && [ "$want" = "$got" ] || { echo "codex checksum mismatch: want=$want got=$got" >&2; exit 1; }; } \
  && tar -xzf "/tmp/codex-dl/$asset" -C /opt/codex --no-same-owner \
  && chmod 0755 /opt/codex/bin/codex /opt/codex/bin/codex-code-mode-host /opt/codex/codex-path/rg \
  && { [ ! -f /opt/codex/codex-resources/bwrap ] || chmod 0755 /opt/codex/codex-resources/bwrap; } \
  && rm -rf /tmp/codex-dl \
  && /opt/codex/bin/codex --version

# OpenCode (anomalyco/opencode) — a single bun-compiled binary, installed into read-only /opt on
# the same pinned model as Claude Code and Codex above. Upstream publishes NO SHA256SUMS for the
# CLI tarballs (its minisign signatures cover only the desktop-app assets), so the digests below
# were recorded from the release assets themselves; bumping OPENCODE_VERSION means re-recording
# both. Its one external runtime dependency (ripgrep) is already installed from Fedora above.
ARG OPENCODE_VERSION=1.18.10
ARG OPENCODE_SHA256_X64=6b1113da704253fb4da12b41e4236acecb9f2b62949c945f6eeacaa15111b976
ARG OPENCODE_SHA256_ARM64=41ae3041e91b894e4c0dc06a73a9a2796254bf390ffb99626a43af5e2912d170
RUN case "$(uname -m)" in \
       x86_64|amd64)  arch=x64;   want=$OPENCODE_SHA256_X64 ;; \
       arm64|aarch64) arch=arm64; want=$OPENCODE_SHA256_ARM64 ;; \
       *) echo "unsupported arch $(uname -m)" >&2; exit 1 ;; esac \
  && asset="opencode-linux-${arch}.tar.gz" \
  && mkdir -p /opt/opencode/bin /tmp/opencode-dl \
  && curl -fsSL -o "/tmp/opencode-dl/$asset" "https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_VERSION}/$asset" \
  && got=$(sha256sum "/tmp/opencode-dl/$asset" | cut -d' ' -f1) \
  && { [ "$want" = "$got" ] || { echo "opencode checksum mismatch: want=$want got=$got" >&2; exit 1; }; } \
  && tar -xzf "/tmp/opencode-dl/$asset" -C /opt/opencode/bin --no-same-owner \
  && chmod 0755 /opt/opencode/bin/opencode \
  && rm -rf /tmp/opencode-dl \
  && /opt/opencode/bin/opencode --version

# Python CLI tools in an isolated, root-owned venv
# --disable-pip-version-check: pip's "a new release of pip is available" notice goes to
# stderr, which `podman build -q` does not suppress, so it would show up in a quiet build.
RUN python3 -m venv /opt/py-tools \
  && /opt/py-tools/bin/pip install --no-cache-dir --disable-pip-version-check claude-code-transcripts

# Everything under /opt readable/traversable by every runtime user
RUN chmod -R a+rX /opt

# Toolchains on PATH for ALL shells (incl. non-interactive `ssh cs-sandbox-x <cmd>`), so node,
# the agents (claude, codex, opencode), and the py-tools are found without sourcing ~/.bashrc.
# (~/.bashrc additionally runs pyenv/nvm init for interactive version switching.)
ENV JAVA_HOME=/opt/java
ENV PATH=/opt/nvm/versions/node/v24.18.1/bin:/opt/py-tools/bin:/opt/claude/bin:/opt/codex/bin:/opt/opencode/bin:/opt/pyenv/bin:/opt/go/bin:/opt/java/bin:/opt/maven/bin:${PATH}

# Make `podman` do the right thing for the engine underneath it. A thin wrapper ahead
# of /usr/bin in PATH, so plain `podman` (shells, scripts, tools, and
# `ssh cs-sandbox-x podman …`) lands on the right one:
#
#   podman container — ROOTFUL, via the NOPASSWD sudo the user already has. The nested
#     engine must be rootful: rootless-inner fails under --userns=keep-id (no cleanly
#     sub-dividable subuid range). No setuid (podman keys rootless/rootful off the real
#     uid, so a setuid bit just yields a broken half-state); this grants nothing beyond
#     the existing sudo.
#   firecracker microVM — ROOTLESS, i.e. podman as it runs anywhere else. A VM is real
#     root on a real kernel, so none of the keep-id apparatus applies. The guest init
#     grants newuidmap/newgidmap the file caps rootless needs (see image/guest/init).
#
# /run/.containerenv is podman's own marker for "inside a container": it exists in the
# container engine and not in the microVM, where PID 1 also mounts a fresh tmpfs over
# /run. The real binary stays at /usr/bin/podman for anyone who wants one explicitly.
RUN printf '%s\n' \
      '#!/bin/sh' \
      '# Engine-aware podman (see image/Containerfile). Rootful in a container, rootless in a VM.' \
      '[ -f /run/.containerenv ] && exec sudo /usr/bin/podman "$@"' \
      'exec /usr/bin/podman "$@"' > /usr/local/bin/podman && \
    chmod 0755 /usr/local/bin/podman

# Repo context (entrypoint, home skeleton, vendored scripts). Deferred to here — after
# the toolchain compiles — so edits to these files don't bust the expensive cache above.
COPY . /sandbox

# The guest environment declaration, at a path both entry paths read. Installed
# rather than referenced under /sandbox so it looks like the config it is.
RUN install -Dm0644 /sandbox/etc/cs-sandbox/env /etc/cs-sandbox/env

# Pre-build the ENTIRE Neovim setup, so the first `nvim` in a sandbox is instant and needs
# no network. Three kinds of artifact, and they can't all live in the same place:
#
#   1. plugins  -> the home SEED (/sandbox/home/.local/share/nvim/lazy). The entrypoint copies
#                  the seed into the user's home on first boot. `install` + `restore` (NOT
#                  `sync`) so the checked-in lazy-lock.json decides the revisions and the build
#                  is reproducible — `sync` updates to whatever is HEAD today and rewrites the
#                  lockfile inside the image, where nobody ever sees it.
#   2. treesitter parsers -> also the seed (~18 MB of .so + queries, position-independent).
#                  `:TSInstallSync` is defined by lua/plugins/treesitter.lua; nvim-treesitter's
#                  own install is async, so a plain headless call would exit before it finished.
#   3. LSP servers / formatters -> /opt/nvim/mason, NOT the home. Mason bakes the absolute
#                  install path into its bin/ wrappers (and into the venv it builds for
#                  basedpyright), so ~1 GB of servers pre-installed under /sandbox/home would
#                  still point at /sandbox/home after being copied to a developer's home. They
#                  go under /opt with the other shared toolchains instead: one root-owned,
#                  path-stable copy, never duplicated into an instance's home. lua/plugins/
#                  mason.lua picks that root up automatically (override with $MASON_ROOT).
#
# The `!` on the two sync commands makes them exit non-zero when something did not install,
# so a partial pre-build fails the image build here instead of shipping a sandbox that
# quietly downloads half its editor the first time you open a file.
#
# The rm near the end drops build-time caches — mason's installers leave npm/pip/Go caches
# behind (gopls alone leaves ~550 MB in ~/.cache/go-build and ~/go), plus the path-keyed Lua
# bytecode cache and logs — which would otherwise be copied into every sandbox home. That
# leak is invisible (the build still succeeds), so the final `du` check fails the build if
# the seed grows past ~100 MB: ~80 MB is plugins + treesitter parsers, and anything beyond
# means a newly added package left a cache that needs adding to the rm list.
#
# `step` keeps the console quiet. `podman build -q` (what `cs-sandbox build` uses unless
# you pass --verbose) only suppresses a RUN's stdout — its stderr goes straight to the
# terminal, and `nvim --headless` writes everything there, so these four commands used to
# spray ~120 lines of lazy/mason/treesitter progress over every build. This layer sits
# after `COPY . /sandbox`, so ANY edit in the repo re-runs it. Output is captured instead
# and replayed only if a step fails; BUILD_VERBOSE=1 (set by `cs-sandbox build --verbose`)
# passes it through live.
ARG BUILD_VERBOSE=0
RUN set -e; \
    export HOME=/sandbox/home \
           XDG_CONFIG_HOME=/sandbox/home/.config \
           XDG_DATA_HOME=/sandbox/home/.local/share \
           XDG_STATE_HOME=/sandbox/home/.local/state \
           XDG_CACHE_HOME=/sandbox/home/.cache; \
    mkdir -p /opt/nvim/mason; \
    log=/tmp/nvim-setup.log; \
    step() { \
      if [ "${BUILD_VERBOSE:-0}" = 1 ]; then "$@"; \
      else "$@" >>"$log" 2>&1 \
        || { echo "cs-sandbox: neovim pre-install failed: $*" >&2; cat "$log" >&2; exit 1; }; \
      fi; \
    }; \
    step nvim --headless '+Lazy! install' +qa; \
    step nvim --headless '+Lazy! restore' +qa; \
    step nvim --headless '+TSInstallSync!' +qa; \
    step nvim --headless '+MasonInstallSync!' +qa; \
    rm -f "$log"; \
    chmod -R a+rX /opt/nvim; \
    rm -rf "$HOME/.npm" "$HOME/.cache/pip" "$HOME/.cache/go-build" "$HOME/go" \
           "$HOME/.cache/tree-sitter" \
           "$XDG_CACHE_HOME/nvim/luac" "$XDG_STATE_HOME/nvim" \
           "$XDG_DATA_HOME/nvim/mason"; \
    seed_mb=$(du -sm "$HOME" | cut -f1); \
    echo "home seed: ${seed_mb} MB"; \
    [ "$seed_mb" -lt 100 ] || { echo "home seed too large (${seed_mb} MB) — a build cache leaked into /sandbox/home" >&2; du -sm "$HOME"/* "$HOME"/.[a-z]* 2>/dev/null | sort -n | tail -10 >&2; exit 1; }

# Image metadata. Placed here — after the heavy toolchain/COPY layers — so editing a
# label only rebuilds this cheap layer, not the build above. The :44 tag is a rolling
# pointer to the latest build; these labels make the running image self-describing
# (which Fedora base, what this image is) without baking a version into the tag.
# The version/vendor/licenses/url here OVERRIDE values inherited from the Fedora base
# (which would otherwise read 44 / "Fedora Project" / MIT / fedoraproject.org and
# misdescribe this image). version mirrors the rolling :44 tag — there is no separate
# image version scheme.
LABEL org.opencontainers.image.title="cs-sandbox" \
      org.opencontainers.image.description="Generic sandbox image (Fedora 44 base, shared /opt toolchains; per-developer user created at first boot)." \
      org.opencontainers.image.base.name="registry.fedoraproject.org/fedora:44" \
      org.opencontainers.image.version="44" \
      org.opencontainers.image.vendor="CodeSweep" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.url="https://github.com/codesweep-ai/sandbox" \
      org.opencontainers.image.source="https://github.com/codesweep-ai/sandbox" \
      ai.codesweep.sandbox.os-version="44"

# Create the per-developer user + finish home setup on first boot, then drop to them.
ENTRYPOINT ["/sandbox/entrypoint"]

# Shell
CMD ["/bin/bash"]
